# Alice Brain node configuration. Copy to .env and chmod 600.
# Do not commit real tokens, API keys, SSH details, private keys, or wallet secrets.

# Public node identity.
ALICE_NODE_ID=alice-local-01
# Public example faucet/source address from PB. Do not use this as your payout address.
EXAMPLE_MAZA_ADDRESS=MCU8e7DdJ8D2on5fBQfb4jTn2qX4DGiikw
# Your own public MAZA payout address. Never paste a private key or seed phrase.
MAZA_ADDRESS=

# DOPE/SUN report worker tunnel.
DOPE_REPORT_WORKER_BASE_URL=http://127.0.0.1:8182
DOPE_REPORT_WORKER_ID=alice-local-reports-01
# Issued by the Oven Registry setup bundle.
DOPE_REPORT_WORKER_TOKEN=

# PB/AUTOS worker tunnel.
AUTOS_WORKER_BASE_URL=http://127.0.0.1:3333
AUTOS_WORKER_ID=alice-local-autos-01
# Issued by the Oven Registry setup bundle.
AUTOS_WORKER_TOKEN=

# Baseline local models.
AUTOS_LOCAL_MODEL=qwen3:8b
DOPE_REPORT_LOCAL_MODEL=qwen3:8b
DOPE_REPORT_EMBEDDER_MODEL=qwen3-embedding:4b
DOPE_REPORT_PAGE_VISUAL_QA_MODEL=qwen3-vl:8b
DOPE_REPORT_OCR_MODEL=glm-ocr:bf16

# RoRe / Rotary Relay over a private SSH tunnel.
AGENT_BRIDGE_REDIS_URL=redis://127.0.0.1:6389/15
AGENT_BRIDGE_AUTO_RECEIPT_ACK=1

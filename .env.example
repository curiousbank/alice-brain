# Alice Brain node configuration. Copy to .env and chmod 600.
# Do not commit real tokens, API keys, SSH details, private keys, or wallet secrets.

# Public node identity. Use the id from the PB /ai setup bundle.
# Example: if the oven name is askalice.autos, these values should be askalice.autos.
ALICE_NODE_ID=my-oven-name
AI_OVEN_NODE_ID=my-oven-name
# Public example faucet/source address from PB. Do not use this as your payout address.
EXAMPLE_MAZA_ADDRESS=MNHxyG4ZRD5acR9HAjfWnSFBHMKmCvTGLD
# Your own public MAZA payout address. Never paste a private key or seed phrase.
MAZA_ADDRESS=
AI_OVEN_MAZA_ADDRESS=

# One-time random token from https://313.cash/ai.
# PB stores only a digest. Do not commit this value.
AI_OVEN_NODE_TOKEN=
PINBALL_OVEN_TOKEN=

# PB/AUTOS worker lane. Public token-protected outbound polling; no inbound port.
AUTOS_WORKER_BASE_URL=https://313.cash
AUTOS_BRAIN_BASE_URL=https://313.cash
AUTOS_WORKER_ID=my-oven-name
# all = any AUTOS job, web = non-Telegram jobs, telegram = Telegram-only jobs.
AUTOS_WORKER_QUEUE=all
# Issued by the Oven Registry setup bundle.
AUTOS_WORKER_TOKEN=

# Baseline local models.
AUTOS_LOCAL_MODEL=qwen3:8b
AUTOS_EMBEDDER_MODEL=qwen3-embedding:4b
AUTOS_VISION_MODEL=qwen3-vl:8b

# Optional DOPE Copy Maker cloud finish pass.
# Keep this private. The repo and worker payloads must never contain the real value.
NVIDIA_API_KEY=
DOPE_COPY_MAKER_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DOPE_COPY_MAKER_NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional RoRe / Rotary Relay over a private SSH tunnel for approved operators.
# AGENT_BRIDGE_REDIS_URL=redis://127.0.0.1:6389/15
AGENT_BRIDGE_AUTO_RECEIPT_ACK=1

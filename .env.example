# Alice Brain node configuration. Copy to .env and chmod 600.
# Do not commit real tokens, API keys, private keys, or wallet secrets.

ALICE_NODE_ID=my-oven-name
AI_OVEN_NODE_ID=my-oven-name

# Public payout addresses are safe to share; private keys and seed phrases are not.
MAZA_ADDRESS=
AI_OVEN_MAZA_ADDRESS=

# One-time scoped credentials issued by https://313.cash/ai.
AI_OVEN_NODE_TOKEN=
PINBALL_OVEN_TOKEN=
AUTOS_WORKER_TOKEN=

AUTOS_WORKER_BASE_URL=https://313.cash
AUTOS_WORKER_ID=my-oven-name
# all, web, telegram, embeddings, or sms_bot
AUTOS_WORKER_QUEUE=all
AUTOS_WORKER_POLL_SECONDS=5

AUTOS_LOCAL_MODEL=qwen3:8b
AUTOS_EMBEDDER_MODEL=qwen3-embedding:4b
AUTOS_VISION_MODEL=qwen3-vl:8b
OLLAMA_URL=http://127.0.0.1:11434

# Local development only. Remote HTTP controllers remain prohibited.
ALICE_ALLOW_INSECURE_HTTP=0
# Enabling this can disclose job content to the configured Ollama host.
ALICE_ALLOW_REMOTE_OLLAMA=0

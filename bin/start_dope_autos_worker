#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR"

set -a
for env_file in \
  "$ROOT_DIR/.env" \
  "$HOME/.config/autos/alice.env" \
  "$HOME/.config/autos/dope.env" \
  "$HOME/.config/pinball/dope-worker.env"; do
  if [[ -f "$env_file" ]]; then
    source "$env_file"
  fi
done
set +a

if [[ -z "${AUTOS_WORKER_TOKEN:-}" && -d "$HOME/Desktop/DOPE" ]]; then
  AUTOS_WORKER_TOKEN="$(
    cd "$HOME/Desktop/DOPE"
    RAILS_ENV="${RAILS_ENV:-production}" /home/wb/.local/bin/mise exec ruby@3.4.9 -- \
      bundle exec rails runner 'print DopeSettings.autos_worker_token'
  )"
  export AUTOS_WORKER_TOKEN
fi

if [[ -z "${AUTOS_WORKER_TOKEN:-}" ]]; then
  echo "AUTOS_WORKER_TOKEN is required for the DOPE AUTOS worker" >&2
  exit 1
fi

worker_queue="${DOPE_AUTOS_WORKER_QUEUE:-web}"
case "$worker_queue" in
  embeddings)
    default_worker_id="sun-dope-embeddings-01"
    embedding_enabled="1"
    ;;
  web)
    default_worker_id="sun-dope-web-01"
    embedding_enabled="0"
    ;;
  *)
    echo "Unsupported DOPE_AUTOS_WORKER_QUEUE: $worker_queue" >&2
    exit 1
    ;;
esac

export AUTOS_WORKER_ID="${DOPE_AUTOS_WORKER_ID:-$default_worker_id}"
export AUTOS_WORKER_BASE_URL="${DOPE_AUTOS_WORKER_BASE_URL:-http://127.0.0.1:8182}"
export AUTOS_BRAIN_BASE_URL="${DOPE_AUTOS_BRAIN_BASE_URL:-$AUTOS_WORKER_BASE_URL}"
export AUTOS_WORKER_QUEUE="$worker_queue"
export AUTOS_WORKER_POLL_SECONDS="${DOPE_AUTOS_WORKER_POLL_SECONDS:-2}"
export AUTOS_LOCAL_MODEL="${DOPE_AUTOS_LOCAL_MODEL:-qwen3:8b}"
export AUTOS_LOCAL_FRONTIER_MODEL="${DOPE_AUTOS_LOCAL_FRONTIER_MODEL:-qwen3:30b}"
export AUTOS_CC_EMBED_MODEL="${DOPE_AUTOS_EMBED_MODEL:-qwen3-embedding:8b-q4_K_M}"
export AUTOS_CC_EMBEDDING_WORKER_ENABLED="${DOPE_AUTOS_EMBEDDING_WORKER_ENABLED:-$embedding_enabled}"
export AUTOS_CC_PB_BRAIN_EMBEDDING_ENABLED="0"
export AUTOS_CC_ROOT="${AUTOS_CC_ROOT:-$ROOT_DIR}"
export AUTOS_CC_CONTEXT_DIR="${AUTOS_CC_CONTEXT_DIR:-$ROOT_DIR/context}"
export AUTOS_CC_INDEX_PATH="${AUTOS_CC_INDEX_PATH:-$HOME/.config/autos/log/dope_alice_context_index.json}"
export AUTOS_WORKER_ACTIVITY_LOG="${AUTOS_WORKER_ACTIVITY_LOG:-$HOME/.config/autos/log/dope_${worker_queue}_activity.jsonl}"

exec "$ROOT_DIR/bin/autos_cc_worker"

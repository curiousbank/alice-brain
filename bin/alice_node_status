#!/usr/bin/env python3
"""Emit safe JSON status for an Alice Brain worker node."""

from __future__ import annotations

import datetime as dt
import json
import os
import re
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_REQUIRED_MODELS = ["qwen3:8b"]
KNOWN_OPTIONAL_MODELS = [
    "qwen3-embedding:0.6b",
    "qwen3-embedding:4b",
    "qwen3-vl:8b",
    "glm-ocr:bf16",
]
PROCESS_ENV_KEYS = frozenset(os.environ)


def load_env(path: Path) -> None:
    if not path.exists():
        return
    for raw_line in path.read_text(errors="ignore").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        # Match shell sourcing: later protected env files override earlier
        # files, while explicit process/unit variables always win.
        if key and key not in PROCESS_ENV_KEYS:
            os.environ[key] = value


def run(command: list[str], timeout: int = 20) -> tuple[int, str, str]:
    try:
        result = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout, check=False)
        return result.returncode, result.stdout, result.stderr
    except Exception as error:
        return 127, "", f"{type(error).__name__}: {error}"


def now_iso() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def env_value(*names: str) -> str:
    for name in names:
        value = os.environ.get(name, "").strip()
        if value:
            return value
    return ""


def required_models() -> list[str]:
    configured = env_value("ALICE_REQUIRED_MODELS")
    if configured:
        models = [part.strip() for part in configured.split(",") if part.strip()]
        if models:
            return list(dict.fromkeys(models))

    candidates = [
        env_value("AUTOS_WEATHER_QWEN_MODEL"),
        env_value("DOPE_AUTOS_LOCAL_MODEL"),
        env_value("AUTOS_LOCAL_MODEL", "PB_AUTOS_LOCAL_MODEL"),
    ]
    models = [model for model in candidates if model]
    return list(dict.fromkeys(models)) or DEFAULT_REQUIRED_MODELS.copy()


def model_map() -> dict:
    code, stdout, stderr = run(["ollama", "list"], timeout=30)
    models = {}
    required = required_models()
    if code != 0:
        return {
            "ok": False,
            "error": (stderr or stdout).strip()[:300],
            "models": models,
            "required": {model: False for model in required},
        }
    for line in stdout.splitlines()[1:]:
        parts = re.split(r"\s+", line.strip())
        if parts:
            models[parts[0]] = True
    return {
        "ok": True,
        "models": models,
        "required": {model: bool(models.get(model)) for model in required},
        # Keep the old key for callers while narrowing its meaning to the
        # models this node is actually configured to require.
        "baseline": {model: bool(models.get(model)) for model in required},
        "optional": {
            model: bool(models.get(model))
            for model in KNOWN_OPTIONAL_MODELS
            if model not in required
        },
    }


def bridge_status() -> dict:
    bridge = ROOT / "bin" / "agent_bridge"
    if not bridge.exists():
        return {"ok": False, "error": "agent_bridge missing"}
    code, stdout, stderr = run([str(bridge), "status", "--role", "alice"], timeout=20)
    payload_text = stdout.strip()
    try:
        payload = json.loads(payload_text)
    except json.JSONDecodeError:
        payload = {"raw": payload_text[:1000], "error": stderr.strip()[:300]}
    payload["command_exit"] = code
    return payload


def autos_worker_status() -> dict:
    token = os.environ.get("AUTOS_WORKER_TOKEN") or os.environ.get("PINBALL_OVEN_TOKEN") or os.environ.get("AI_OVEN_NODE_TOKEN")
    base_url = env_value("AUTOS_WORKER_BASE_URL", "PB_AUTOS_WORKER_BASE_URL") or "https://313.cash"
    base_url = base_url.rstrip("/")
    worker_id = env_value(
        "AUTOS_WORKER_ID",
        "PB_AUTOS_WORKER_ID",
        "ALICE_NODE_ID",
        "AI_OVEN_NODE_ID",
    ) or "alice-local-01"
    if not token:
        return {"ok": False, "configured": False, "error": "AUTOS worker token missing"}

    import urllib.error
    import urllib.request

    request = urllib.request.Request(
        f"{base_url}/autos_worker/status",
        headers={
            "Authorization": f"Bearer {token}",
            "X-Autos-Worker-Id": worker_id,
            "X-Autos-Worker-Protocol": os.environ.get("AUTOS_WORKER_PROTOCOL_VERSION", "2"),
            "X-Rore-Protocol": env_value("AUTOS_RORE_PROTOCOL", "PB_AUTOS_RORE_PROTOCOL") or "rore.worker.v1",
            "X-Rore-Oven-Id": worker_id,
            "X-Rore-Capabilities": "autos.worker.v2,status",
            "X-Forwarded-Proto": "https",
            "Accept": "application/json",
        },
        method="GET",
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            payload = json.loads(response.read().decode("utf-8"))
            payload["ok"] = True
            payload["base_url"] = base_url
            payload["worker_id"] = worker_id
            return payload
    except urllib.error.HTTPError as error:
        return {"ok": False, "configured": True, "http_status": error.code, "error": error.read().decode("utf-8", errors="ignore")[:300]}
    except Exception as error:
        return {"ok": False, "configured": True, "error": f"{type(error).__name__}: {error}"}


def main() -> int:
    for path in [
        ROOT / ".env",
        Path.home() / ".config" / "alice-brain" / "node.env",
        Path.home() / ".config" / "autos" / "alice.env",
        Path.home() / ".config" / "pinball" / "pb-autos.env",
        Path.home() / ".config" / "pinball" / "pb-autos-worker.env",
        Path.home() / ".config" / "pinball" / "alice-local-01.oven.env",
        Path.home() / "Desktop" / "PB" / ".env.alice",
    ]:
        load_env(path)

    maza_address = os.environ.get("MAZA_ADDRESS", "").strip()
    node_id = env_value(
        "ALICE_NODE_ID",
        "AI_OVEN_NODE_ID",
        "AUTOS_WORKER_ID",
        "PB_AUTOS_WORKER_ID",
    ) or "alice-local-01"
    worker_status = autos_worker_status()
    controller_rore = worker_status.get("rore") if isinstance(worker_status, dict) else None
    status = {
        "ok": True,
        "generated_at": now_iso(),
        "node_id": node_id,
        "maza_address_configured": bool(maza_address),
        "maza_address_hint": f"{maza_address[:8]}...{maza_address[-6:]}" if len(maza_address) > 16 else ("configured" if maza_address else "missing"),
        "tokens": {
            "oven_node_token": bool(os.environ.get("AI_OVEN_NODE_TOKEN") or os.environ.get("PINBALL_OVEN_TOKEN")),
            "autos_worker_token": bool(os.environ.get("AUTOS_WORKER_TOKEN")),
        },
        "urls": {
            "autos_worker_base_url": env_value("AUTOS_WORKER_BASE_URL", "PB_AUTOS_WORKER_BASE_URL") or None,
            "direct_redis_required": False,
        },
        "ollama": model_map(),
        "rore": controller_rore or {
            "protocol": "rore.worker.v1",
            "connected": False,
            "mode": "controller_unavailable",
        },
        "legacy_direct_redis_bridge": (
            bridge_status()
            if os.environ.get("AGENT_BRIDGE_REDIS_URL")
            else {"enabled": False, "reason": "RORE uses the authenticated SUN gateway"}
        ),
        "autos_worker": worker_status,
    }
    status["ok"] = (
        all(status["ollama"].get("required", {}).values())
        and status["autos_worker"].get("ok") is True
    )
    print(json.dumps(status, indent=2, ensure_ascii=True))
    return 0 if status["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())

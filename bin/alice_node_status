#!/usr/bin/env python3
"""Emit safe JSON status for an Alice Brain worker node."""

from __future__ import annotations

import datetime as dt
import ipaddress
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
BASELINE_MODELS = ["qwen3-embedding:4b", "qwen3:8b", "qwen3-vl:8b"]
OPTIONAL_MODELS = ["glm-ocr:bf16"]
ENV_KEY = re.compile(r"^[A-Z][A-Z0-9_]*$")
IDENTIFIER = re.compile(r"^[a-zA-Z0-9_.-]+$")
CONTROLLER_QUEUES = {"all", "web", "telegram", "embeddings", "sms_bot"}
RORE_CAPABILITIES = "autos.worker.v2,qwen.local,progress,receipts"


def load_env(path: Path) -> None:
    if not path.exists():
        return
    for raw_line in path.read_text(errors="ignore").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
            value = value[1:-1]
        if ENV_KEY.match(key) and key not in os.environ:
            os.environ[key] = value


def run(command: list[str], timeout: int = 20) -> tuple[int, str, str]:
    try:
        result = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
        return result.returncode, result.stdout, result.stderr
    except Exception as error:  # Status output must survive missing local tools.
        return 127, "", f"{type(error).__name__}: {error}"


def now_iso() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def model_map() -> dict:
    code, stdout, stderr = run(["ollama", "list"], timeout=30)
    models = {}
    if code != 0:
        return {"ok": False, "error": (stderr or stdout).strip()[:300], "models": models}
    for line in stdout.splitlines()[1:]:
        parts = re.split(r"\s+", line.strip())
        if parts:
            models[parts[0]] = True
    return {
        "ok": True,
        "models": models,
        "baseline": {model: bool(models.get(model)) for model in BASELINE_MODELS},
        "optional": {model: bool(models.get(model)) for model in OPTIONAL_MODELS},
    }


def truthy(value: str | None) -> bool:
    return (value or "").lower() in {"1", "true", "yes", "on"}


def loopback_host(hostname: str | None) -> bool:
    if not hostname:
        return False
    if hostname.lower() == "localhost":
        return True
    try:
        return ipaddress.ip_address(hostname).is_loopback
    except ValueError:
        return False


def validated_base_url(value: str) -> str:
    parsed = urllib.parse.urlsplit(value)
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        raise ValueError("worker URL must use HTTP or HTTPS")
    if parsed.username or parsed.password:
        raise ValueError("worker URL cannot contain credentials")
    if parsed.path not in {"", "/"} or parsed.query or parsed.fragment:
        raise ValueError("worker URL cannot contain a path, query, or fragment")
    if parsed.scheme != "https" and not (
        truthy(os.environ.get("ALICE_ALLOW_INSECURE_HTTP"))
        and loopback_host(parsed.hostname)
    ):
        raise ValueError("worker URL must use HTTPS; HTTP is limited to explicit loopback development")
    return value.rstrip("/")


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: N802
        return None


def autos_worker_status() -> dict:
    token = (
        os.environ.get("AUTOS_WORKER_TOKEN")
        or os.environ.get("PINBALL_OVEN_TOKEN")
        or os.environ.get("AI_OVEN_NODE_TOKEN")
    )
    worker_id = (
        os.environ.get("AUTOS_WORKER_ID")
        or os.environ.get("ALICE_NODE_ID")
        or "alice-local-01"
    )
    worker_queue = (os.environ.get("AUTOS_WORKER_QUEUE") or "all").strip().lower()
    if not token:
        return {"ok": False, "configured": False, "error": "AUTOS worker token missing"}
    if (
        not 1 <= len(worker_id.encode("utf-8")) <= 128
        or not IDENTIFIER.fullmatch(worker_id)
    ):
        return {"ok": False, "configured": True, "error": "invalid AUTOS worker id"}
    if worker_queue not in CONTROLLER_QUEUES:
        return {"ok": False, "configured": True, "error": "unsupported AUTOS worker queue"}

    try:
        base_url = validated_base_url(
            os.environ.get("AUTOS_WORKER_BASE_URL") or "https://313.cash"
        )
    except ValueError as error:
        return {"ok": False, "configured": True, "error": str(error)}

    request = urllib.request.Request(
        f"{base_url}/autos_worker/status",
        headers={
            "Authorization": f"Bearer {token}",
            "X-Autos-Worker-Id": worker_id,
            "X-Autos-Node-Id": os.environ.get("ALICE_NODE_ID") or worker_id,
            "X-Autos-Worker-Queue": worker_queue,
            "X-Autos-Worker-Protocol": "2",
            "X-Autos-Local-Model": os.environ.get("AUTOS_LOCAL_MODEL") or "qwen3:8b",
            "X-Autos-Embedder-Model": (
                os.environ.get("AUTOS_EMBEDDER_MODEL") or "qwen3-embedding:4b"
            ),
            "X-Rore-Protocol": "rore.worker.v1",
            "X-Rore-Capabilities": RORE_CAPABILITIES,
            "Accept": "application/json",
        },
        method="GET",
    )
    opener = urllib.request.build_opener(NoRedirect)
    try:
        with opener.open(request, timeout=20) as response:
            raw_body = response.read(2 * 1024 * 1024 + 1)
            if len(raw_body) > 2 * 1024 * 1024:
                raise ValueError("worker status response is too large")
            payload = json.loads(raw_body.decode("utf-8"))
            if not isinstance(payload, dict):
                raise ValueError("worker status response must be an object")
            payload.update(
                {
                    "ok": True,
                    "base_url": base_url,
                    "worker_id": worker_id,
                    "worker_queue": worker_queue,
                }
            )
            return payload
    except urllib.error.HTTPError as error:
        return {
            "ok": False,
            "configured": True,
            "http_status": error.code,
            "error": f"worker status HTTP {error.code}",
        }
    except Exception as error:
        return {"ok": False, "configured": True, "error": f"{type(error).__name__}: {error}"}


def main() -> int:
    for path in [
        ROOT / ".env",
        Path.home() / ".config" / "alice-brain" / "node.env",
    ]:
        load_env(path)

    maza_address = os.environ.get("MAZA_ADDRESS", "").strip()
    node_id = (
        os.environ.get("ALICE_NODE_ID")
        or os.environ.get("AI_OVEN_NODE_ID")
        or os.environ.get("AUTOS_WORKER_ID")
        or "alice-local-01"
    )
    worker_status = autos_worker_status()
    rotary_payload = worker_status.get("rore")
    if not isinstance(rotary_payload, dict):
        rotary_payload = {}
    rotary_relay = {
        "controller_gateway": bool(rotary_payload),
        "connected": rotary_payload.get("connected") is True,
        "enabled": rotary_payload.get("enabled") is True,
        "mode": rotary_payload.get("mode") or "unavailable",
        "protocol": rotary_payload.get("protocol"),
        "postgres_authoritative": rotary_payload.get("postgres_authoritative") is True,
        "direct_redis_required": False,
    }
    status = {
        "ok": True,
        "generated_at": now_iso(),
        "node_id": node_id,
        "maza_address_configured": bool(maza_address),
        "maza_address_hint": (
            f"{maza_address[:8]}...{maza_address[-6:]}"
            if len(maza_address) > 16
            else ("configured" if maza_address else "missing")
        ),
        "tokens": {
            "oven_node_token": bool(
                os.environ.get("AI_OVEN_NODE_TOKEN")
                or os.environ.get("PINBALL_OVEN_TOKEN")
            ),
            "autos_worker_token": bool(os.environ.get("AUTOS_WORKER_TOKEN")),
        },
        "ollama": model_map(),
        "rotary_relay_configured": rotary_relay["controller_gateway"],
        "rotary_relay": rotary_relay,
        "autos_worker": worker_status,
    }
    status["ok"] = (
        status["maza_address_configured"]
        and all(status["ollama"].get("baseline", {}).values())
        and status["autos_worker"].get("ok") is True
    )
    print(json.dumps(status, indent=2, ensure_ascii=True))
    return 0 if status["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())

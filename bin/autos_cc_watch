#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "io/console"
require "json"
require "time"

class String
  def presence
    strip.empty? ? nil : self
  end

  def present?
    !strip.empty?
  end
end

DEFAULT_AUTOS_LOG = File.expand_path("~/.config/autos/log/autos_cc_activity.jsonl")
LEGACY_LOG = File.expand_path("../log/autos_cc_activity.jsonl", __dir__)

STREAM_ORDER = %w[AUTOS.SMS AUTOS.WEATHER AUTOS.ASK AUTOS.TELEGRAM].freeze
STREAM_COLORS = {
  "AUTOS.SMS" => "255;86;181",
  "AUTOS.WEATHER" => "42;224;198",
  "AUTOS.ASK" => "255;190;73",
  "AUTOS.TELEGRAM" => "92;174;255"
}.freeze

class AutosWatchDashboard
  HEADER_ROWS = 5
  MIN_ROWS = 12
  RESET = "\e[0m"
  BORDER = "\e[38;2;48;90;105m"
  SOFT = "\e[38;2;126;157;190m"
  WHITE = "\e[1;38;2;238;248;255m"
  TURQUOISE = "\e[1;38;2;42;224;198m"
  STEEL = "\e[1;38;2;174;199;212m"
  PLASMA = "\e[1;38;2;202;84;255m"
  GREEN = "\e[1;38;2;111;235;162m"

  def initialize(enabled:, stream_count:)
    @enabled = enabled && $stdout.tty?
    @stream_count = stream_count
    @active_stream = nil
    @last_event = nil
    @selected_route = ENV.fetch("AUTOS_WATCH_DEFAULT_ROUTE", "waiting").to_s.downcase
    @active_provider = nil
    @provider_signals = { qwen: 0, nemotron: 0 }
    @started = false
  end

  def start
    return unless @enabled

    rows, columns = $stdout.winsize
    return if rows < MIN_ROWS || columns < 62

    @rows = rows
    @columns = columns
    @started = true
    $stdout.write("\e[2J\e[H\e[#{HEADER_ROWS + 1};#{rows}r")
    draw
    $stdout.write("\e[#{HEADER_ROWS + 1};1H")
    $stdout.flush
  end

  def observe(stream_name, event)
    return unless @started

    @active_stream = stream_name if STREAM_ORDER.include?(stream_name)
    @last_event = event["time"].to_s
    observe_route(event)
    observe_provider(event)
    draw
  end

  def stop
    return unless @started

    $stdout.write("\e[r\e[#{@rows};1H\e[2K#{RESET}\n")
    $stdout.flush
    @started = false
  end

  private

  def draw
    width = @columns
    inner_width = width - 2
    title = "─ AUTOS WATCH // PBU HYBRID OVEN "
    title_fill = [width - title.length - 2, 0].max
    lines = [
      [["╭", BORDER], [title, TURQUOISE], ["─" * title_fill, BORDER], ["╮", BORDER]],
      stream_segments(inner_width, first_row: true),
      stream_segments(inner_width, first_row: false),
      status_segments(inner_width),
      [["╰", BORDER], ["─" * inner_width, BORDER], ["╯", BORDER]]
    ]

    $stdout.write("\e7")
    lines.each_with_index do |segments, index|
      $stdout.write("\e[#{index + 1};1H\e[2K#{render_segments(segments, width)}#{RESET}")
    end
    $stdout.write("\e8")
    $stdout.flush
  end

  def stream_segments(inner_width, first_row:)
    wide = @columns >= 106
    streams = if wide
      first_row ? STREAM_ORDER : []
    else
      first_row ? STREAM_ORDER.first(2) : STREAM_ORDER.last(2)
    end

    segments = [["│ ", BORDER]]
    if first_row
      segments << ["(\\_/)", TURQUOISE]
      segments << ["[", STEEL]
      segments << ["@", PLASMA]
      segments << ["_", STEEL]
      segments << ["@", PLASMA]
      segments << ["]", STEEL]
      segments << ["  STREAMS  ", WHITE]
    elsif wide
      segments << ["  ROUTE  ", SOFT]
      segments << [route_label, route_style]
      segments << ["  //  SIGNAL  ", SOFT]
      segments << [@active_stream || "waiting for a local event", @active_stream ? stream_style(@active_stream) : SOFT]
      segments << ["  //  SWITCH @ 313.CASH/AI", SOFT]
    else
      segments << [" " * 21, nil]
    end

    streams.each do |stream|
      segments << [stream_chip(stream), stream_style(stream, active: stream == @active_stream)]
      segments << [" ", nil]
    end
    if !first_row && !wide
      segments << ["active: ", SOFT]
      segments << [@active_stream || "waiting", @active_stream ? stream_style(@active_stream) : SOFT]
    end
    close_line(segments, inner_width)
  end

  def status_segments(inner_width)
    narrow = @columns < 106
    last_signal = if @last_event.to_s.empty?
      "AWAITING SIGNAL"
    elsif narrow
      "LAST #{@last_event[/T(\d{2}:\d{2}:\d{2})/, 1] || @last_event}"
    else
      "LAST #{@last_event}"
    end
    segments = [
      ["│ ", BORDER],
      ["● ", GREEN],
      [narrow ? route_label : "SELECTED #{route_label}", route_style],
      ["  //  ", SOFT],
      ["QWEN #{@provider_signals[:qwen]}", TURQUOISE],
      ["  //  ", SOFT],
      ["NEM #{@provider_signals[:nemotron]}", PLASMA],
      ["  //  ", SOFT],
      [narrow ? "#{@stream_count} FEEDS" : "#{@stream_count} EVENT FEEDS", TURQUOISE],
      ["  //  ", SOFT],
      [last_signal, SOFT],
      [narrow ? "  //  CTRL-C" : "  //  CTRL-C CLOSE", SOFT]
    ]
    close_line(segments, inner_width)
  end

  def close_line(segments, inner_width)
    visible = segments.sum { |text, _style| text.length }
    segments.concat([[" " * [inner_width + 1 - visible, 0].max, nil], ["│", BORDER]])
    segments
  end

  def stream_chip(stream)
    stream == @active_stream ? "[● #{stream}]" : "[  #{stream}]"
  end

  def observe_route(event)
    selected = event["selected_route"].to_s.downcase.strip
    selected = event.dig("route", "mode").to_s.downcase.strip if selected.empty? && event["route"].is_a?(Hash)
    return unless %w[qwen nemotron].include?(selected)
    return if event.key?("route_switchable") && !event["route_switchable"]

    @selected_route = selected
  end

  def observe_provider(event)
    return unless %w[
      route_selected ollama_request server_cloud_fallback answer complete
      exam_generator_started exam_generator_completed writer_started writer_completed
      judge_batch_started judge_completed dojo_completed
    ].include?(event["event"].to_s)

    text = [event["provider"], event["model"], event["selected_route"]].compact.join(" ").downcase
    provider = if text.match?(/nemotron|nvidia|server_cloud/)
      :nemotron
    elsif text.match?(/qwen|local_cc|ollama/) || event["event"].to_s == "ollama_request"
      :qwen
    end
    return unless provider

    @active_provider = provider
    @provider_signals[provider] += 1
  end

  def route_label
    case @selected_route
    when "nemotron" then "NEMOTRON"
    when "qwen" then "QWEN 8B LOCAL"
    else "ROUTE WAITING"
    end
  end

  def route_style
    @selected_route == "nemotron" ? PLASMA : (@selected_route == "qwen" ? TURQUOISE : SOFT)
  end

  def stream_style(stream, active: false)
    rgb = STREAM_COLORS.fetch(stream, "126;157;190")
    active ? "\e[1;38;2;8;14;22;48;2;#{rgb}m" : "\e[1;38;2;#{rgb}m"
  end

  def render_segments(segments, width)
    rendered = +""
    visible = 0
    active_style = nil

    segments.each do |text, style|
      break if visible >= width

      piece = text.to_s.each_char.take(width - visible).join
      next if piece.empty?

      if style != active_style
        rendered << RESET if active_style
        rendered << style if style
        active_style = style
      end
      rendered << piece
      visible += piece.length
    end
    rendered << RESET if active_style
    rendered
  end
end

raw = ARGV.delete("--raw")
all = ARGV.delete("--all")
follow = !ARGV.delete("--no-follow")
ARGV.delete("--autos") || ARGV.delete("--pinball") || ARGV.delete("--pinball-autos")

custom_log = nil
if (idx = ARGV.index("--log"))
  ARGV.delete_at(idx)
  custom_log = ARGV.delete_at(idx)
end

stream_specs = []
while (idx = ARGV.index("--stream"))
  ARGV.delete_at(idx)
  raw_spec = ARGV.delete_at(idx).to_s
  label, path = raw_spec.split("=", 2)
  abort "autos_cc_watch: --stream expects LABEL=PATH" if label.to_s.strip.empty? || path.to_s.strip.empty?

  stream_specs << { name: label.to_s.strip.upcase, path: File.expand_path(path.to_s.strip) }
end

LINE_COUNT = Integer(ENV.fetch("AUTOS_CC_WATCH_LINES", "120"))
STREAM_LABEL = ENV.fetch("AUTOS_WATCH_STREAM_LABEL", "PINBALL.AUTOS")

if ARGV.delete("--help") || ARGV.delete("-h")
  puts "Usage: bin/autos_cc_watch [--autos|--pinball] [--log PATH] [--stream LABEL=PATH] [--all] [--no-follow] [--raw]"
  puts
  puts "Default mode:            Pinball AUTOS"
  puts "Default AUTOS log:       #{DEFAULT_AUTOS_LOG}"
  puts "Legacy log:              #{LEGACY_LOG}"
  exit 0
end

streams = if stream_specs.any?
  stream_specs
elsif custom_log
  [{ name: STREAM_LABEL, path: File.expand_path(custom_log) }]
else
  [{ name: "PINBALL.AUTOS", path: ENV["AUTOS_WORKER_ACTIVITY_LOG"].to_s.presence || DEFAULT_AUTOS_LOG }]
end

STATE = {
  workers: {},
  questions: {},
  fallback: {},
  reports: {}
}

def logical_stream_for(event, configured_name)
  values = [
    configured_name,
    event["worker_id"],
    event["source"],
    event["surface"],
    event["queue"],
    event["kind"]
  ].compact.join(" ").downcase

  return "AUTOS.WEATHER" if values.include?("weather")
  return "AUTOS.TELEGRAM" if values.include?("telegram")
  return "AUTOS.SMS" if values.match?(/(?:^|[._\s-])(sms|comms)(?:$|[._\s-])/)
  return "AUTOS.ASK" if values.match?(/(?:^|[._\s-])(ask|web|chicle)(?:$|[._\s-])/)
  return configured_name if STREAM_ORDER.include?(configured_name)

  "AUTOS.ASK"
end

def public_text(value)
  value.to_s
    .gsub(/\bdope\b/i, "AUTOS")
    .gsub(/\bdve\b/i, "AUTOS")
end

def parse_time(value)
  Time.iso8601(value.to_s)
rescue ArgumentError
  Time.at(0)
end

def key_for(event, stream_name)
  [stream_name, event["worker_id"].to_s, event["id"].to_s]
end

def event_order(event)
  {
    "startup" => 0,
    "status" => 1,
    "route_status" => 1,
    "route_selected" => 2,
    "dojo_queued" => 2,
    "exam_generator_started" => 3,
    "writer_started" => 4,
    "writer_completed" => 5,
    "judge_batch_started" => 5,
    "judge_completed" => 6,
    "dojo_completed" => 7,
    "dojo_failed" => 8,
    "claimed" => 2,
    "generation_prompt" => 3,
    "question" => 2,
    "frontier_fallback" => 3,
    "frontier_required" => 3,
    "openai_request" => 4,
    "openai_retry" => 4,
    "frontier_fallback_unavailable" => 3,
    "openai_empty_response" => 4,
    "openai_response" => 5,
    "canva_packet" => 5,
    "answer" => 5,
    "completed" => 6,
    "complete" => 6,
    "failed" => 7,
    "fail_endpoint_error" => 7,
    "error" => 7,
    "idle" => 99
  }.fetch(event["event"].to_s, 9)
end

def event_sequence_order(event)
  sequence = event["sequence"]
  return sequence.to_i unless sequence.nil?

  event_order(event)
end

def compact_text(text, max = nil)
  value = public_text(text).strip
  return "" if value.empty?
  return value unless max && value.length > max

  clipped = value[0, max]
  last_space = clipped.rindex(/\s/)
  clipped = clipped[0...last_space] if last_space && last_space > (max * 0.65)
  "#{clipped.strip}..."
end

def print_block(label, text)
  value = public_text(text).strip
  return if value.empty?

  puts "#{label}:"
  value.split("\n").each { |line| puts "  #{line}" }
end

def origin_label(event, stream_name)
  source = event["source"].to_s
  surface = event["surface"].to_s

  return "weather brain" if stream_name == "AUTOS.WEATHER" || surface == "weather_outcome_analysis"
  return "telegram" if source == "telegram"
  return "power prompt/thumper" if source == "thumper"
  return "web guest/private" if source == "web" && surface == "chicle_private"
  return "web guest" if source == "web"
  return "autos system" if source == "system"
  return "autos service" if source.match?(/\A(?:dope|dve)\z/i)

  public_text([source, surface].reject(&:empty?).join("/")).presence || "unknown"
end

def destination_label(event, stream_name)
  provider = event["provider"].to_s
  model = event["model"].to_s
  preferred = event["preferred_provider"].to_s
  worker = STATE[:workers][event["worker_id"].to_s] || {}

  if provider == "openai"
    return ["openai", model].reject(&:empty?).join(" ")
  end

  if provider == "local_cc" || preferred == "local_cc"
    local_model = model.presence || event["local_model"].to_s.presence || worker[:local_model]
    return ["qwen/local", local_model].compact.join(" ")
  end

  return [provider, model].reject(&:empty?).join(" ") if provider.present? || model.present?

  "pending"
end

def headline(event, stream_name)
  id = event["id"] ? "##{event["id"]}" : nil
  origin = origin_label(event, stream_name)
  route = destination_label(event, stream_name)
  bits = [stream_name, id, "origin=#{origin}", "to=#{route}"].compact
  bits.join(" ")
end

def elapsed_for(event, stream_name)
  key = key_for(event, stream_name)
  question_time = STATE[:questions][key]
  return nil unless question_time

  elapsed = parse_time(event["time"]) - question_time
  return nil if elapsed.negative?

  format("%.1fs", elapsed)
end

def print_sources(event)
  sources = event["semantic_sources"]
  return unless sources.is_a?(Array) && sources.any?

  formatted = sources.first(5).map do |source|
    score = source["score"] ? format("%.3f", source["score"].to_f) : "?"
    "#{source["path"]} (#{score})"
  end
  puts "sources=#{formatted.join("; ")}"
end

def record_state(event, stream_name)
  worker_id = event["worker_id"].to_s
  STATE[:workers][worker_id] ||= {}
  if event["local_model"].to_s.presence
    STATE[:workers][worker_id][:local_model] = event["local_model"].to_s
  end

  case event["event"].to_s
  when "question"
    STATE[:questions][key_for(event, stream_name)] = parse_time(event["time"])
  when "frontier_fallback"
    STATE[:fallback][key_for(event, stream_name)] = {
      at: parse_time(event["time"]),
      reason: event["reason"],
      local_model: event["local_model"]
    }
  when "frontier_required"
    STATE[:fallback][key_for(event, stream_name)] = {
      at: parse_time(event["time"]),
      reason: event["reason"],
      local_model: event["local_model"]
    }
  end
end

def visible_history_event?(event, raw:)
  return true if raw

  !%w[idle embedding_context].include?(event["event"].to_s)
end

def cloud_status_suffix(event)
  cloud = event["cloud_writer"]
  return "" unless cloud.is_a?(Hash) && !cloud.empty?

  latest_model = event["cloud_latest_model"].to_s.presence ||
    Array(cloud["recent"]).first.to_h["writer_model"].to_s.presence
  latest_status = event["cloud_latest_status"].to_s.presence ||
    Array(cloud["recent"]).first.to_h["worker_status"].to_s.presence
  latest = [latest_model, latest_status].compact.join("/")
  bits = [
    "cloud=#{cloud["active"] ? "active" : "idle"}",
    "cloud_processing=#{cloud["processing"].to_i}",
    "cloud_answered=#{cloud["answered_recent"].to_i}",
    "cloud_failed=#{cloud["failed_recent"].to_i}"
  ]
  bits << "latest=#{latest}" if latest.present?
  " #{bits.join(" ")}"
end

def render(event, stream_name:, raw:, dashboard:)
  record_state(event, stream_name)

  if raw
    puts JSON.pretty_generate(event.merge("stream" => stream_name))
    return
  end

  time = event["time"].to_s
  kind = event["event"].to_s
  return if %w[idle embedding_context].include?(kind)

  dashboard.observe(stream_name, event)

  case kind
  when "startup"
    puts "[#{time}] #{stream_name} worker started #{event["worker_id"]} model=#{event["local_model"]}"
  when "status"
    server_model = event["server_local_model"]
    suffix = server_model && server_model != event["local_model"] ? " server_model=#{server_model}" : ""
    puts "[#{time}] #{stream_name} status enabled=#{event["enabled"]} queued=#{event["queued"] || 0} model=#{event["local_model"]}#{suffix}#{cloud_status_suffix(event)}"
  when "route_status"
    puts "[#{time}] ROUTE READY #{stream_name} selected=#{event["selected_route"]} provider=#{event["provider"]} model=#{event["model"]} switchable=#{event["route_switchable"]}"
  when "route_selected"
    puts "[#{time}] ROUTE SELECTED #{stream_name} ##{event["id"]} #{event["selected_route"]} -> #{event["provider"]} #{event["model"]}"
  when "dojo_queued"
    puts
    puts "[#{time}] SAMPLE DOJO QUEUED #{stream_name} run=#{event["id"]} queue=#{event["queue"].presence || "sample"}"
  when "exam_generator_started"
    puts "[#{time}] SAMPLE EXAM GENERATOR START #{stream_name} provider=#{event["provider"]} model=#{event["model"]}"
  when "exam_generator_completed"
    puts "[#{time}] SAMPLE EXAM READY #{stream_name} provider=#{event["provider"]} model=#{event["model"]} latency=#{event["latency_ms"]}ms"
  when "case_inbound_settled"
    puts "[#{time}] SAMPLE CASE SETTLED #{stream_name} case=#{event["case_number"]}/10 messages=#{event["message_count"] || 1}"
  when "writer_started"
    puts "[#{time}] SAMPLE WRITER START #{stream_name} case=#{event["case_number"]}/10 provider=#{event["provider"]} model=#{event["model"]}"
  when "writer_completed"
    puts "[#{time}] SAMPLE WRITER DONE #{stream_name} case=#{event["case_number"]}/10 provider=#{event["provider"]} model=#{event["model"]} latency=#{event["latency_ms"]}ms"
  when "judge_batch_started"
    puts "[#{time}] SAMPLE JUDGE START #{stream_name} cases=#{event["case_count"] || 10} provider=#{event["provider"]} model=#{event["model"]}"
  when "judge_completed"
    puts "[#{time}] SAMPLE JUDGE RECEIPT #{stream_name} case=#{event["case_number"]}/10 score=#{event["score"]}/100"
  when "dojo_completed"
    puts "[#{time}] SAMPLE DOJO COMPLETE #{stream_name} score=#{event["score"]}/100 duration=#{event["duration_seconds"]}s provider=#{event["provider"]} model=#{event["model"]}"
  when "dojo_failed"
    puts "[#{time}] SAMPLE DOJO FAILED #{stream_name} run=#{event["id"]}"
  when "status_failed"
    puts "[#{time}] #{stream_name} status failed #{event["http_code"] || event["error_class"]}: #{event["body"] || event["error"]}"
  when "claimed"
    puts
    puts "[#{time}] REPORT CLAIMED #{stream_name} ##{event["id"]}"
    print_block("DEAL", event["status"])
  when "generation_prompt"
    puts "[#{time}] REPORT PROMPT #{stream_name} ##{event["id"]} provider=#{event["provider"]}"
    print_block("BRIEF", compact_text(event["status"], 320))
  when "local_request"
    puts "[#{time}] REPORT LOCAL/OLLAMA START #{stream_name} ##{event["id"]} model=#{event["model"]} #{event["status"]}"
  when "local_retry"
    puts "[#{time}] REPORT LOCAL/OLLAMA RETRY #{stream_name} ##{event["id"]} model=#{event["model"]} #{event["status"]}"
  when "local_response"
    puts "[#{time}] REPORT LOCAL/OLLAMA DONE #{stream_name} ##{event["id"]} model=#{event["model"]} #{event["status"]}"
  when "local_under_target_accepted"
    puts "[#{time}] REPORT LOCAL/OLLAMA ACCEPTED #{stream_name} ##{event["id"]} model=#{event["model"]} #{event["status"]}"
  when "local_candidate_failed"
    puts "[#{time}] REPORT LOCAL/OLLAMA FAILED CANDIDATE #{stream_name} ##{event["id"]} model=#{event["model"]} #{event["status"]}"
  when "openai_request"
    puts "[#{time}] REPORT OPENAI START #{stream_name} ##{event["id"]} model=#{event["model"]} #{event["status"]}"
  when "openai_retry"
    puts "[#{time}] REPORT OPENAI RETRY #{stream_name} ##{event["id"]} model=#{event["model"]} #{event["status"]}"
  when "openai_response"
    puts "[#{time}] REPORT OPENAI DONE #{stream_name} ##{event["id"]} model=#{event["model"]} #{event["status"]}"
  when "canva_packet"
    puts "[#{time}] REPORT CANVA PACKET #{stream_name} ##{event["id"]}"
    print_block("FILE", event["status"])
  when "completed"
    puts "[#{time}] REPORT COMPLETE #{stream_name} ##{event["id"]} provider=#{event["provider"]} model=#{event["model"]} result=#{event["status"]}"
  when "dry_run_ready"
    puts "[#{time}] REPORT READY DRY-RUN #{stream_name} ##{event["id"]} provider=#{event["provider"]} model=#{event["model"]}"
    print_block("FILE", event["status"])
  when "failed"
    puts "[#{time}] REPORT FAILED #{stream_name} ##{event["id"]}"
    print_block("ERROR", event["status"])
  when "fail_endpoint_error"
    puts "[#{time}] REPORT FAIL-ENDPOINT ERROR #{stream_name} ##{event["id"]}"
    print_block("ERROR", event["status"])
  when "logo_skipped"
    puts "[#{time}] REPORT LOGO SKIPPED #{stream_name} ##{event["id"]} reason=#{event["status"]}"
  when "openai_candidate_failed"
    puts "[#{time}] REPORT MODEL SKIPPED #{stream_name} model=#{event["model"]} reason=#{event["status"]}"
  when "recent_reports_fallback"
    puts "[#{time}] #{stream_name} recent reports fallback #{event["status"]}"
  when "question"
    puts
    puts "[#{time}] QUESTION #{headline(event, stream_name)}"
    print_block("Q", compact_text(event["prompt"], 280))
    puts "context_chars=#{event["context_chars"]}" if event["context_chars"]
  when "ollama_request"
    puts "[#{time}] LOCAL OVEN START #{stream_name} ##{event["id"]} model=#{event["model"].presence || "qwen3:8b"}"
  when "server_cloud_fallback"
    puts "[#{time}] ROUTE #{stream_name} ##{event["id"]} local -> #{public_text(event["provider"].presence || "cloud")} model=#{event["model"]}"
  when "frontier_fallback"
    local_model = event["local_model"].to_s.presence || "local"
    puts "[#{time}] ROUTE #{stream_name} ##{event["id"]} qwen/local #{local_model} -> openai reason=#{event["reason"]}"
  when "frontier_required"
    local_model = event["local_model"].to_s.presence || "local"
    puts "[#{time}] ROUTE #{stream_name} ##{event["id"]} qwen/local #{local_model} -> openai REQUIRED reason=#{event["reason"]}"
  when "frontier_fallback_unavailable"
    puts "[#{time}] ROUTE #{stream_name} ##{event["id"]} openai unavailable reason=#{event["reason"]}"
  when "openai_empty_response"
    diagnostic = event["openai"].is_a?(Hash) ? event["openai"] : {}
    puts "[#{time}] OPENAI_EMPTY #{stream_name} ##{event["id"]} status=#{diagnostic["status"] || diagnostic[:status]} retrying"
  when "answer"
    elapsed = elapsed_for(event, stream_name)
    elapsed_suffix = elapsed ? " elapsed=#{elapsed}" : ""
    fallback = STATE[:fallback][key_for(event, stream_name)]
    route_note = fallback && event["provider"].to_s == "openai" ? " route=qwen->openai" : ""
    puts "[#{time}] ANSWER #{headline(event, stream_name)} provider=#{event["provider"]} model=#{event["model"]}#{route_note}#{elapsed_suffix}"
    print_block("A", compact_text(event["answer"], 520))
    usage = event["usage"].is_a?(Hash) ? event["usage"] : {}
    puts "tokens=#{usage["total_tokens"]}" if usage["total_tokens"]
    print_sources(event)
  when "complete"
    elapsed = elapsed_for(event, stream_name)
    elapsed_suffix = elapsed ? " elapsed=#{elapsed}" : ""
    puts "[#{time}] COMPLETE #{stream_name} ##{event["id"]} via #{event["provider"]} #{event["model"]}#{elapsed_suffix}"
  when "error"
    elapsed = elapsed_for(event, stream_name)
    elapsed_suffix = elapsed ? " elapsed=#{elapsed}" : ""
    puts "[#{time}] ERROR #{headline(event, stream_name)} #{event["error_class"]}: #{event["error"]}#{elapsed_suffix}"
  else
    safe_keys = %w[id provider model local_model enabled queued status reason error error_class http_code case_number case_count message_count score latency_ms duration_seconds]
    payload = event.select { |key, _| safe_keys.include?(key) }
      .transform_values { |value| compact_text(value, 180) }
    puts "[#{time}] #{stream_name} #{public_text(kind)} #{payload}"
  end
end

def parse_line(line, stream_name)
  return nil if line.to_s.strip.empty?

  event = JSON.parse(line)
  event["_stream"] = logical_stream_for(event, stream_name)
  event
rescue JSON::ParserError => e
  warn "Skipping invalid #{stream_name} activity line: #{e.message}"
  nil
end

streams.each do |stream|
  FileUtils.mkdir_p(File.dirname(stream[:path]))
  FileUtils.touch(stream[:path])
end

dashboard = AutosWatchDashboard.new(
  enabled: ENV.fetch("AUTOS_CC_WATCH_DASHBOARD", "0") == "1" && !raw,
  stream_count: streams.size
)

dashboard.start
begin
  puts "Watching #{streams.map { |stream| "#{stream[:name]}=#{stream[:path]}" }.join(" | ")}" unless raw

  initial_events = streams.flat_map do |stream|
    events = File.readlines(stream[:path]).map { |line| parse_line(line, stream[:name]) }.compact
    if raw || all
      events = events.last(LINE_COUNT) unless all
    else
      events = events.select { |event| visible_history_event?(event, raw: raw) }.last(LINE_COUNT)
    end
    events
  end

  initial_events.sort_by { |event| [parse_time(event["time"]), event["_stream"].to_s, event["id"].to_s, event_sequence_order(event)] }.each do |event|
    render(event, stream_name: event.delete("_stream"), raw: raw, dashboard: dashboard)
  end

  exit 0 unless follow

  files = streams.map do |stream|
    file = File.open(stream[:path], "r")
    file.seek(0, IO::SEEK_END)
    stream.merge(file: file)
  end

  loop do
    files.each do |stream|
      while (line = stream[:file].gets)
        event = parse_line(line, stream[:name])
        render(event, stream_name: event.delete("_stream"), raw: raw, dashboard: dashboard) if event
      end
    end
    sleep 0.5
  end
ensure
  dashboard.stop
end

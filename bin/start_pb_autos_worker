#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR"

set -a
if [[ -f "$ROOT_DIR/.env" ]]; then
  source "$ROOT_DIR/.env"
fi
for env_file in \
  "$HOME/.config/autos/alice.env" \
  "$HOME/.config/pinball/pb-autos.env" \
  "$HOME/.config/pinball/pb-autos-worker.env" \
  "$HOME/.config/pinball/alice-local-01.oven.env"; do
  if [[ -f "$env_file" ]]; then
    source "$env_file"
  fi
done
set +a

if [[ -n "${AI_OVEN_NODE_TOKEN:-}" ]]; then
  export AUTOS_WORKER_TOKEN="$AI_OVEN_NODE_TOKEN"
fi

if [[ -z "${AUTOS_WORKER_TOKEN:-}" ]]; then
  echo "AUTOS_WORKER_TOKEN is required for PB AUTOS worker" >&2
  exit 1
fi

export AUTOS_WORKER_ID="${PB_AUTOS_WORKER_ID:-alice-pb-autos-01}"
export AUTOS_WORKER_BASE_URL="${PB_AUTOS_WORKER_BASE_URL:-http://127.0.0.1:3333}"
export AUTOS_BRAIN_BASE_URL="${PB_AUTOS_BRAIN_BASE_URL:-$AUTOS_WORKER_BASE_URL}"
export AUTOS_WORKER_QUEUE="${PB_AUTOS_WORKER_QUEUE:-all}"
export AUTOS_WORKER_POLL_SECONDS="${PB_AUTOS_WORKER_POLL_SECONDS:-2}"
export AUTOS_RORE_PROTOCOL="${PB_AUTOS_RORE_PROTOCOL:-rore.worker.v1}"
export AUTOS_LOCAL_MODEL="${PB_AUTOS_LOCAL_MODEL:-qwen3:8b}"
export AUTOS_LOCAL_FRONTIER_MODEL="${PB_AUTOS_LOCAL_FRONTIER_MODEL:-qwen3:30b}"
export AUTOS_LOCAL_RAG_DRAFT_LIMIT="${PB_AUTOS_LOCAL_RAG_DRAFT_LIMIT:-12}"
export AUTOS_CC_EMBEDDING_WORKER_ENABLED="${PB_AUTOS_EMBEDDING_WORKER_ENABLED:-1}"
export AUTOS_CC_PB_BRAIN_EMBEDDING_ENABLED="${PB_AUTOS_PB_BRAIN_EMBEDDING_ENABLED:-1}"
export AUTOS_CC_EMBED_MODEL="${PB_AUTOS_EMBED_MODEL:-qwen3-embedding:8b-q4_K_M}"
export AUTOS_WORKER_OPENAI_FALLBACK="${PB_AUTOS_OPENAI_FALLBACK:-${AUTOS_WORKER_OPENAI_FALLBACK:-0}}"
export AUTOS_WORKER_ACTIVITY_LOG="$HOME/.config/autos/log/pb_cc_activity.jsonl"

exec "$ROOT_DIR/bin/autos_cc_worker"

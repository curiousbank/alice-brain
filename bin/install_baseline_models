#!/usr/bin/env bash
set -euo pipefail

models_to_install=(
  "${AUTOS_LOCAL_MODEL:-qwen3:8b}"
)

if [[ "${INSTALL_EMBEDDING_MODEL:-0}" == "1" ]]; then
  models_to_install+=("${AUTOS_EMBEDDER_MODEL:-qwen3-embedding:4b}")
else
  echo "Skipping optional embedding model. Set INSTALL_EMBEDDING_MODEL=1 to include it."
fi

if [[ "${INSTALL_VISION_MODEL:-0}" == "1" ]]; then
  models_to_install+=("${AUTOS_VISION_MODEL:-qwen3-vl:8b}")
else
  echo "Skipping optional vision model. Set INSTALL_VISION_MODEL=1 to include it."
fi

if [[ "${INSTALL_GLM_OCR:-0}" == "1" ]]; then
  models_to_install+=("glm-ocr:bf16")
else
  echo "Skipping optional glm-ocr:bf16. Set INSTALL_GLM_OCR=1 to include it."
fi

if ! command -v ollama >/dev/null 2>&1; then
  echo "ollama is required. Install it first:"
  echo "  brew install ollama"
  exit 1
fi

echo "Installing Alice Brain baseline Ollama models..."
for model in "${models_to_install[@]}"; do
  echo "==> ollama pull ${model}"
  ollama pull "${model}"
done

echo
echo "Installed model list:"
ollama list

def strategy_proposal_style_summary() -> str | None:
    if str(env("DOPE_REPORT_INCLUDE_LOCAL_STYLE", "0")).strip().lower() not in {"1", "true", "yes", "on"}:
        return None
    configured = env("DOPE_STRATEGY_PROPOSAL_STYLE_PATH")
    candidate_paths = [Path(configured).expanduser()] if configured else [STRATEGY_PROPOSAL_STYLE_PATH, STRATEGY_PROPOSAL_CONTEXT_PATH]
    path = next((candidate for candidate in candidate_paths if candidate.exists()), candidate_paths[0])
    if not path.exists():
        return None
    try:
        text = path.read_text(encoding="utf-8", errors="ignore").strip()
    except OSError as error:
        log("style_reference_error", status=f"{path}: {error}")
        return None
    return text[:12_000] if text else None


def report_timing_context(job: dict) -> dict:
    sun_timing = (job.get("timing_context") or job.get("report_contract", {}).get("timing_context") or {}) if isinstance(job, dict) else {}
    now = dt.datetime.now(dt.timezone.utc).astimezone()
    current_date = now.date()
    configured_lead = env("DOPE_REPORT_PRODUCTION_LEAD_DAYS") or sun_timing.get("minimum_production_lead_days") or "14"
    lead_days = bounded_int(configured_lead, 14, 1, 90)
    earliest_date = current_date + dt.timedelta(days=lead_days)
    authoritative_date = str(sun_timing.get("current_date") or current_date.isoformat())
    authoritative_earliest = str(sun_timing.get("earliest_production_ready_date") or earliest_date.isoformat())

    return {
        "generated_at_local": now.isoformat(timespec="seconds"),
        "current_date_local": current_date.isoformat(),
        "current_time_zone_local": now.tzname(),
        "authoritative_current_date": authoritative_date,
        "minimum_production_lead_days": lead_days,
        "earliest_production_ready_date": authoritative_earliest,
        "source": "SUN timing_context preferred; Alice local clock included as fallback",
        "timing_rule": f"Build all campaign timing from authoritative_current_date and allow at least {lead_days} calendar days for design, proofing, print setup, production, and mail/drop preparation.",
        "recommendation_rule": "Do not recommend an immediate launch/mail/drop date earlier than earliest_production_ready_date. If the seasonal window is too close, recommend the next practical window.",
        "sun_payload_timing_context": sun_timing,
    }


def report_prompt_input(job: dict, retry_note: str | None = None) -> str:
    contract = job.get("report_contract", {}) or {}
    primary_prompt = job.get("generation_prompt") or contract.get("llm_prompt") or contract.get("requested_output")
    uploaded_media = job.get("assets", {}).get("uploaded_media", []) or []
    retrieval_context, embedding_meta = ensure_embedding_context(job)
    repair_context, repair_embedding_meta = ensure_repair_embedding_context(job, retry_note) if retry_note else ("", {})
    prompt_package = {
        "primary_generation_prompt": primary_prompt,
        "retry_note": retry_note,
        "reference_style_summary": strategy_proposal_style_summary(),
        "local_retrieval_context": retrieval_context,
        "repair_retrieval_context": repair_context,
        "embedding_runtime": job.get("embedding_runtime", {}) or {},
        "embedding_summary": embedding_meta,
        "repair_embedding_summary": repair_embedding_meta,
        "timing_context": report_timing_context(job),
        "previous_draft_for_repair": job.get("_alice_previous_draft") if retry_note else None,
        "quality_errors_to_fix": job.get("_alice_quality_errors") if retry_note else None,
        "report_contract": contract,
        "required_sections": contract.get("required_sections", []),
        "writing_rules": contract.get("writing_rules", []),
        "deal": job.get("deal", {}),
        "company": job.get("company", {}),
        "commerce": job.get("commerce", {}),
        "campaign_context": job.get("campaign_context", {}),
        "account_graph": job.get("account_graph", {}),
        "associated_data_summary": {
            "associated_company_count": len((job.get("account_graph", {}) or {}).get("companies", []) or []),
            "associated_contact_count": len((job.get("account_graph", {}) or {}).get("contacts", []) or []),
            "associated_deal_count": len((job.get("account_graph", {}) or {}).get("deals", []) or []),
        },
        "hubspot_context": {
            "labeled_properties": job.get("hubspot_context", {}).get("labeled_properties", {}),
            "raw_properties": job.get("hubspot_context", {}).get("raw_properties", {}),
            "missing_core_fields": job.get("hubspot_context", {}).get("missing_core_fields", []),
            "property_count": job.get("hubspot_context", {}).get("property_count"),
        },
        "uploaded_media": [
            {
                "filename": item.get("filename"),
                "content_type": item.get("content_type"),
                "byte_size": item.get("byte_size"),
                "role": item.get("role"),
                "endpoint": item.get("endpoint"),
            }
            for item in uploaded_media
        ],
        "embedded_media_observations": job.get("_alice_media_observations", []),
        "quality_gate": {
            "target_words": minimum_words(job),
            "hard_minimum_words": hard_minimum_words(job),
            "minimum_docx_bytes": minimum_docx_bytes(job),
            "docx_signature": "PK",
        },
    }
    return json.dumps(compact_for_prompt(prompt_package), indent=2, ensure_ascii=True)


def truthy(value) -> bool:
    return str(value or "").strip().lower() in {"1", "true", "yes", "on", "y"}


def report_runtime(job: dict) -> dict:
    contract_runtime = job.get("report_contract", {}).get("runtime_rules", {}) or {}
    job_runtime = job.get("ai_runtime", {}) or {}
    return {**contract_runtime, **job_runtime}


def runtime_or_metadata_value(job: dict, *keys: str):
    runtime = report_runtime(job)
    metadata = job.get("metadata", {}) or {}
    for key in keys:
        if key in runtime and runtime.get(key) not in (None, ""):
            return runtime.get(key)
        if key in metadata and metadata.get(key) not in (None, ""):
            return metadata.get(key)
    return None


def report_preflight_scan_enabled(job: dict) -> bool:
    value = runtime_or_metadata_value(job, "preflight_visual_scan_enabled", "report_preflight_scan_enabled")
    if value is not None:
        return truthy(value)
    return truthy(env("DOPE_REPORT_PREFLIGHT_SCAN_ENABLED", env("DOPE_REPORT_VISION_ENABLED", "0")))


def report_preflight_vision_model(job: dict) -> str:
    return str(
        runtime_or_metadata_value(job, "preflight_vision_model", "report_preflight_vision_model")
        or env("DOPE_REPORT_VISION_MODEL")
        or "qwen3-vl:8b"
    ).strip()


def report_preflight_ocr_model(job: dict) -> str:
    return str(
        runtime_or_metadata_value(job, "preflight_ocr_model", "report_preflight_ocr_model")
        or env("DOPE_REPORT_OCR_MODEL")
        or "glm-ocr:bf16"
    ).strip()


def report_post_review_enabled(job: dict) -> bool:
    value = runtime_or_metadata_value(job, "post_generation_review_enabled", "report_post_review_enabled")
    if value is not None:
        return truthy(value)
    return truthy(env("DOPE_REPORT_POST_REVIEW_ENABLED", "0"))


def report_post_review_model(job: dict, fallback_model: str) -> str:
    return str(
        runtime_or_metadata_value(job, "post_generation_review_model", "report_post_review_model")
        or env("DOPE_REPORT_POST_REVIEW_MODEL")
        or fallback_model
    ).strip()


def report_page_visual_qa_enabled(job: dict) -> bool:
    value = runtime_or_metadata_value(job, "page_visual_qa_enabled", "report_page_visual_qa_enabled")
    if value is not None:
        return truthy(value)
    return truthy(env("DOPE_REPORT_PAGE_VISUAL_QA_ENABLED", "0"))


def report_page_visual_qa_model(job: dict) -> str:
    return str(
        runtime_or_metadata_value(job, "page_visual_qa_model", "report_page_visual_qa_model")
        or env("DOPE_REPORT_PAGE_VISUAL_QA_MODEL")
        or report_preflight_vision_model(job)
        or "qwen3-vl:8b"
    ).strip()


def local_report_required(job: dict) -> bool:
    runtime = report_runtime(job)
    provider = str(runtime.get("provider") or "").lower()
    target_model = str(runtime.get("target_model") or "").lower()
    forbidden = " ".join(str(item).lower() for item in runtime.get("forbidden_providers", []) or [])
    return (
        truthy(runtime.get("qwen_only"))
        or truthy(runtime.get("force_local"))
        or "qwen" in provider
        or provider in {"local", "local_qwen", "qwen/local"}
        or "qwen" in target_model
        or ("openai" in forbidden and not truthy(runtime.get("openai_allowed")))
    )


def normalize_local_model_name(value: str) -> str:
    cleaned = str(value or "").strip()
    lowered = cleaned.lower()
    aliases = {
        "qwen3.5:9b": "qwen3:8b",
        "qwen3.5:9b-mlx": "qwen3:8b",
        "qwen3.6:27b": "qwen3:30b",
        "qwen3.6:27b-mlx": "qwen3:30b",
        "qwen3.6:35b": "qwen3:30b",
        "qwen3.6:35b-mlx": "qwen3:30b",
        "qwen3:30b-a3b": "qwen3:30b",
        "qwen3:14b": "qwen3:8b",
        "devstral-small-2:24b": "qwen3:8b",
        "gemma4:e4b": "qwen3:8b",
        "granite4.1:8b": "qwen3:8b",
    }
    return aliases.get(lowered, cleaned)


def local_model_candidates(job: dict) -> list[str]:
    runtime = report_runtime(job)
    metadata = job.get("metadata", {}) or {}
    contract = job.get("report_contract", {}) or {}

    # If SUN queued an explicit per-report model, do not silently downgrade to
    # the env/default fallback. A missing selected model should fail loudly so
    # the DOPE UI does not claim a 27B report was produced by an 8B fallback.
    explicit_candidates = []
    for item in runtime.get("model_ladder") or runtime.get("models") or []:
        explicit_candidates.append(item)
    explicit_candidates.extend([
        runtime.get("local_model"),
        runtime.get("target_model"),
        metadata.get("report_local_model"),
        contract.get("target_model"),
    ])

    candidates = []
    for item in explicit_candidates:
        value = normalize_local_model_name(item)
        if not value or value.lower() in {"qwen/local", "local", "openai"}:
            continue
        if value not in candidates:
            candidates.append(value)
    if candidates:
        if strict_local_report_contract(job) and local_fallback_models_enabled(job):
            fallback_candidates = [
                *env_list("DOPE_REPORT_LOCAL_FALLBACK_MODELS"),
                *DEFAULT_LOCAL_MODEL_CANDIDATES,
            ]
            for item in fallback_candidates:
                value = normalize_local_model_name(item)
                if not value or value.lower() in {"qwen/local", "local", "openai"}:
                    continue
                if value not in candidates:
                    candidates.append(value)
        return candidates

    candidates = [
        *env_list("DOPE_REPORT_LOCAL_MODEL_CANDIDATES"),
        env("DOPE_REPORT_LOCAL_MODEL"),
        env("AUTOS_LOCAL_MODEL"),
        env("OLLAMA_MODEL"),
        *DEFAULT_LOCAL_MODEL_CANDIDATES,
    ]
    cleaned = []
    for item in candidates:
        value = normalize_local_model_name(item)
        if not value or value.lower() in {"qwen/local", "local", "openai"}:
            continue
        if value not in cleaned:
            cleaned.append(value)
    return cleaned


def strict_local_report_contract(job: dict) -> bool:
    contract = job.get("report_contract", {}) or {}
    quality_gate = contract_quality_gate(job)
    return bool(
        len(contract.get("required_sections", []) or []) >= 3
        or contract.get("required_tables", [])
        or quality_gate.get("required_sections")
        or quality_gate.get("required_tables")
    )


def local_fallback_models_enabled(job: dict) -> bool:
    runtime = report_runtime(job)
    if truthy(runtime.get("disable_local_model_fallbacks")):
        return False
    return truthy(runtime.get("allow_local_model_fallbacks")) or truthy(env("DOPE_REPORT_LOCAL_FALLBACKS_ENABLED", "0"))


def local_runtime_provider(model: str) -> str:
    return "qwen/local" if "qwen" in str(model or "").lower() else "ollama/local"


def local_model_family(model: str) -> str:
    lowered = str(model or "").lower()
    for family in ["qwen", "devstral", "granite", "gemma", "llama"]:
        if family in lowered:
            return family
    return "ollama"


def report_generation_instructions(job: dict | None = None) -> str:
    outline = required_report_outline(job or {})
    return f"""You are the DOPEIPEDIA market analyzer for DOPE Marketing.
Write a professional, client-facing DOPE Bold Market Report.
Use payload["generation_prompt"] or payload["report_contract"]["llm_prompt"] as the controlling brief.
SUN's report contract controls the visible section order, required tables, length, and wording. Do not append legacy sections.
{outline}
Use HubSpot labeled properties, raw properties, missing core fields, deal/company/commerce data, and uploaded media filenames/endpoints as private source context only.
When embedded_media_observations are present, use them to shape visual direction, proof points, brand handling, and Canva/print recommendations. Use ocr_text only as visible image text. Do not invent image details beyond filename, dimensions, role, vision_summary, or ocr_text.
Use payload["timing_context"] for all timeline recommendations. Do not recommend a launch, mail, print, or drop date before timing_context.earliest_production_ready_date. Always allow the configured production lead time before first execution.
Analyze the full account graph when present: associated companies, contacts, prior or related deals, statuses, stages, domains, amounts, and useful HubSpot properties. Use that data to sharpen audience, timing, offer, CRM follow-up, and sales-readiness recommendations.
If associated data exists, synthesize it into practical recommendations; if it is missing, say only the customer-facing setup item when appropriate.
Do not invent private facts. If a field is missing, call out only the customer-facing setup item when the contract asks for it.
Never mention private worker names, AI vendors, model names, tokens, HubSpot IDs, or private technical metadata in visible report copy.
No caveman voice. No generic marketing filler. No JSON. No markdown fences. No hidden thinking tags.
Return only the visible client report Markdown.
Make the report feel designed, not like a memo: use large useful headings, short confident paragraphs, scannable bullets, concrete campaign names, red/black callout language, and required Markdown tables.
The visible client report must stop after the Final Recommendation section when that section exists in the contract.
Allowed internal AM sections are only the sections named in the AM report contract.
Do not include AM-Facing Actions in client reports, Designer Notes, Print Production Notes, Canva Data Postcard Handoff, Source Data Appendix, HubSpot Properties, Asset List, Human Approval Gates, assumptions tables, prompt notes, payload notes, or technical metadata.
Keep recommendations tied to DOPE services: direct mail, postcards, yard signs, door hangers, print, CRM/source-data follow-up, campaign tracking, and customer approval.
The output will be rendered into a real DOCX by the report worker, so write complete report content only."""


def local_report_prompt(job: dict, retry_note: str | None = None) -> str:
    package = report_prompt_input(job, retry_note=retry_note)
    return (
        f"{report_generation_instructions(job)}\n\n"
        "OUTPUT CONTRACT:\n"
        "- Return only the final client-visible Markdown copy.\n"
        "- Start exactly with DOPE MARKETING.\n"
        "- Do not explain what you are creating.\n"
        "- Do not echo the payload, report_contract, section list, missing inputs, or instructions.\n"
        "- Include required Markdown tables using pipe table syntax where the contract asks for tables.\n"
        "- No <think> tags, hidden reasoning, planning notes, analysis preface, or notes after the final section.\n\n"
        f"PAYLOAD:\n{package}\n\nReturn the final visible report copy now."
    )


def local_attempt_count() -> int:
    return bounded_int(env("DOPE_REPORT_LOCAL_ATTEMPTS"), 5, 1, 8)


def local_retry_note(job: dict, report_text: str, quality_errors: list[str], minimum: int) -> str:
    words = word_count(report_text)
    target = max(minimum + 150, 650)
    errors = "; ".join(quality_errors) or "too short"
    audience = str(job.get("report_contract", {}).get("audience") or job.get("metadata", {}).get("report_audience") or "client").lower()
    if audience == "am":
        visible_label = "internal AM-facing copy"
        section_rule = "Include all required internal sections, especially Internal Next Moves. "
        table_rule = "Use tables only when they help the AM act faster. "
    else:
        visible_label = "client-visible copy"
        section_rule = "Include all required client-facing sections. "
        table_rule = "Include the required campaign and investment Markdown tables. "
    return (
        f"The previous draft failed preflight: words={words}, minimum={minimum}, errors={errors}. "
        f"Revise the previous draft with {target}-{target + 250} words while staying concise and {visible_label}. "
        f"Start exactly with DOPE MARKETING. Return only {visible_label}. "
        f"{section_rule}{table_rule}Do not include planning notes, "
        "payload summaries, missing-input labels, hidden thinking, or explanation of the task. "
        "Do not use unsupported exact percentages or statistics. Do not use internal ticket/status words like abandoned, SAM, HubSpot ID, or workflow stage names in client copy. "
        "Do not leave any section heading empty or duplicate section headings."
    )


def ollama_report_response(model: str, prompt: str) -> dict:
    base_url = str(env("OLLAMA_URL", "http://127.0.0.1:11434") or "http://127.0.0.1:11434").rstrip("/")
    body = {
        "model": model,
        "prompt": prompt,
        "stream": False,
        "think": False,
        "options": {
            "temperature": float(env("DOPE_REPORT_LOCAL_TEMPERATURE", "0.28")),
            "top_k": int(env("DOPE_REPORT_LOCAL_TOP_K", "30")),
            "top_p": float(env("DOPE_REPORT_LOCAL_TOP_P", "0.86")),
            "repeat_penalty": float(env("DOPE_REPORT_LOCAL_REPEAT_PENALTY", "1.16")),
            "repeat_last_n": int(env("DOPE_REPORT_LOCAL_REPEAT_LAST_N", "256")),
            "num_ctx": int(env("DOPE_REPORT_LOCAL_CONTEXT", "16384")),
            "num_predict": int(env("DOPE_REPORT_LOCAL_MAX_TOKENS", "3600")),
        },
    }
    req = urllib.request.Request(
        f"{base_url}/api/generate",
        data=json.dumps(body).encode("utf-8"),
        headers={"Content-Type": "application/json", "User-Agent": "alice-dope-market-report-worker/2.1"},
        method="POST",
    )
    timeout = int(env("DOPE_REPORT_LOCAL_TIMEOUT", "900"))
    with urllib.request.urlopen(req, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))


def post_generation_review_prompt(job: dict, report_text: str) -> str:
    previous_draft = job.get("_alice_previous_draft")
    previous_errors = job.get("_alice_quality_errors")
    job["_alice_previous_draft"] = report_text
    job["_alice_quality_errors"] = [
        "post-review requested: tighten copy, improve specificity, preserve headings and tables, and remove generic filler"
    ]
    try:
        package = report_prompt_input(
            job,
            retry_note=(
                "POST REVIEW PASS. Lightly revise the current draft into stronger client-ready copy. "
                "Preserve the exact required section order and Markdown tables. Do not add unsupported percentages, "
                "internal notes, AI/model names, filenames, endpoints, or planning commentary."
            ),
        )
    finally:
        if previous_draft is None:
            job.pop("_alice_previous_draft", None)
        else:
            job["_alice_previous_draft"] = previous_draft
        if previous_errors is None:
            job.pop("_alice_quality_errors", None)
        else:
            job["_alice_quality_errors"] = previous_errors

    return (
        f"{report_generation_instructions(job)}\n\n"
        "POST REVIEW CONTRACT:\n"
        "- Return only the revised visible Markdown report.\n"
        "- Start exactly with DOPE MARKETING.\n"
        "- Preserve all required section headings and required Markdown tables.\n"
        "- Improve clarity, rhythm, specificity, and sales-readiness without making the report longer than needed.\n"
        "- Do not add unsupported exact percentages or statistics.\n"
        "- Do not include filenames, endpoints, model names, worker names, prompt notes, or explanation of the task.\n\n"
        f"PAYLOAD:\n{package}\n\nReturn the revised visible report copy now."
    )


def run_post_generation_review(job: dict, report_text: str, model: str) -> tuple[str, dict]:
    if not report_post_review_enabled(job):
        return report_text, {"enabled": False}
    review_model = report_post_review_model(job, model)
    if not review_model:
        return report_text, {"enabled": False, "rejected_reason": "no post-review model configured"}

    job_id = job.get("id")
    provider = local_runtime_provider(review_model)
    log("post_review_start", id=job_id, provider=provider, model=review_model, status=f"words={word_count(report_text)}")
    try:
        parsed = ollama_report_response(review_model, post_generation_review_prompt(job, report_text))
        reviewed = sanitize_visible_report_text(str(parsed.get("response") or ""))
        reviewed = sanitize_unsupported_exact_stats(reviewed, job)
        document_preview = full_document_text(job, reviewed)
        quality_errors = visible_text_quality_errors(document_preview, job)
        words = word_count(reviewed)
        if words < hard_minimum_words(job):
            quality_errors.append(f"post-review copy too short: {words} words")
        if quality_errors:
            log("post_review_rejected", id=job_id, provider=provider, model=parsed.get("model") or review_model, status="; ".join(quality_errors)[:160])
            return report_text, {
                "enabled": True,
                "accepted": False,
                "model": parsed.get("model") or review_model,
                "errors": quality_errors,
            }
        log("post_review_accepted", id=job_id, provider=provider, model=parsed.get("model") or review_model, status=f"words={words}")
        return reviewed, {
            "enabled": True,
            "accepted": True,
            "provider": provider,
            "model": parsed.get("model") or review_model,
            "usage": {
                "prompt_eval_count": parsed.get("prompt_eval_count"),
                "eval_count": parsed.get("eval_count"),
                "total_duration": parsed.get("total_duration"),
            },
            "word_count": words,
        }
    except Exception as error:
        log("post_review_error", id=job_id, provider=provider, model=review_model, status=f"{type(error).__name__}: {str(error)[:160]}")
        return report_text, {
            "enabled": True,
            "accepted": False,
            "model": review_model,
            "errors": [f"{type(error).__name__}: {str(error)[:180]}"],
        }


def strip_model_thinking(text: str) -> str:
    cleaned = re.sub(r"<think>.*?</think>", "", text or "", flags=re.I | re.S)
    # Some local reasoning models occasionally emit only a dangling closing tag.
    # In that case, everything before the final close tag is internal planning.
    if re.search(r"</think\s*>", cleaned, flags=re.I):
        cleaned = re.split(r"</think\s*>", cleaned, flags=re.I)[-1]
    cleaned = re.sub(r"</?think\s*>", "", cleaned, flags=re.I)
    cleaned = re.sub(r"^\s*```(?:markdown|md)?\s*", "", cleaned, flags=re.I)
    cleaned = re.sub(r"\s*```\s*$", "", cleaned)
    return cleaned.strip()


META_LEAK_PATTERNS = [
    r"\bwe are creating\b",
    r"\bthe visible document\b",
    r"\breport_contract\b",
    r"\bpayload specifies\b",
    r"\bfrom the payload\b",
    r"\bvisible markdown content\b",
    r"\bconverted to docx\b",
    r"\blet'?s structure\b",
    r"\bnow,?\s+we write\b",
    r"\bclient inputs\b",
    r"\bmissing inputs\b",
    r"\bwe have the following sections\b",
    r"\bwe are to write\b",
    r"\bimportant:\b",
    r"\bnote:\b",
    r"</?think\s*>",
]


def contains_meta_leak(text: str) -> bool:
    lowered = text or ""
    return any(re.search(pattern, lowered, flags=re.I) for pattern in META_LEAK_PATTERNS)


def sanitize_visible_report_text(text: str) -> str:
    cleaned = strip_model_thinking(text)
    starts = [match.start() for match in re.finditer(r"\bDOPE MARKETING\b", cleaned, flags=re.I)]
    if len(starts) > 1 and contains_meta_leak(cleaned[: starts[1]]):
        cleaned = cleaned[starts[1]:]
    elif starts and starts[0] > 0 and contains_meta_leak(cleaned[: starts[0]]):
        cleaned = cleaned[starts[0]:]
    cleaned = re.sub(r"\bworkswith\b", "works with", cleaned, flags=re.I)
    cleaned = re.sub(r"[ \t]{2,}", " ", cleaned)
    return cleaned.strip()


def markdown_table_count(text: str) -> int:
    count = 0
    in_table = False
    for line in (text or "").splitlines():
        is_table_line = line.strip().startswith("|") and "|" in line.strip()[1:]
        if is_table_line and not in_table:
            count += 1
            in_table = True
        elif not is_table_line:
            in_table = False
    return count


def normalized_heading_title(line: str) -> str | None:
    raw = line or ""
    cleaned = re.sub(r"^\s*#{1,6}\s*", "", raw)
    cleaned = re.sub(r"^\s*[-*_]{3,}\s*$", "", cleaned).strip()
    cleaned = re.sub(r"[:\s]+$", "", cleaned).strip()
    if not cleaned or len(cleaned) > 90:
        return None
    if re.search(r"[.!?]\s+", cleaned):
        return None
    if re.match(r"^(DOPE MARKETING|Header / Cover|Executive Summary|Market Snapshot|Seasonality Timeline|Recommended Campaign|Campaign Recommendation|Channel Strategy|Neighborhood Targeting|Offer Strategy|Timeline / Launch Plan|Final Recommendation|Best Opportunity Callout|Big Stat Cards|Customer Mindset|Buying Triggers|Why Print/Direct Mail Fits|Offer Card \d+)$", cleaned, flags=re.I):
        return cleaned.lower()
    return None


def duplicate_heading_titles(text: str) -> list[str]:
    seen: set[str] = set()
    duplicates: list[str] = []
    for line in (text or "").splitlines():
        title = normalized_heading_title(line)
        if not title:
            continue
        if title in seen and title not in duplicates:
            duplicates.append(title)
        seen.add(title)
    return duplicates


def empty_heading_titles(text: str) -> list[str]:
    lines = (text or "").splitlines()
    empties: list[str] = []
    for index, line in enumerate(lines):
        title = normalized_heading_title(line)
        if not title:
            continue
        if title == "dope marketing":
            continue
        following = []
        for next_line in lines[index + 1:index + 4]:
            stripped = next_line.strip()
            if stripped in {"---", "--", "___"}:
                continue
            following.append(stripped)
        if not any(following) or any(normalized_heading_title(item) for item in following[:1]):
            empties.append(title)
    return empties


def unsupported_exact_stats(text: str, job: dict) -> list[str]:
    source_blob = json.dumps(
        {
            "deal": job.get("deal", {}),
            "company": job.get("company", {}),
            "commerce": job.get("commerce", {}),
            "campaign_context": job.get("campaign_context", {}),
            "hubspot_context": job.get("hubspot_context", {}),
            "account_graph": job.get("account_graph", {}),
        },
        ensure_ascii=False,
        default=str,
    )
    found = []
    for match in re.finditer(r"(?<![\w.])\d+(?:\.\d+)?\s*%", text or ""):
        stat = re.sub(r"\s+", "", match.group(0))
        if stat not in source_blob.replace(" ", ""):
            found.append(stat)
    return sorted(set(found))


def sanitize_unsupported_exact_stats(text: str, job: dict) -> str:
    cleaned = str(text or "")
    for stat in unsupported_exact_stats(cleaned, job):
        cleaned = re.sub(rf"(?<![\w.]){re.escape(stat)}(?![\w.])", "measurable", cleaned)
        spaced = re.sub(r"(?<=\d)(?=%)", r"\\s*", re.escape(stat))
        cleaned = re.sub(rf"(?<![\w.]){spaced}(?![\w.])", "measurable", cleaned)
    cleaned = re.sub(r"\bmeasurable\s+(?:increase|lift|response|conversion|growth|improvement)\b", "measurable lift", cleaned, flags=re.I)
    cleaned = re.sub(r"\bmeasurable\s*-\s*measurable\b", "measurable", cleaned, flags=re.I)
    return cleaned


def visible_client_forbidden_terms(text: str) -> list[str]:
    terms = []
    patterns = {
        "abandoned": r"\babandoned\b",
        "sam": r"\bSAM\b",
        "hubspot id": r"\bHubSpot\s+ID\b|\bhs_[a-z0-9_]+\b",
        "internal status": r"\bChecklist Not Completed\b|\bDesign Uploaded\b|\bWaiting for Approval\b|\bDemo Call Scheduled\b",
        "ai/model mention": r"\bAlice\b|\bQwen\b|\bOpenAI\b|\bOllama\b|\bMLX\b",
    }
    for label, pattern in patterns.items():
        if re.search(pattern, text or "", flags=re.I):
            terms.append(label)
    return terms


def generic_report_markers(text: str, job: dict) -> list[str]:
    markers = []
    company_name = str((job.get("company") or {}).get("name") or (job.get("deal") or {}).get("company_name") or "").strip()
    business_name = str((job.get("report_contract") or {}).get("client", {}).get("business_name") or company_name).strip()
    visible_name = business_name or company_name
    visible_variants = [
        visible_name,
        re.sub(r"^\s*New Signup\s*-\s*", "", visible_name, flags=re.I),
    ]
    if visible_name and not any(variant and variant.lower() in (text or "").lower() for variant in visible_variants):
        markers.append("client name missing")
    industry = str((job.get("report_contract") or {}).get("client", {}).get("industry") or (job.get("company") or {}).get("industry") or "").strip()
    if industry and industry.lower() != "local service business" and industry.lower() not in (text or "").lower():
        markers.append("specific industry missing")
    if re.search(r"\blocal service business\b", text or "", flags=re.I) and industry and industry.lower() not in {"", "local service business"}:
        markers.append("generic local service business wording")
    return markers


def visible_text_quality_errors(text: str, job: dict) -> list[str]:
    errors = []
    cleaned = text or ""
    audience = str(job.get("report_contract", {}).get("audience") or job.get("metadata", {}).get("report_audience") or "client")
    if contains_meta_leak(cleaned):
        errors.append("visible copy contains model planning or prompt echo")
    if not re.match(r"^\s*(#\s*)?(\*\*)?DOPE MARKETING\b", cleaned, flags=re.I):
        errors.append("visible copy does not start with DOPE MARKETING")
    required_tables = job.get("report_contract", {}).get("required_tables", []) or []
    expected_table_count = min(len(required_tables), bounded_int(env("DOPE_REPORT_MAX_REQUIRED_TABLES"), 2, 1, 4))
    if audience != "am" and expected_table_count >= 2 and markdown_table_count(cleaned) < expected_table_count:
        errors.append(f"visible client report is missing required Markdown tables: expected at least {expected_table_count} table(s)")
    missing_sections = missing_required_section_titles(job, cleaned)
    if missing_sections:
        label = "internal AM brief" if audience == "am" else "client report"
        errors.append(f"visible {label} is missing required sections: {', '.join(missing_sections)}")
    duplicate_headings = duplicate_heading_titles(cleaned)
    if duplicate_headings:
        errors.append(f"visible copy repeats section headings: {', '.join(duplicate_headings[:5])}")
    empty_headings = empty_heading_titles(cleaned)
    if empty_headings:
        errors.append(f"visible copy has empty section headings: {', '.join(empty_headings[:5])}")
    if audience != "am":
        forbidden_terms = visible_client_forbidden_terms(cleaned)
        if forbidden_terms:
            errors.append(f"visible client report leaks internal language: {', '.join(forbidden_terms)}")
        fake_stats = unsupported_exact_stats(cleaned, job)
        if fake_stats:
            errors.append(f"visible client report includes unsupported exact percentages/statistics: {', '.join(fake_stats[:6])}")
        generic_markers = generic_report_markers(cleaned, job)
        if generic_markers:
            errors.append(f"visible client report is too generic: {', '.join(generic_markers)}")
    return errors


def structural_quality_errors(errors: list[str]) -> bool:
    text = " ".join(str(error or "").lower() for error in errors)
    return any(
        marker in text
        for marker in [
            "missing required markdown tables",
            "missing required sections",
            "does not start with dope marketing",
            "prompt echo",
            "model planning",
            "unsupported exact percentages",
            "leaks internal language",
            "empty section headings",
            "repeats section headings",
            "too generic",
        ]
    )


def local_model_attempt_limit(job: dict, errors: list[str], default_attempts: int) -> int:
    if not errors or not structural_quality_errors(errors):
        return default_attempts
    return bounded_int(env("DOPE_REPORT_STRUCTURAL_ATTEMPTS_PER_MODEL"), 3, 1, default_attempts)


def call_local_ollama(job: dict) -> tuple[str, dict]:
    target_minimum = minimum_words(job)
    hard_minimum = hard_minimum_words(job)
    job_id = job.get("id")
    primary_prompt = job.get("generation_prompt") or job.get("report_contract", {}).get("llm_prompt") or job.get("report_contract", {}).get("requested_output") or job.get("title") or ""
    input_text = report_prompt_input(job)
    log(
        "generation_prompt",
        id=job_id,
        provider="ollama/local",
        status=f"context_chars={len(input_text)} prompt={clip(primary_prompt, 260)}",
    )

    last_error = None
    for model in local_model_candidates(job):
        provider = local_runtime_provider(model)
        try:
            report_text = ""
            parsed = {}
            quality_errors = []
            best_under_target = None
            retry_note = job.pop("_alice_retry_note", None)
            attempts = local_attempt_count()
            for attempt in range(1, attempts + 1):
                log("local_request", id=job_id, provider=provider, model=model, status=f"attempt={attempt} target_words={target_minimum} hard_min_words={hard_minimum}")
                parsed = ollama_report_response(
                    model,
                    local_report_prompt(job, retry_note=retry_note),
                )
                report_text = sanitize_visible_report_text(str(parsed.get("response") or ""))
                report_text = sanitize_unsupported_exact_stats(report_text, job)
                document_preview = full_document_text(job, report_text)
                quality_errors = visible_text_quality_errors(document_preview, job)
                words = word_count(report_text)
                if words >= target_minimum and not quality_errors:
                    break
                if words >= hard_minimum and not quality_errors:
                    best_under_target = {
                        "attempt": attempt,
                        "parsed": parsed,
                        "report_text": report_text,
                        "words": words,
                    }
                if attempt == attempts and best_under_target:
                    parsed = best_under_target["parsed"]
                    report_text = best_under_target["report_text"]
                    quality_errors = []
                    log(
                        "local_under_target_accepted",
                        id=job_id,
                        provider=provider,
                        model=parsed.get("model") or model,
                        status=f"attempt={best_under_target['attempt']} words={best_under_target['words']} target_words={target_minimum} hard_min_words={hard_minimum}",
                    )
                    break

                job["_alice_previous_draft"] = report_text
                job["_alice_quality_errors"] = quality_errors
                retry_note = local_retry_note(job, report_text, quality_errors, target_minimum)
                model_attempt_limit = local_model_attempt_limit(job, quality_errors, attempts)
                abandon_model = quality_errors and attempt >= model_attempt_limit
                event = "local_candidate_failed" if abandon_model or attempt >= attempts else "local_retry"
                log(
                    event,
                    id=job_id,
                    provider=provider,
                    model=parsed.get("model") or model,
                    status=f"attempt={attempt} words={words} target_words={target_minimum} hard_min_words={hard_minimum} errors={'; '.join(quality_errors)[:120]}",
                )
                if abandon_model and best_under_target:
                    parsed = best_under_target["parsed"]
                    report_text = best_under_target["report_text"]
                    quality_errors = []
                    log(
                        "local_under_target_accepted",
                        id=job_id,
                        provider=provider,
                        model=parsed.get("model") or model,
                        status=(
                            f"attempt={best_under_target['attempt']} words={best_under_target['words']} "
                            f"target_words={target_minimum} hard_min_words={hard_minimum} "
                            "reason=best_clean_candidate_after_structural_retry"
                        ),
                    )
                    break
                if abandon_model:
                    raise RuntimeError(
                        f"local Ollama structural preflight failed after {attempt} attempts: "
                        f"words={words}, hard_minimum={hard_minimum}, target_words={target_minimum}, errors={'; '.join(quality_errors)}"
                    )

            words = word_count(report_text)
            if words < hard_minimum or quality_errors:
                raise RuntimeError(
                    f"local Ollama preflight failed after {attempts} attempts: "
                    f"words={words}, hard_minimum={hard_minimum}, target_words={target_minimum}, errors={'; '.join(quality_errors) or 'too short'}"
                )

            if not report_text:
                raise RuntimeError("local Ollama returned empty report text")

            final_model = parsed.get("model") or model
            report_text, post_review_meta = run_post_generation_review(job, report_text, final_model)

            log(
                "local_response",
                id=job_id,
                provider=provider,
                model=final_model,
                status=f"words={word_count(report_text)}",
            )
            return report_text, {
                "provider": provider,
                "model": final_model,
                "local_runtime_provider": "ollama/local",
                "local_model_family": local_model_family(final_model),
                "usage": {
                    "prompt_eval_count": parsed.get("prompt_eval_count"),
                    "eval_count": parsed.get("eval_count"),
                    "total_duration": parsed.get("total_duration"),
                    "load_duration": parsed.get("load_duration"),
                },
                "post_review": post_review_meta,
                "reasoning_effort": "local",
            }
        except Exception as error:
            last_error = error
            log("local_candidate_failed", id=job_id, provider=provider, model=model, status=f"{type(error).__name__}: {str(error)[:160]}")
            continue

    raise RuntimeError(f"all local Ollama candidates failed: {last_error}")


def generate_report_text(job: dict) -> tuple[str, dict]:
    if not local_report_required(job):
        log("forcing_local_report", id=job.get("id"), provider="ollama/local", status="DOPE reports are local-only")
    return call_local_ollama(job)

def call_openai(job: dict) -> tuple[str, dict]:
    api_key = env("OPENAI_API_KEY")
    if not api_key:
        raise RuntimeError("OPENAI_API_KEY is required for DOPE market reports")

    minimum = minimum_words(job)
    max_tokens = int(env("DOPE_REPORT_OPENAI_MAX_OUTPUT_TOKENS", "6000"))
    max_tokens = max(2500, min(max_tokens, 12000))

    instructions = report_generation_instructions()

    job_id = job.get("id")
    contract = job.get("report_contract", {}) or {}
    primary_prompt = job.get("generation_prompt") or contract.get("llm_prompt") or contract.get("requested_output") or job.get("title") or ""
    input_text = report_prompt_input(job)
    log(
        "generation_prompt",
        id=job_id,
        provider="openai",
        status=f"context_chars={len(input_text)} prompt={clip(primary_prompt, 260)}",
    )

    last_error = None
    for model in openai_model_candidates():
        for effort in reasoning_effort_candidates():
            try:
                log("openai_request", id=job_id, provider="openai", model=model, status=f"effort={effort} max_tokens={max_tokens}")
                parsed = openai_response(
                    api_key=api_key,
                    model=model,
                    effort=effort,
                    instructions=instructions,
                    input_text=input_text,
                    max_tokens=max_tokens,
                )
                report_text = extract_openai_text(parsed).strip()
                if word_count(report_text) < minimum:
                    log(
                        "openai_retry",
                        id=job_id,
                        provider="openai",
                        model=parsed.get("model") or model,
                        status=f"words={word_count(report_text)} minimum={minimum}",
                    )
                    parsed = openai_response(
                        api_key=api_key,
                        model=model,
                        effort=effort,
                        instructions=instructions,
                        input_text=report_prompt_input(
                            job,
                            retry_note=f"The previous draft was only {word_count(report_text)} words. Rewrite and expand to at least {minimum} words while preserving all required sections.",
                        ),
                        max_tokens=max(max_tokens, 20000),
                    )
                    report_text = extract_openai_text(parsed).strip()

                if not report_text:
                    raise RuntimeError("OpenAI returned empty report text")

                log(
                    "openai_response",
                    id=job_id,
                    provider="openai",
                    model=parsed.get("model") or model,
                    status=f"words={word_count(report_text)} effort={effort}",
                )
                return report_text, {
                    "provider": "openai",
                    "model": parsed.get("model") or model,
                    "usage": parsed.get("usage", {}),
                    "reasoning_effort": effort,
                }
            except OpenAIRequestError as error:
                last_error = error
                log("openai_candidate_failed", model=model, status=f"{error.http_code}: {error.message[:140]}")
                if error.http_code in {401, 403, 429}:
                    raise
                continue

    raise RuntimeError(f"all OpenAI model/effort candidates failed: {last_error}")


class OpenAIRequestError(RuntimeError):
    def __init__(self, http_code: int, message: str) -> None:
        super().__init__(f"OpenAI HTTP {http_code}: {message}")
        self.http_code = http_code
        self.message = message


def openai_response(api_key: str, model: str, effort: str, instructions: str, input_text: str, max_tokens: int) -> dict:
    body = {
        "model": model,
        "instructions": instructions,
        "input": input_text,
        "reasoning": {"effort": effort},
        "text": {"verbosity": "high"},
        "max_output_tokens": max_tokens,
    }
    req = urllib.request.Request(
        "https://api.openai.com/v1/responses",
        data=json.dumps(body).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "User-Agent": "alice-dope-market-report-worker/2.0",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=360) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        raw = error.read().decode(errors="replace")
        try:
            parsed = json.loads(raw)
            message = parsed.get("error", {}).get("message") or raw
        except json.JSONDecodeError:
            message = raw
        raise OpenAIRequestError(error.code, message[:1200]) from error


def extract_openai_text(parsed: dict) -> str:
    texts = []
    if isinstance(parsed.get("output_text"), str):
        texts.append(parsed["output_text"])
    for item in parsed.get("output", []) or []:
        for content in item.get("content", []) or []:
            if isinstance(content, str):
                texts.append(content)
            elif isinstance(content, dict):
                if isinstance(content.get("text"), str):
                    texts.append(content["text"])
                elif isinstance(content.get("text"), dict) and isinstance(content["text"].get("value"), str):
                    texts.append(content["text"]["value"])
    return "\n".join(text.strip() for text in texts if text and text.strip())


def parse_report_json(text: str) -> dict:
    cleaned = text.strip()
    match = re.search(r"```(?:json)?\s*(.*?)```", cleaned, re.S | re.I)
    if match:
        cleaned = match.group(1).strip()
    try:
        return json.loads(cleaned)
    except json.JSONDecodeError:
        return {"executive_summary": cleaned}


def template_report(job: dict) -> dict:
    company = job.get("company", {})
    deal = job.get("deal", {})
    campaign = job.get("campaign_context", {})
    company_name = compact(company.get("name") or deal.get("company_name") or deal.get("name"), "This company")
    crm = compact(company.get("crm_used"), "the current CRM")
    description = compact(campaign.get("deal_description"), "No deal description was provided.")
    return {
        "title": f"{company_name} 90-Day Postcard Campaign Report",
        "subtitle": "Prepared by DOPE Marketing with DOPEIPEDIA market analysis",
        "executive_summary": (
            f"{company_name} is a fit for a disciplined 90-day postcard campaign that connects CRM data, "
            f"print production, and account-manager follow-up. The current brief says: {description} "
            "The recommended approach is to start with narrow, measurable audience segments, ship in waves, "
            "and review response signals before scaling spend."
        ),
        "objectives": [
            "Turn existing CRM and opportunity data into mailed offers that account managers can follow up.",
            "Use postcard waves to revive stale leads, support current promotions, and reach high-fit neighborhoods.",
            "Track every campaign with a simple source code, landing page, phone path, or CRM field.",
        ],
        "campaigns": [
            {
                "name": "Reactivation Wave",
                "audience": "Open, stalled, or previously quoted contacts in the CRM.",
                "goal": "Create a reason for the account manager to re-open the conversation.",
                "filters": f"Use {crm} status, last-contact date, deal stage, geography, and order history.",
                "cadence": "Three postcard touches across 90 days with a call or email follow-up after each drop.",
                "tracking": "Unique QR/URL, campaign code, and CRM note on every response.",
            },
            {
                "name": "Neighborhood Expansion",
                "audience": "Addresses around recent wins, service areas, or high-value target neighborhoods.",
                "goal": "Build local awareness where delivery, service, or sales coverage is already strong.",
                "filters": "Radius targeting, home value or business category filters where available, and suppression of poor-fit records.",
                "cadence": "Two postcard waves, then a final reminder to the strongest segment.",
                "tracking": "Dedicated landing page or phone extension plus source field in CRM.",
            },
            {
                "name": "New Prospect Offer",
                "audience": "Cold but qualified prospects matched to the company profile and offer.",
                "goal": "Test a clear offer before committing to a larger list.",
                "filters": "Industry, location, estimated value, prior engagement, and deliverability quality.",
                "cadence": "Small first drop, evaluate response quality, then expand the best-performing list.",
                "tracking": "Campaign ID printed on each card and matched against CRM-created opportunities.",
            },
        ],
        "budget": {
            "postcard_cost": "$0.89",
            "assumptions": "Budget uses a planning estimate when no live quote is attached.",
            "rows": [
                {"campaign": "Reactivation Wave", "quantity": "1,000", "estimated_cost": "$890", "notes": "Best first test if CRM data is usable."},
                {"campaign": "Neighborhood Expansion", "quantity": "2,500", "estimated_cost": "$2,225", "notes": "Scale after creative and list approval."},
                {"campaign": "New Prospect Offer", "quantity": "5,000", "estimated_cost": "$4,450", "notes": "Use after the first response readout."},
            ],
        },
        "measurement": [
            "Response rate by campaign code, call path, landing page, and CRM source.",
            "Qualified replies, booked conversations, quotes, won revenue, and cost per opportunity.",
            "Account-manager notes after each wave so the campaign improves instead of running blind.",
        ],
        "data_setup": [
            f"Confirm list exports from {crm}, including contact status, owner, geography, and suppression fields.",
            "Approve creative, offer, compliance language, and mail quantity before production.",
            "Keep human review in the workflow; DOPEIPEDIA organizes the draft and the team approves.",
        ],
        "next_steps": [
            "Confirm the campaign objective and primary audience.",
            "Upload or approve the company logo and brand colors.",
            "Export the first list and remove bad-fit records.",
            "Approve postcard creative and schedule the first drop.",
        ],
        "assumptions": [
            "No live postage or print quote was supplied unless shown in the deal package.",
            "Recommendations should be reviewed by the DOPE account manager before being sent to the customer.",
        ],
    }


def normalize_report(report: dict, job: dict) -> dict:
    base = template_report(job)
    merged = {**base, **{key: value for key, value in report.items() if value not in (None, "", [])}}
    merged["objectives"] = ensure_list(merged.get("objectives"), base["objectives"])
    merged["campaigns"] = ensure_campaigns(merged.get("campaigns"), base["campaigns"])
    merged["measurement"] = ensure_list(merged.get("measurement"), base["measurement"])
    merged["data_setup"] = ensure_list(merged.get("data_setup"), base["data_setup"])
    merged["next_steps"] = ensure_list(merged.get("next_steps"), base["next_steps"])
    merged["assumptions"] = ensure_list(merged.get("assumptions"), base["assumptions"])
    if not isinstance(merged.get("budget"), dict):
        merged["budget"] = base["budget"]
    merged["budget"]["rows"] = ensure_list(merged["budget"].get("rows"), base["budget"]["rows"])
    return merged


def ensure_list(value, fallback):
    if isinstance(value, list) and value:
        return value
    if isinstance(value, str) and value.strip():
        return [value.strip()]
    return fallback


def ensure_campaigns(value, fallback):
    if isinstance(value, list) and value:
        campaigns = []
        for item in value[:5]:
            if isinstance(item, dict):
                campaigns.append({**fallback[min(len(campaigns), len(fallback) - 1)], **item})
            else:
                campaigns.append({**fallback[min(len(campaigns), len(fallback) - 1)], "name": str(item)})
        return campaigns
    return fallback


def paragraph(
    text: str,
    style: str | None = None,
    bold: bool = False,
    italic: bool = False,
    color: str | None = None,
    size: int | None = None,
    shading: str | None = None,
    keep_next: bool = False,
) -> str:
    text = str(text or "").strip()
    if not text:
        return ""
    ppr_bits = []
    if style:
        ppr_bits.append(f"<w:pStyle w:val=\"{style}\"/>")
    if style == "Heading1":
        ppr_bits.append(f"<w:pBdr><w:bottom w:val=\"single\" w:sz=\"8\" w:space=\"6\" w:color=\"{BRAND_RED}\"/></w:pBdr>")
    if keep_next:
        ppr_bits.append("<w:keepNext/>")
    if shading:
        ppr_bits.append(f"<w:shd w:fill=\"{shading}\"/>")
    ppr_bits.append("<w:spacing w:before=\"80\" w:after=\"120\" w:line=\"276\" w:lineRule=\"auto\"/>")
    ppr = f"<w:pPr>{''.join(ppr_bits)}</w:pPr>"
    return f"<w:p>{ppr}{formatted_runs(text, bold=bold, italic=italic, color=color, size=size)}</w:p>"


def run_properties(bold: bool = False, italic: bool = False, color: str | None = None, size: int | None = None) -> str:
    rpr_bits = []
    if bold:
        rpr_bits.append("<w:b/>")
    if italic:
        rpr_bits.append("<w:i/>")
    if color:
        rpr_bits.append(f"<w:color w:val=\"{color}\"/>")
    if size:
        rpr_bits.append(f"<w:sz w:val=\"{size}\"/>")
    return f"<w:rPr>{''.join(rpr_bits)}</w:rPr>" if rpr_bits else ""


def formatted_runs(text: str, bold: bool = False, italic: bool = False, color: str | None = None, size: int | None = None) -> str:
    parts = re.split(r"(\*\*[^*]+\*\*|__[^_]+__|\*[^*]+\*)", str(text or ""))
    runs = []
    for part in parts:
        if not part:
            continue
        part_bold = bold
        part_italic = italic
        value = part
        if (part.startswith("**") and part.endswith("**")) or (part.startswith("__") and part.endswith("__")):
            part_bold = True
            value = part[2:-2]
        elif part.startswith("*") and part.endswith("*"):
            part_italic = True
            value = part[1:-1]
        if not value:
            continue
        rpr = run_properties(bold=part_bold, italic=part_italic, color=color, size=size)
        runs.append(f"<w:r>{rpr}<w:t xml:space=\"preserve\">{safe_text(value)}</w:t></w:r>")
    return "".join(runs)


def bullet(text: str) -> str:
    text = str(text or "").strip()
    if not text:
        return ""
    return (
        "<w:p><w:pPr><w:pStyle w:val=\"ListParagraph\"/>"
        "<w:numPr><w:ilvl w:val=\"0\"/><w:numId w:val=\"1\"/></w:numPr>"
        "<w:spacing w:before=\"40\" w:after=\"80\" w:line=\"276\" w:lineRule=\"auto\"/>"
        f"</w:pPr>{formatted_runs(text)}</w:p>"
    )


def callout(text: str) -> str:
    return paragraph(text, style="Callout", color=INK, shading=SOFT_RED)


def page_break() -> str:
    return "<w:p><w:r><w:br w:type=\"page\"/></w:r></w:p>"


def cell_paragraph(text: str, header: bool = False) -> str:
    text = str(text or "").strip() or " "
    color = "FFFFFF" if header else INK
    return (
        "<w:p><w:pPr><w:spacing w:before=\"20\" w:after=\"60\" w:line=\"240\" w:lineRule=\"auto\"/></w:pPr>"
        f"{formatted_runs(text, bold=header, color=color)}</w:p>"
    )


def table(rows: list[list[str]]) -> str:
    clean_rows = []
    for row in rows:
        clean = [str(cell or "").strip() for cell in row]
        if any(clean):
            clean_rows.append(clean)
    if len(clean_rows) < 2:
        return ""

    column_count = max(len(row) for row in clean_rows)
    table_width = 9360
    widths = [table_width // column_count] * column_count
    widths[-1] += table_width - sum(widths)
    grid = "".join(f"<w:gridCol w:w=\"{width}\"/>" for width in widths)

    rendered_rows = []
    for row_index, row in enumerate(clean_rows):
        cells = []
        for index in range(column_count):
            value = row[index] if index < len(row) else ""
            header = row_index == 0
            shade = f"<w:shd w:fill=\"{BRAND_RED}\"/>" if header else ("<w:shd w:fill=\"F7F7F8\"/>" if row_index % 2 == 0 else "")
            cells.append(
                "<w:tc><w:tcPr>"
                f"<w:tcW w:w=\"{widths[index]}\" w:type=\"dxa\"/>"
                "<w:tcMar><w:top w:w=\"120\" w:type=\"dxa\"/><w:left w:w=\"120\" w:type=\"dxa\"/><w:bottom w:w=\"120\" w:type=\"dxa\"/><w:right w:w=\"120\" w:type=\"dxa\"/></w:tcMar>"
                f"{shade}</w:tcPr>{cell_paragraph(value, header=header)}</w:tc>"
            )
        rendered_rows.append("<w:tr>" + "".join(cells) + "</w:tr>")
    return (
        "<w:tbl><w:tblPr><w:tblStyle w:val=\"TableGrid\"/>"
        f"<w:tblW w:w=\"{table_width}\" w:type=\"dxa\"/><w:tblInd w:w=\"0\" w:type=\"dxa\"/>"
        "<w:tblCellMar><w:top w:w=\"120\" w:type=\"dxa\"/><w:left w:w=\"120\" w:type=\"dxa\"/><w:bottom w:w=\"120\" w:type=\"dxa\"/><w:right w:w=\"120\" w:type=\"dxa\"/></w:tblCellMar></w:tblPr>"
        f"<w:tblGrid>{grid}</w:tblGrid>"
        + "".join(rendered_rows)
        + "</w:tbl>"
    )


def image_run(width_px: int, height_px: int, rel_id: str = "rIdLogo", name: str = "Company logo", max_width: int = 3_900_000) -> str:
    emu_per_px = 9525
    cx = min(width_px * emu_per_px, max_width)
    ratio = height_px / max(width_px, 1)
    cy = int(cx * ratio)
    rel = safe_attr(rel_id)
    image_name = safe_attr(name or "Report image")
    return f"""
<w:p><w:r><w:drawing>
<wp:inline distT="0" distB="0" distL="0" distR="0">
<wp:extent cx="{cx}" cy="{cy}"/>
<wp:docPr id="1" name="{image_name}"/>
<a:graphic>
<a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture">
<pic:pic>
<pic:nvPicPr><pic:cNvPr id="0" name="{image_name}"/><pic:cNvPicPr/></pic:nvPicPr>
<pic:blipFill><a:blip r:embed="{rel}"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill>
<pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="{cx}" cy="{cy}"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr>
</pic:pic>
</a:graphicData>
</a:graphic>
</wp:inline>
</w:drawing></w:r></w:p>
"""


def build_document_xml(job: dict, report: dict, logo: tuple[bytes, str] | None) -> str:
    deal = job.get("deal", {})
    company = job.get("company", {})
    commerce = job.get("commerce", {})
    campaign_context = job.get("campaign_context", {})
    body = []

    body.append(paragraph("DOPE MARKETING", bold=True, color="D71920", size=24))
    if logo:
        width, height = image_size(logo[0])
        body.append(image_run(width, height))
    body.append(paragraph(report["title"], style="Title"))
    body.append(paragraph(report.get("subtitle", "90-Day Postcard Campaign Strategy"), color="555555", size=24))
    body.append(paragraph(f"Prepared: {dt.date.today().strftime('%B %-d, %Y')}", color="555555"))
    body.append(paragraph(f"Deal stage: {compact(deal.get('stage'))} | Amount: {compact(deal.get('amount'))} | Close date: {compact(deal.get('close_date'))}", color="555555"))
    body.append(page_break())

    body.append(paragraph("Executive Summary", style="Heading1"))
    body.append(paragraph(report["executive_summary"]))
    body.append(paragraph("Primary Objectives", style="Heading2"))
    for item in report["objectives"]:
        body.append(bullet(item))

    body.append(paragraph("Deal Context", style="Heading2"))
    body.append(table([
        ["Company", compact(company.get("name") or deal.get("company_name"))],
        ["Website", compact(company.get("website_url"))],
        ["Industry", compact(company.get("industry"))],
        ["CRM", compact(company.get("crm_used"))],
        ["Deal description", compact(campaign_context.get("deal_description"))],
        ["Quote link", compact(commerce.get("quote_purchase_link"))],
    ]))
    body.append(page_break())

    body.append(paragraph("90-Day Campaign Plan", style="Heading1"))
    for campaign in report["campaigns"]:
        body.append(paragraph(compact(campaign.get("name")), style="Heading2", color="D71920"))
        body.append(table([
            ["Audience", compact(campaign.get("audience"))],
            ["Goal", compact(campaign.get("goal"))],
            ["Filters", compact(campaign.get("filters"))],
            ["Cadence", compact(campaign.get("cadence"))],
            ["Tracking", compact(campaign.get("tracking"))],
        ]))
        body.append(paragraph(""))
    body.append(page_break())

    budget = report.get("budget", {})
    body.append(paragraph("Budget Planning", style="Heading1"))
    body.append(paragraph(f"Planning postcard cost: {compact(budget.get('postcard_cost'), '$0.89')}"))
    body.append(paragraph(compact(budget.get("assumptions"), "Final pricing should be confirmed before production.")))
    rows = [["Campaign", "Quantity", "Estimated cost", "Notes"]]
    for row in budget.get("rows", []):
        if isinstance(row, dict):
            rows.append([
                compact(row.get("campaign")),
                compact(row.get("quantity")),
                compact(row.get("estimated_cost")),
                compact(row.get("notes")),
            ])
        else:
            rows.append([str(row), "", "", ""])
    body.append(table(rows))

    body.append(paragraph("Measurement & Reporting", style="Heading1"))
    for item in report["measurement"]:
        body.append(bullet(item))
    body.append(paragraph("Data & Setup", style="Heading1"))
    for item in report["data_setup"]:
        body.append(bullet(item))
    body.append(paragraph("Next Steps", style="Heading1"))
    for item in report["next_steps"]:
        body.append(bullet(item))
    body.append(paragraph("Assumptions", style="Heading2"))
    for item in report["assumptions"]:
        body.append(bullet(item))

    section = """
<w:sectPr>
<w:pgSz w:w="12240" w:h="15840"/>
<w:pgMar w:top="900" w:right="900" w:bottom="900" w:left="900" w:header="450" w:footer="450" w:gutter="0"/>
</w:sectPr>
"""
    return f"""<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<w:document
xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:o="urn:schemas-microsoft-com:office:office"
xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"
xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math"
xmlns:v="urn:schemas-microsoft-com:vml"
xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing"
xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing"
xmlns:w10="urn:schemas-microsoft-com:office:word"
xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"
xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml"
xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup"
xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk"
xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml"
xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape"
xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"
xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"
mc:Ignorable="w14 wp14">
<w:body>{''.join(body)}{section}</w:body>
</w:document>"""


def styles_xml() -> str:
    return f"""<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<w:styles xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
<w:style w:type="paragraph" w:default="1" w:styleId="Normal"><w:name w:val="Normal"/><w:pPr><w:spacing w:after="120" w:line="276" w:lineRule="auto"/></w:pPr><w:rPr><w:rFonts w:ascii="Aptos" w:hAnsi="Aptos" w:cs="Aptos"/><w:color w:val="{INK}"/><w:sz w:val="21"/></w:rPr></w:style>

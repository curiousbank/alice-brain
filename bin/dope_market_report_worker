#!/usr/bin/env python3
"""Alice-side DOPE market report worker.

Polls SUN/DOPE for queued market-report artifacts, generates a DOCX locally,
and posts the finished file back to SUN for storage/publishing.
"""

from __future__ import annotations

import argparse
import base64
import csv
import datetime as dt

            "stat_3_label": "Approval",
            "stat_3_value": "AM + customer + production",
            "body": "Build an 8.5x11 stylized report/postcard page in Canva first, then adapt the approved direction into postcard sizes.",
            "cta": "Export PNG/JPG proof for approval and print PDF with bleed after final signoff.",
            "source_note": "Human review required before sending proofs or production files.",
        },
    ]


def canva_csv_text(rows: list[dict]) -> str:
    columns = [
        "page",
        "headline",
        "subhead",
        "stat_1_label",
        "stat_1_value",
        "stat_2_label",
        "stat_2_value",
        "stat_3_label",
        "stat_3_value",
        "body",
        "cta",
        "source_note",
    ]
    handle = io.StringIO()
    writer = csv.DictWriter(handle, fieldnames=columns)
    writer.writeheader()
    for row in rows:
        writer.writerow({column: row.get(column, "") for column in columns})
    return handle.getvalue()


def canva_design_handoff_text(job: dict, report_text: str) -> str:
    media = job.get("assets", {}).get("uploaded_media", []) or []
    embedded_media = job.get("_alice_media_observations", []) or []
    app_path = canva_app_path()
    rows = canva_rows(job, report_text)
    lines = [
        "## Canva Data Postcard Handoff",
        "",
        "Purpose: turn this strategy into a stylized 8.5x11 data postcard/report page that informs and engages the client. DOPEIPEDIA creates the copy/data packet; a human designer finishes the Canva design and approves exports.",
        "",
        "### Canva Workflow",
        f"- Canva Desktop status: {'available at ' + app_path if app_path else 'not detected on this machine'}",
        "- Start with an 8.5x11 US Letter design in Canva, portrait or landscape depending on the story.",
        "- Treat each row of the CSV packet as one Canva page/card: Strategy Snapshot, 90-Day Campaign Map, and Creative Proof Card.",
        "- Use Canva Bulk Create or manual paste into a locked DOPE template with fields for headline, stats, body, CTA, and source note.",
        "- Keep it human-reviewed: AM approval, customer approval, designer preflight, and production approval before print/mail.",
        "",
        "### Canva Page Data",
        "| Page | Headline | Main CTA |",
        "| --- | --- | --- |",
    ]
    for row in rows:
        lines.append(f"| {row['page']} | {row['headline']} | {row['cta']} |")

    lines.extend(
        [
            "",
            "### Visual Direction",
            "- Format: 8.5x11 data postcard/report page, designed for PDF proofing and client-facing review.",
            "- Hierarchy: one strong headline, three stat blocks, one campaign map, one CTA, and one source note.",
            "- Style: confident printshop/marketing operations, practical and polished. Avoid generic AI graphics.",
            "- Use client logo/media when supplied. If media is missing, leave a clean logo slot and label it for collection.",
            "- Preserve human approval checkpoints before any proof is sent or any production file is exported.",
            "",
            "### Asset Notes",
        ]
    )
    if media:
        for item in media:
            lines.append(f"- {item.get('filename')} ({item.get('content_type')}, role={item.get('role')}) endpoint: {item.get('endpoint')}")
    else:
        lines.append("- No uploaded media was included in the worker package.")
    if embedded_media:
        lines.extend(["", "### Embedded Images"])
        for item in embedded_media:
            summary = f" // vision: {item.get('vision_summary')}" if item.get("vision_summary") else ""
            lines.append(f"- {item.get('filename')} ({item.get('role')}, {item.get('dimensions')}){summary}")
    return "\n".join(lines).strip()


def full_document_text(job: dict, report_text: str) -> str:
    return client_visible_document_text(job, sanitize_visible_report_text(report_text))


def write_canva_packet(job: dict, report_text: str, docx_path: Path) -> dict:
    rows = canva_rows(job, report_text)
    brief_path = docx_path.with_suffix(".canva-brief.md")
    csv_path = docx_path.with_suffix(".canva-copy.csv")
    brief_path.write_text(canva_design_handoff_text(job, report_text) + "\n", encoding="utf-8")
    csv_path.write_text(canva_csv_text(rows), encoding="utf-8")
    app_path = canva_app_path()
    return {
        "enabled": True,
        "mode": "human_reviewed_canva_handoff",
        "app_detected": bool(app_path),
        "app_path": app_path,
        "brief_path": str(brief_path),
        "csv_path": str(csv_path),
        "format": "8.5x11 data postcard",
        "page_count": len(rows),
        "automation_boundary": "DOPEIPEDIA writes copy/data. Canva design/export stays human-reviewed unless an explicit Canva API integration is approved.",
        "approval_gates": ["account_manager", "customer", "designer_preflight", "production"],
    }


def markdown_table(lines: list[str]) -> list[list[str]]:
    rows = []
    for line in lines:
        stripped = line.strip()
        if re.match(r"^\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?$", stripped):
            continue
        cells = [cell.strip() for cell in stripped.strip("|").split("|")]
        if len(cells) > 1:
            rows.append(cells)
    return rows


REPORT_IMAGE_SECTION_ANCHORS = [
    "market snapshot",
    "recommended campaign",
    "channel strategy",
    "neighborhood targeting",
    "offer strategy",
    "timeline / launch plan",
    "final recommendation",
]


def normalized_section_anchor(value: str) -> str:
    return re.sub(r"\s+", " ", str(value or "").strip().rstrip(":").lower())


def report_image_block(image: dict, index: int) -> str:
    return image_run(
        image["width"],
        image["height"],
        rel_id=f"rIdImage{index}",
        name=f"Report visual {index}",
        max_width=2_800_000,
    )


def markdown_to_word_body(text: str, logo: tuple[bytes, str] | None, report_images: list[dict] | None = None) -> str:
    body = [
        paragraph("DOPE MARKETING", style="Kicker", keep_next=True),
        paragraph("Client Strategy Proposal", style="Subtitle", keep_next=True),
    ]
    if logo:
        width, height = image_size(logo[0])
        body.append(image_run(width, height, rel_id="rIdLogo", name="Company logo"))

    gallery = report_images or []
    image_queue = list(enumerate(gallery, 1))

    def append_section_image(heading: str) -> None:
        anchor = normalized_section_anchor(heading)
        if image_queue and any(anchor == target or anchor.startswith(f"{target} ") for target in REPORT_IMAGE_SECTION_ANCHORS):
            index, image = image_queue.pop(0)
            body.append(report_image_block(image, index))

    lines = text.splitlines()
    table_lines = []
    for raw_line in lines:
        line = raw_line.rstrip()
        if "|" in line and line.strip().startswith("|"):
            table_lines.append(line)
            continue
        if table_lines:
            rows = markdown_table(table_lines)
            if rows:
                body.append(table(rows))
            table_lines = []

        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith("### "):
            heading = stripped[4:].strip()
            body.append(paragraph(heading, style="Heading2", keep_next=True))
            append_section_image(heading)
        elif stripped.startswith("## "):
            heading = stripped[3:].strip()
            body.append(paragraph(heading, style="Heading1", keep_next=True))
            append_section_image(heading)
        elif stripped.startswith("# "):
            heading = stripped[2:].strip()
            body.append(paragraph(heading, style="Title", keep_next=True))
            append_section_image(heading)
        elif re.match(r"^(prepared for|prepared by|date|investment|total|timeline)\s*:", stripped, re.I):
            body.append(paragraph(stripped, style="Subtitle"))
        elif stripped.startswith(">"):
            body.append(callout(stripped.lstrip(">").strip()))
        elif stripped.startswith(("- ", "* ")):
            body.append(bullet(stripped[2:].strip()))
        elif re.match(r"^\d+\.\s+", stripped):
            body.append(bullet(re.sub(r"^\d+\.\s+", "", stripped).strip()))
        elif re.match(r"^[A-Z][A-Za-z0-9 &/().,'-]{8,80}:$", stripped):
            heading = stripped.rstrip(":")
            body.append(paragraph(heading, style="Heading2", keep_next=True))
            append_section_image(heading)
        else:
            body.append(paragraph(stripped))

    if table_lines:
        rows = markdown_table(table_lines)
        if rows:
            body.append(table(rows))

    while image_queue:
        index, image = image_queue.pop(0)
        body.append(report_image_block(image, index))

    section = """
<w:sectPr>
<w:headerReference w:type="default" r:id="rIdHeader"/>
<w:footerReference w:type="default" r:id="rIdFooter"/>
<w:pgSz w:w="12240" w:h="15840"/>
<w:pgMar w:top="840" w:right="840" w:bottom="840" w:left="840" w:header="420" w:footer="420" w:gutter="0"/>
</w:sectPr>
"""
    return "".join(part for part in body if part) + section


def document_image_relationships(logo: tuple | None, report_images: list[dict] | None = None) -> str:
    rels = []
    if logo:
        rels.append(
            '<Relationship Id="rIdLogo" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/logo.{ext}"/>'.format(
                ext=logo[1]
            )
        )
    for index, image in enumerate(report_images or [], 1):
        rels.append(
            '<Relationship Id="rIdImage{index}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/report_image_{index}.{ext}"/>'.format(
                index=index,
                ext=image["ext"],
            )
        )
    return "\n".join(rels)


def create_report_docx(job: dict, document_text: str, logo: tuple[bytes, str] | None, path: Path, report_images: list[dict] | None = None) -> None:
    rels = """<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/>
</Relationships>"""
    document_rels = """<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
<Relationship Id="rIdHeader" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/header" Target="header1.xml"/>
<Relationship Id="rIdFooter" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/footer" Target="footer1.xml"/>
<Relationship Id="rIdNumbering" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/numbering" Target="numbering.xml"/>
{image_rel}
</Relationships>""".format(
        image_rel=document_image_relationships(logo, report_images)
    )
    content_types = """<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>
<Default Extension="xml" ContentType="application/xml"/>
<Default Extension="png" ContentType="image/png"/>
<Default Extension="jpg" ContentType="image/jpeg"/>
<Default Extension="jpeg" ContentType="image/jpeg"/>
<Default Extension="gif" ContentType="image/gif"/>
<Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>
<Override PartName="/word/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml"/>
<Override PartName="/word/numbering.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.numbering+xml"/>
<Override PartName="/word/header1.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.header+xml"/>
<Override PartName="/word/footer1.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.footer+xml"/>
</Types>"""
    document_xml = f"""<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<w:document
xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"
xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing"
xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"
xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"
xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture">
<w:body>{markdown_to_word_body(document_text, logo, report_images)}</w:body>
</w:document>"""
    with zipfile.ZipFile(path, "w", zipfile.ZIP_STORED) as docx:
        docx.writestr("[Content_Types].xml", content_types)
        docx.writestr("_rels/.rels", rels)
        docx.writestr("word/document.xml", document_xml)
        docx.writestr("word/styles.xml", styles_xml())
        docx.writestr("word/numbering.xml", numbering_xml())
        docx.writestr("word/header1.xml", header_xml(job))
        docx.writestr("word/footer1.xml", footer_xml())
        docx.writestr("word/_rels/document.xml.rels", document_rels)
        if logo:
            docx.writestr(f"word/media/logo.{logo[1]}", logo[0])
        for index, image in enumerate(report_images or [], 1):
            docx.writestr(f"word/media/report_image_{index}.{image['ext']}", image["bytes"])


def validate_report_file(job: dict, docx_path: Path, document_text: str) -> list[str]:
    errors = []
    payload = docx_path.read_bytes() if docx_path.exists() else b""
    if payload[:2] != b"PK":
        errors.append("generated file does not start with PK DOCX zip signature")
    byte_size = len(payload)
    min_bytes = minimum_docx_bytes(job)
    if byte_size < min_bytes:
        errors.append(f"generated DOCX is too small ({byte_size} bytes; minimum {min_bytes})")
    words = word_count(document_text)
    hard_min_words = hard_minimum_words(job)
    if words < hard_min_words:
        errors.append(f"generated report is too short ({words} words; hard minimum {hard_min_words})")
    errors.extend(visible_text_quality_errors(document_text, job))
    return errors


def executable_path(name: str, candidates: list[str] | None = None) -> str | None:
    path = shutil.which(name)
    if path:
        return path
    for candidate in candidates or []:
        if candidate and Path(candidate).exists():
            return candidate
    return None


def render_report_pages(docx_path: Path) -> dict:
    output_dir = docx_path.with_suffix(".pages")
    output_dir.mkdir(parents=True, exist_ok=True)
    for old_file in list(output_dir.glob("*")):
        if old_file.is_file():
            old_file.unlink()

    soffice = executable_path(
        "soffice",
        [
            "/opt/homebrew/bin/soffice",
            "/usr/local/bin/soffice",
            "/Applications/LibreOffice.app/Contents/MacOS/soffice",
        ],
    )
    pdftoppm = executable_path("pdftoppm", ["/opt/homebrew/bin/pdftoppm", "/usr/local/bin/pdftoppm"])
    if not soffice:
        raise RuntimeError("LibreOffice soffice not found")
    if not pdftoppm:
        raise RuntimeError("Poppler pdftoppm not found")

    timeout = bounded_int(env("DOPE_REPORT_RENDER_TIMEOUT"), 180, 30, 900)
    subprocess.run(
        [soffice, "--headless", "--convert-to", "pdf", "--outdir", str(output_dir), str(docx_path)],
        check=True,
        timeout=timeout,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    pdf_candidates = sorted(output_dir.glob("*.pdf"), key=lambda item: item.stat().st_mtime, reverse=True)
    if not pdf_candidates:
        raise RuntimeError("LibreOffice did not create a PDF")
    pdf_path = pdf_candidates[0]
    prefix = output_dir / "page"
    subprocess.run(
        [pdftoppm, "-png", "-r", str(bounded_int(env("DOPE_REPORT_RENDER_DPI"), 120, 72, 180)), str(pdf_path), str(prefix)],
        check=True,
        timeout=timeout,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    page_limit = bounded_int(env("DOPE_REPORT_PAGE_QA_LIMIT"), 6, 1, 10)
    page_paths = sorted(output_dir.glob("page-*.png"))[:page_limit]
    if not page_paths:
        raise RuntimeError("Poppler did not render any page PNGs")
    return {
        "output_dir": str(output_dir),
        "pdf_path": str(pdf_path),
        "page_count": len(sorted(output_dir.glob("page-*.png"))),
        "scanned_page_count": len(page_paths),
        "page_paths": [str(path) for path in page_paths],
    }


def page_visual_qa_prompt(job: dict, document_text: str, render_meta: dict) -> str:
    company = compact(job.get("company", {}).get("name") or job.get("deal", {}).get("company_name"), "client")
    audience = str(job.get("metadata", {}).get("report_audience") or job.get("report_contract", {}).get("audience") or "client")
    return (
        "You are the final visual QA inspector for a DOPE Marketing report rendered from DOCX pages.\n"
        "Inspect the attached rendered page images only. Judge the visible finished report, not hidden metadata.\n"
        "Return strict JSON only with this shape: "
        '{"pass":true,"score":90,"notes":["..."],"errors":[],"repair_instructions":"..."}.\n\n'
        "Fail if any page is blank, visually broken, too crowded to read, has overlapping/cropped content, has unreadable tables, "
        "shows filenames/endpoints/local paths, repeats the DOPE MARKETING header awkwardly, exposes AI/process notes, or does not feel client-facing.\n"
        "Prefer practical design criticism: hierarchy, spacing, image placement, table readability, and whether it feels like a polished proposal.\n"
        "Do not invent business facts. Do not ask for revisions unless the page visuals actually need them.\n\n"
        f"CLIENT: {company}\n"
        f"AUDIENCE: {audience}\n"
        f"RENDERED PAGES: {render_meta.get('scanned_page_count')} of {render_meta.get('page_count')}\n"
        f"VISIBLE TEXT SAMPLE:\n{clip(document_text, 1800)}"
    )


def parse_visual_qa_json(raw_text: str) -> dict:
    text = (raw_text or "").strip()
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        match = re.search(r"\{.*\}", text, flags=re.S)
        if match:
            try:
                return json.loads(match.group(0))
            except json.JSONDecodeError:
                pass
    return {
        "pass": True,
        "score": None,
        "notes": [clip(text, 500)] if text else ["visual QA returned no parseable JSON"],
        "errors": [],
        "parse_warning": "visual QA response was not strict JSON",
    }


def run_page_visual_qa(job: dict, docx_path: Path, document_text: str) -> dict:
    if not report_page_visual_qa_enabled(job):
        return {"enabled": False}

    job_id = job.get("id")
    model = report_page_visual_qa_model(job)
    provider = local_runtime_provider(model)
    try:
        render_meta = render_report_pages(docx_path)
    except Exception as error:
        message = f"{type(error).__name__}: {str(error)[:180]}"
        log("page_visual_qa_render_error", id=job_id, provider=provider, model=model, status=message)
        return {
            "enabled": True,
            "accepted": False,
            "provider": provider,
            "model": model,
            "errors": [f"page visual QA render failed: {message}"],
            "warnings": [],
        }

    page_paths = [Path(path) for path in render_meta.get("page_paths", [])]
    base_url = str(env("OLLAMA_URL", "http://127.0.0.1:11434") or "http://127.0.0.1:11434").rstrip("/")
    prompt = page_visual_qa_prompt(job, document_text, render_meta)
    body = {
        "model": model,
        "prompt": prompt,
        "images": [base64.b64encode(path.read_bytes()).decode("ascii") for path in page_paths],
        "stream": False,
        "format": "json",
        "options": {
            "temperature": 0.15,
            "num_predict": 700,
        },
    }
    req = urllib.request.Request(
        f"{base_url}/api/generate",
        data=json.dumps(body).encode("utf-8"),
        headers={"Content-Type": "application/json", "User-Agent": "alice-dope-market-report-worker/page-visual-qa"},
        method="POST",
    )
    log("page_visual_qa_start", id=job_id, provider=provider, model=model, status=f"pages={len(page_paths)}")
    try:
        with urllib.request.urlopen(req, timeout=bounded_int(env("DOPE_REPORT_PAGE_QA_TIMEOUT"), 240, 60, 900)) as response:
            parsed = json.loads(response.read().decode("utf-8"))
        response_text = ollama_visible_text(parsed)
        qa = parse_visual_qa_json(response_text)
        score = qa.get("score")
        try:
            score_value = int(score) if score is not None else None
        except (TypeError, ValueError):
            score_value = None
        min_score = bounded_int(env("DOPE_REPORT_PAGE_QA_MIN_SCORE"), 72, 0, 100)
        errors = [str(item) for item in array_like(qa.get("errors")) if str(item).strip()]
        warnings = [str(item) for item in array_like(qa.get("notes")) if str(item).strip()]
        passed = qa.get("pass") is not False and not errors
        if score_value is not None and score_value < min_score:
            errors.append(f"page visual QA score too low: {score_value} < {min_score}")
            passed = False
        if qa.get("parse_warning"):
            warnings.append(str(qa["parse_warning"]))
        if passed:
            log("page_visual_qa_passed", id=job_id, provider=provider, model=parsed.get("model") or model, status=f"score={score_value}")
        else:
            log("page_visual_qa_failed", id=job_id, provider=provider, model=parsed.get("model") or model, status="; ".join(errors)[:160])
        return {
            "enabled": True,
            "accepted": passed,
            "provider": provider,
            "model": parsed.get("model") or model,
            "score": score_value,
            "minimum_score": min_score,
            "errors": errors,
            "warnings": warnings[:8],
            "repair_instructions": clip(str(qa.get("repair_instructions") or ""), 700),
            "render": render_meta,
            "usage": {
                "prompt_eval_count": parsed.get("prompt_eval_count"),
                "eval_count": parsed.get("eval_count"),
                "total_duration": parsed.get("total_duration"),
            },
        }
    except Exception as error:
        message = f"{type(error).__name__}: {str(error)[:180]}"
        log("page_visual_qa_error", id=job_id, provider=provider, model=model, status=message)
        return {
            "enabled": True,
            "accepted": False,
            "provider": provider,
            "model": model,
            "render": render_meta,
            "errors": [f"page visual QA failed: {message}"],
            "warnings": [],
        }


def array_like(value) -> list:
    if value is None:
        return []
    if isinstance(value, list):
        return value
    return [value]


def write_local_report_record(job: dict, docx_path: Path, manifest: dict, complete_result: dict | None = None) -> None:
    complete_result = complete_result or {}
    record = {
        "artifact_id": manifest.get("source_artifact_id") or job.get("id"),
        "deal_id": manifest.get("source_deal_id") or job.get("deal", {}).get("id"),
        "title": manifest.get("report_title") or job.get("title"),
        "status": complete_result.get("status") or "local",
        "local_path": str(docx_path),
        "file_url": complete_result.get("file_url"),
        "storage_key": complete_result.get("storage_key"),
        "byte_size": manifest.get("byte_size"),
        "maza_address": manifest.get("maza_address"),
        "bake": manifest.get("bake"),
        "model": manifest.get("model"),
        "provider": manifest.get("provider"),
        "embedder_model": manifest.get("embedder_model"),
        "embedding_provider": manifest.get("embedding_provider"),
        "embedder_model_fallback": manifest.get("embedder_model_fallback"),
        "generated_at": manifest.get("generated_at"),
        "completed_at": now_iso(),
        "logo_embedded": manifest.get("logo_embedded"),
        "logo_reason": manifest.get("logo_reason"),
        "canva": manifest.get("canva"),
        "quality": {
            "errors": manifest.get("quality_errors", []),
            "warnings": manifest.get("quality_warnings", []),
            "docx_signature": manifest.get("docx_signature"),
            "minimum_docx_bytes": manifest.get("minimum_docx_bytes"),
            "word_count": manifest.get("word_count"),
        },
    }
    manifest_path = docx_path.with_suffix(".manifest.json")
    manifest_payload = {**manifest, "complete_result": complete_result, "viewer_record": record}
    manifest_path.write_text(json.dumps(manifest_payload, indent=2, ensure_ascii=True), encoding="utf-8")
    REPORT_INDEX_PATH.parent.mkdir(parents=True, exist_ok=True)
    with REPORT_INDEX_PATH.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, ensure_ascii=True) + "\n")


def local_report_records(limit: int = 25) -> list[dict]:
    records = []
    if REPORT_INDEX_PATH.exists():
        for line in REPORT_INDEX_PATH.read_text(errors="ignore").splitlines():
            try:
                records.append(json.loads(line))
            except json.JSONDecodeError:
                continue

    seen = {str(record.get("local_path")) for record in records if record.get("local_path")}
    for manifest_path in REPORT_DIR.glob("*.manifest.json"):
        try:
            payload = json.loads(manifest_path.read_text(errors="ignore"))
        except json.JSONDecodeError:
            continue
        record = payload.get("viewer_record") or payload
        if record.get("local_path") and str(record["local_path"]) in seen:
            continue
        records.append(record)

    records.sort(key=lambda item: str(item.get("completed_at") or item.get("generated_at") or ""), reverse=True)
    return records[:limit]


def report_record_key(record: dict) -> str:
    for key in ["artifact_id", "local_path", "storage_key", "file_url", "title"]:
        value = record.get(key)
        if value not in (None, ""):
            return f"{key}:{value}"
    return json.dumps(record, sort_keys=True, ensure_ascii=True)


def sync_local_report_records(records: list[dict]) -> None:
    if not records:
        return

    merged = {}
    for record in local_report_records(limit=5000):
        if isinstance(record, dict):
            merged[report_record_key(record)] = record
    for record in records:
        if isinstance(record, dict):
            key = report_record_key(record)
            merged[key] = {**merged.get(key, {}), **record}

    sorted_records = sorted(
        merged.values(),
        key=lambda item: str(item.get("completed_at") or item.get("generated_at") or item.get("source", {}).get("created_at") or ""),
        reverse=True,
    )
    REPORT_INDEX_PATH.parent.mkdir(parents=True, exist_ok=True)
    with REPORT_INDEX_PATH.open("w", encoding="utf-8") as handle:
        for record in sorted_records:
            handle.write(json.dumps(record, ensure_ascii=True) + "\n")


def report_job_attempt_count() -> int:
    return bounded_int(env("DOPE_REPORT_JOB_ATTEMPTS"), 5, 1, 8)


def retryable_report_error(message: str) -> bool:
    text = str(message or "").lower()
    retryable_patterns = [
        "http 422",
        "missing required sections",
        "missing required tables",
        "prompt echo",
        "scratchpad",
        "too short",
        "too small",
        "page visual qa",
        "visual qa",
        "render failed",
        "overlapping",
        "cropped",
        "blank page",
        "unreadable",
        "visible client proposal",
        "visible client copy",
        "visible client report",
    ]
    return any(pattern in text for pattern in retryable_patterns)


def retry_note_from_error(message: str) -> str:
    cleaned = re.sub(r"\s+", " ", str(message or "")).strip()
    return (
        "The previous draft failed DOPE/SUN validation. Rewrite from scratch and fix this exact issue: "
        f"{cleaned[:600]}. "
        "Return only the client-visible report. Start with DOPE MARKETING. Include every required section title "
        "from the contract in order, and include every required Markdown table named by the report contract. "
        "If the failure mentions page visual QA, make the report cleaner, shorter, less crowded, with clearer headings, fewer dense paragraphs, and easier tables."
    )


def process_one(client: DopeClient, dry_run: bool = False) -> bool:
    job = client.next_report()
    if not job:
        log("idle")
        return False

    job_id = job.get("id")
    company_name = compact(job.get("company", {}).get("name") or job.get("deal", {}).get("company_name"), "unknown")
    log("claimed", id=job_id, status=company_name)
    try:
        with ReportHeartbeat(client, job):
            logo = client.fetch_logo(job)
            report_images, media_fetch_errors = client.fetch_report_images(job, logo=logo)
            vision_notes = vision_scan_images(job, report_images)
            ocr_notes = ocr_scan_images(job, report_images)
            media_observations = embedded_media_observations(report_images, vision_notes + ocr_notes)
            job["_alice_media_observations"] = media_observations
            job["_alice_media_fetch_errors"] = media_fetch_errors
            max_attempts = report_job_attempt_count()
            last_error = None
            for job_attempt in range(1, max_attempts + 1):
                if job_attempt > 1:
                    log("rebuild_retry", id=job_id, status=f"attempt={job_attempt} of {max_attempts}")
                report_text, ai_meta = generate_report_text(job)
                _retrieval_context, embedding_meta = ensure_embedding_context(job)
                document_text = full_document_text(job, report_text)
                timestamp = dt.datetime.now().strftime("%Y%m%d%H%M%S")
                filename = f"{timestamp}-{slug(company_name)}-market-report.docx"
                REPORT_DIR.mkdir(parents=True, exist_ok=True)
                docx_path = REPORT_DIR / filename
                create_report_docx(job, document_text, logo, docx_path, report_images=report_images)
                canva_packet = write_canva_packet(job, document_text, docx_path)
                log("canva_packet", id=job_id, status=f"{canva_packet['format']} csv={canva_packet['csv_path']}")
                page_visual_qa = run_page_visual_qa(job, docx_path, document_text)
                sections = report_section_titles(job, document_text)
                report_title = report_display_title(job, document_text, sections, company_name)
                words = word_count(document_text)
                quality_errors = validate_report_file(job, docx_path, document_text)
                quality_errors.extend(page_visual_qa.get("errors", []))
                logo_reason = logo_missing_reason(job, logo)
                manifest = {
                    "worker_id": client.worker_id,
                    "node_id": node_id(client.worker_id),
                    "maza_address": node_maza_address(),
                    "generated_at": now_iso(),
                    "provider": ai_meta["provider"],
                    "model": ai_meta["model"],
                    "local_runtime_provider": ai_meta.get("local_runtime_provider"),
                    "local_model_family": ai_meta.get("local_model_family"),
                    "usage": ai_meta.get("usage", {}),
                    "reasoning_effort": ai_meta.get("reasoning_effort"),
                    "embedder_model": embedding_meta.get("embedder_model"),
                    "embedding_provider": embedding_meta.get("embedding_provider"),
                    "embedding_chunks_count": embedding_meta.get("embedding_chunks_count"),
                    "embedding_top_k": embedding_meta.get("embedding_top_k"),
                    "embedder_model_fallback": embedding_meta.get("embedder_model_fallback"),
                    "requested_embedder_model": embedding_meta.get("requested_embedder_model"),
                    "embedding_errors": embedding_meta.get("embedding_errors", []),
                    "word_count": words,
                    "minimum_words": minimum_words(job),
                    "target_words": minimum_words(job),
                    "hard_minimum_words": hard_minimum_words(job),
                    "minimum_docx_bytes": minimum_docx_bytes(job),
                    "byte_size": docx_path.stat().st_size,
                    "docx_signature": docx_path.read_bytes()[:2].decode("ascii", errors="replace"),
                    "report_title": report_title,
                    "summary": report_text[:500],
                    "logo_embedded": bool(logo),
                    "logo_reason": logo_reason,
                    "media": {
                        "logo_embedded": bool(logo),
                        "logo_source": logo[2] if logo and len(logo) > 2 else None,
                        "logo_reason": logo_reason,
                        "uploaded_media_count": len(job.get("assets", {}).get("uploaded_media", []) or []),
                        "embedded_image_count": (1 if logo else 0) + len(report_images),
                        "embedded_supporting_image_count": len(report_images),
                        "embedded_images": media_observations,
                        "preflight_scan_enabled": report_preflight_scan_enabled(job),
                        "vision_enabled": report_preflight_scan_enabled(job),
                        "vision_model": report_preflight_vision_model(job),
                        "vision_notes": vision_notes,
                        "ocr_model": report_preflight_ocr_model(job),
                        "ocr_notes": ocr_notes,
                        "fetch_errors": media_fetch_errors + ([] if logo else [logo_reason]),
                    },
                    "canva": canva_packet,
                    "local_path": str(docx_path),
                    "source_artifact_id": job_id,
                    "source_deal_id": job.get("deal", {}).get("id"),
                    "bake": {
                        "eligible": bool(node_maza_address()),
                        "unit": "completed_report",
                        "source": "dope.report",
                        "source_artifact_id": job_id,
                        "worker_id": client.worker_id,
                        "node_id": node_id(client.worker_id),
                        "maza_address": node_maza_address(),
                        "completed_at": now_iso(),
                        "file_sha256": hashlib.sha256(docx_path.read_bytes()).hexdigest(),
                    },
                    "sections": sections,
                    "required_sections": job.get("report_contract", {}).get("required_sections", []),
                    "quality_errors": quality_errors,
                    "quality_warnings": page_visual_qa.get("warnings", []),
                    "pipeline": {
                        "preflight_visual_scan_enabled": report_preflight_scan_enabled(job),
                        "preflight_vision_model": report_preflight_vision_model(job),
                        "preflight_ocr_model": report_preflight_ocr_model(job),
                        "post_generation_review_enabled": report_post_review_enabled(job),
                        "post_generation_review": ai_meta.get("post_review", {}),
                        "page_visual_qa_enabled": report_page_visual_qa_enabled(job),
                        "page_visual_qa_model": report_page_visual_qa_model(job),
                        "page_visual_qa": page_visual_qa,
                    },
                    "job_attempt": job_attempt,
                    "max_job_attempts": max_attempts,
                }
                if quality_errors:
                    message = "quality failed before complete: " + "; ".join(quality_errors)
                    last_error = RuntimeError(message)
                    if job_attempt < max_attempts and retryable_report_error(message):
                        job["_alice_retry_note"] = retry_note_from_error(message)
                        log("quality_retry", id=job_id, status=f"attempt={job_attempt} {message[:140]}")
                        continue
                    raise last_error
                if dry_run:
                    write_local_report_record(job, docx_path, manifest, {"status": "dry_run"})
                    log("dry_run_ready", id=job_id, provider=ai_meta["provider"], model=ai_meta["model"], status=str(docx_path))
                    return True
                try:
                    result = client.complete(job, docx_path, manifest)
                except Exception as complete_error:
                    last_error = complete_error
                    message = f"{type(complete_error).__name__}: {complete_error}"
                    if job_attempt < max_attempts and retryable_report_error(message):
                        job["_alice_retry_note"] = retry_note_from_error(message)
                        log("complete_retry", id=job_id, status=f"attempt={job_attempt} {message[:140]}")
                        continue
                    raise
                write_local_report_record(job, docx_path, manifest, result)
                log("completed", id=job_id, provider=ai_meta["provider"], model=ai_meta["model"], status=result.get("status"))
                return True
            if last_error:
                raise last_error
            raise RuntimeError(f"report failed after {max_attempts} attempts")
    except Exception as error:
        message = f"{type(error).__name__}: {error}"
        log("failed", id=job_id, status=message[:160])
        try:
            client.fail(job, message)
        except Exception as fail_error:
            log("fail_endpoint_error", id=job_id, status=f"{type(fail_error).__name__}: {fail_error}")
        return False


def main() -> int:
    load_env_files()
    parser = argparse.ArgumentParser(description="Alice-side worker for DOPE market-report DOCX generation.")
    parser.add_argument("--status", action="store_true", help="Check worker API status and exit.")
    parser.add_argument("--recent", action="store_true", help="Print the local completed-report index and exit.")
    parser.add_argument("--once", action="store_true", help="Process one queued report and exit.")
    parser.add_argument("--dry-run", action="store_true", help="Generate locally after claiming, but do not complete the job.")
    parser.add_argument("--poll-seconds", type=float, default=float(env("DOPE_REPORT_WORKER_POLL_SECONDS", "10")), help="Polling delay for daemon mode.")
    args = parser.parse_args()

    client = DopeClient()
    if args.recent:
        try:
            records = client.recent_reports()
            sync_local_report_records(records)
            print(json.dumps(records, indent=2, ensure_ascii=True))
        except Exception as error:
            log("recent_reports_fallback", status=f"{type(error).__name__}: {error}")
            print(json.dumps(local_report_records(), indent=2, ensure_ascii=True))
        return 0

    status = client.status()
    log("status", status=f"enabled={status.get('enabled')}", queued=status.get("queued"))
    if args.status:
        print(json.dumps({k: status.get(k) for k in ["ok", "worker_id", "enabled", "queued", "generating", "stale_generating", "worker_lease_seconds", "ready", "failed", "archived", "completed"]}, indent=2))
        return 0

    if args.once:
        return 0 if process_one(client, dry_run=args.dry_run) else 1

    while True:
        process_one(client)
        time.sleep(max(args.poll_seconds, 2.0))


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nstopping", file=sys.stderr)
        raise SystemExit(130)

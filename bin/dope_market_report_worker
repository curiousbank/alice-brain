def report_design_press_runtime(job: dict) -> dict:
    press = job.get("design_press_runtime", {}) or {}
    if not isinstance(press, dict):
        press = {}
    metadata = job.get("metadata", {}) or {}
    enabled_value = press.get("enabled")
    if enabled_value is None:
        enabled_value = runtime_or_metadata_value(job, "design_press_enabled", "report_design_press_enabled")
    enabled = truthy(enabled_value)
    return {
        "enabled": enabled,
        "stage": str(press.get("stage") or metadata.get("report_design_press_stage") or ("queued" if enabled else "off")).strip(),
        "template": str(press.get("template") or metadata.get("report_design_press_template") or "market_one_sheet").strip(),
        "style": str(press.get("style") or metadata.get("report_design_press_style") or "dope_clean").strip(),
        "output": str(press.get("output") or metadata.get("report_design_press_output") or "print_png_pdf").strip(),
        "renderer": str(press.get("renderer") or metadata.get("report_design_press_renderer") or "alice-design-press").strip(),
        "notes": str(press.get("notes") or metadata.get("report_design_press_notes") or "").strip(),
        "canvas": str(press.get("canvas") or "8.5x11 portrait").strip(),
        "purpose": str(press.get("purpose") or "Create a press-ready visual report output after the strategy copy is validated.").strip(),
    }


def report_design_press_openai_enabled(job: dict) -> bool:
    press = report_design_press_runtime(job)
    if not press.get("enabled"):
        return False
    value = env("DOPE_REPORT_DESIGN_PRESS_OPENAI_ENABLED", "1")
    return truthy(value)


def report_design_press_openai_models() -> list[str]:
    configured = env_list("DOPE_REPORT_DESIGN_PRESS_OPENAI_MODELS")
    if configured:
        return configured
    preferred = env("DOPE_REPORT_DESIGN_PRESS_OPENAI_MODEL", "gpt-image-1.5")
    fallback = env("DOPE_REPORT_DESIGN_PRESS_OPENAI_FALLBACK_MODEL", "gpt-image-1")
    return [item for item in [preferred, fallback] if item]


def design_press_openai_prompt(job: dict, document_text: str, report_title: str) -> str:
    metadata = job.get("metadata", {}) or {}
    deal = job.get("deal", {}) or {}
    company = job.get("company", {}) or {}
    contract_client = (job.get("report_contract", {}) or {}).get("client", {}) or {}
    press = report_design_press_runtime(job)
    company_name = (
        contract_client.get("business_name")
        or metadata.get("company_name")
        or company.get("name")
        or deal.get("name")
        or report_title
        or "Client"
    )
    service_area = (
        contract_client.get("service_area")
        or company.get("service_area")
        or company.get("city")
        or metadata.get("service_area")
        or "local market"
    )
    industry = (
        contract_client.get("industry")
        or company.get("industry")
        or metadata.get("industry")
        or "local service business"
    )
    teaser = plain_text(document_text)[:520]
    note = press.get("notes") or "Make this feel ready for boss review as a no-Canva proof."
    return f"""Create a polished 8.5x11 vertical client-facing marketing report cover/poster.

Keep these exact visible words only:
WIZWIKI MARKETING
Market Strategy Report
{plain_text(str(company_name))[:80]}
{plain_text(str(service_area))[:80]}
Design Press Proof

Use this report context for visual direction, not as copy to paste:
Title: {plain_text(report_title)[:140]}
Industry: {plain_text(str(industry))[:80]}
Summary: {teaser}
Design note: {plain_text(str(note))[:220]}

Visual direction:
- Premium marketing proposal cover, not a spreadsheet, not a wireframe.
- Strong black, white, charcoal, and DOPE red palette.
- Crisp editorial typography, glossy print finish, sharp grid, professional agency style.
- Include abstract neighborhood-map lines, direct-mail/postcard shapes, local-market intelligence visuals, and subtle service-category cues.
- Template: {press.get("template")}; style: {press.get("style")}; output: {press.get("output")}.

Avoid:
- Do not invent fake percentages, charts, statistics, phone numbers, prices, QR codes, URLs, or addresses.
- Do not include tiny unreadable body copy.
- Do not include random or distorted text.
- Do not mention Canva, OpenAI, AI, model names, private worker metadata, worker IDs, or artifact IDs.
- Do not make it look like a generic corporate blue template."""


def generate_openai_design_press_preview(job: dict, document_text: str, report_title: str) -> dict:
    press = report_design_press_runtime(job)
    if not press.get("enabled"):
        return {"enabled": False, "status": "off"}
    if not report_design_press_openai_enabled(job):
        return {"enabled": False, "status": "disabled"}

    api_key = env("OPENAI_API_KEY")
    if not api_key:
        return {"enabled": True, "status": "skipped", "error": "OPENAI_API_KEY not available to Alice worker"}

    prompt = design_press_openai_prompt(job, document_text, report_title)
    last_error = ""
    job_id = job.get("id")
    for model in report_design_press_openai_models():
        model = str(model or "").strip()
        if not model:
            continue
        try:
            log("design_press_openai_start", id=job_id, provider="openai/image", model=model, status=f"template={press.get('template')} style={press.get('style')}")
            parsed = openai_image_generation(
                api_key=api_key,
                model=model,
                prompt=prompt,
                size=env("DOPE_REPORT_DESIGN_PRESS_IMAGE_SIZE", "1024x1536") or "1024x1536",
                quality=env("DOPE_REPORT_DESIGN_PRESS_IMAGE_QUALITY", "high") or "high",
                output_format="jpeg",
            )
            data = parsed.get("data") or []
            image_b64 = data[0].get("b64_json") if data and isinstance(data[0], dict) else None
            if not image_b64:
                raise RuntimeError("OpenAI image response did not include b64_json")
            byte_size = len(base64.b64decode(image_b64))
            log("design_press_openai_done", id=job_id, provider="openai/image", model=model, status=f"bytes={byte_size}")
            return {
                "enabled": True,
                "status": "generated",
                "path": "design_press/openai-press-sheet.jpg",
                "content_type": "image/jpeg",
                "byte_size": byte_size,
                "model": model,
                "source": "OpenAI Images API generation from validated report context",
                "prompt_path": "design_press/openai-prompt.txt",
                "prompt": prompt,
                "image_base64": image_b64,
                "created_at": now_iso(),
            }
        except OpenAIRequestError as error:
            last_error = f"{error.http_code}: {error.message[:260]}"
            log("design_press_openai_candidate_failed", id=job_id, provider="openai/image", model=model, status=last_error)
        except Exception as error:
            last_error = f"{type(error).__name__}: {str(error)[:260]}"
            log("design_press_openai_candidate_failed", id=job_id, provider="openai/image", model=model, status=last_error)

    return {
        "enabled": True,
        "status": "failed",
        "error": last_error or "OpenAI image generation failed",
        "models": report_design_press_openai_models(),
        "created_at": now_iso(),
    }


def local_report_required(job: dict) -> bool:
    runtime = report_runtime(job)
    provider = str(runtime.get("provider") or "").lower()
    target_model = str(runtime.get("target_model") or "").lower()
    forbidden = " ".join(str(item).lower() for item in runtime.get("forbidden_providers", []) or [])
    return (
        truthy(runtime.get("qwen_only"))
        or truthy(runtime.get("force_local"))
        or "qwen" in provider
        or provider in {"local", "local_qwen", "qwen/local"}
        or "qwen" in target_model
        or ("openai" in forbidden and not truthy(runtime.get("openai_allowed")))
    )


def normalize_local_model_name(value: str) -> str:
    cleaned = str(value or "").strip()
    lowered = cleaned.lower()
    aliases = {
        "qwen3.5:9b": "qwen3:8b",
        "qwen3.5:9b-mlx": "qwen3:8b",
        "qwen3.6:27b": "qwen3:30b",
        "qwen3.6:27b-mlx": "qwen3:30b",
        "qwen3.6:35b": "qwen3:30b",
        "qwen3.6:35b-mlx": "qwen3:30b",
        "qwen3:30b-a3b": "qwen3:30b",
        "qwen3:14b": "qwen3:8b",
        "devstral-small-2:24b": "qwen3:8b",
        "gemma4:e4b": "qwen3:8b",
        "granite4.1:8b": "qwen3:8b",
    }
    return aliases.get(lowered, cleaned)


def local_model_candidates(job: dict) -> list[str]:
    runtime = report_runtime(job)
    metadata = job.get("metadata", {}) or {}
    contract = job.get("report_contract", {}) or {}

    # If SUN queued an explicit per-report model, do not silently downgrade to
    # the env/default fallback. A missing selected model should fail loudly so
    # the DOPE UI does not claim a 27B report was produced by an 8B fallback.
    explicit_candidates = []
    for item in runtime.get("model_ladder") or runtime.get("models") or []:
        explicit_candidates.append(item)
    explicit_candidates.extend([
        runtime.get("local_model"),
        runtime.get("target_model"),
        metadata.get("report_local_model"),
        contract.get("target_model"),
    ])

    candidates = []
    for item in explicit_candidates:
        value = normalize_local_model_name(item)
        if not value or value.lower() in {"qwen/local", "local", "openai"}:
            continue
        if value not in candidates:
            candidates.append(value)
    if candidates:
        if strict_local_report_contract(job) and local_fallback_models_enabled(job):
            fallback_candidates = [
                *env_list("DOPE_REPORT_LOCAL_FALLBACK_MODELS"),
                *DEFAULT_LOCAL_MODEL_CANDIDATES,
            ]
            for item in fallback_candidates:
                value = normalize_local_model_name(item)
                if not value or value.lower() in {"qwen/local", "local", "openai"}:
                    continue
                if value not in candidates:
                    candidates.append(value)
        return candidates

    candidates = [
        *env_list("DOPE_REPORT_LOCAL_MODEL_CANDIDATES"),
        env("DOPE_REPORT_LOCAL_MODEL"),
        env("AUTOS_LOCAL_MODEL"),
        env("OLLAMA_MODEL"),
        *DEFAULT_LOCAL_MODEL_CANDIDATES,
    ]
    cleaned = []
    for item in candidates:
        value = normalize_local_model_name(item)
        if not value or value.lower() in {"qwen/local", "local", "openai"}:
            continue
        if value not in cleaned:
            cleaned.append(value)
    return cleaned


def strict_local_report_contract(job: dict) -> bool:
    contract = job.get("report_contract", {}) or {}
    quality_gate = contract_quality_gate(job)
    return bool(
        len(contract.get("required_sections", []) or []) >= 3
        or contract.get("required_tables", [])
        or quality_gate.get("required_sections")
        or quality_gate.get("required_tables")
    )


def local_fallback_models_enabled(job: dict) -> bool:
    runtime = report_runtime(job)
    if truthy(runtime.get("disable_local_model_fallbacks")):
        return False
    return truthy(runtime.get("allow_local_model_fallbacks")) or truthy(env("DOPE_REPORT_LOCAL_FALLBACKS_ENABLED", "0"))


def local_runtime_provider(model: str) -> str:
    return "qwen/local" if "qwen" in str(model or "").lower() else "ollama/local"


def local_model_family(model: str) -> str:
    lowered = str(model or "").lower()
    for family in ["qwen", "devstral", "granite", "gemma", "llama"]:
        if family in lowered:
            return family
    return "ollama"


def report_job_requires_exclusive_slot(job: dict) -> bool:
    if not truthy(env("DOPE_REPORT_HEAVY_MODELS_EXCLUSIVE", "1")):
        return False

    heavy_patterns = tuple(
        item.lower()
        for item in env_list("DOPE_REPORT_HEAVY_MODEL_PATTERNS")
        or ["30b", "27b", "35b", "24b", "70b", "72b", "mixtral", "devstral"]
    )
    candidates = local_model_candidates(job)
    candidates.extend(
        [
            report_post_review_model(job),
            report_page_visual_qa_model(job) if truthy(env("DOPE_REPORT_PAGE_QA_EXCLUSIVE", "0")) else "",
        ]
    )
    return any(any(pattern in str(model).lower() for pattern in heavy_patterns) for model in candidates)


def report_generation_instructions(job: dict | None = None) -> str:
    outline = required_report_outline(job or {})
    if truthy(env("DOPE_REPORT_COMPACT_PROMPT", "0")):
        return f"""Write the final client-facing WIZWIKI Marketing report in polished Markdown.
The supplied generation prompt and report contract are authoritative for section order, required tables, audience, length, and wording.
{outline[:3000]}
Ground every recommendation in the client fact sheet, retrieved context, timing context, approved media observations, and supplied CRM facts. Never invent facts, prices, dates, statistics, discounts, service areas, proof, or image details.
Use concise headings, short paragraphs, useful bullets, concrete campaign names, and required Markdown tables. Keep the tone confident and professional.
Never expose worker/model/vendor names, tokens, IDs, raw payloads, private metadata, source inventories, internal notes, or hidden reasoning.
For client reports, omit AM actions, designer/production notes, appendices, assumptions tables, and technical handoff sections unless the contract explicitly requires them.
Return only complete visible report copy. No JSON, code fences, placeholders, planning notes, prompt echoes, or <think> tags."""
    return f"""You are the WIZWIKI market analyzer for WIZWIKI Marketing.
Write a professional, client-facing WIZWIKI Market Report.
Use payload["generation_prompt"] or payload["report_contract"]["llm_prompt"] as the controlling brief.
SUN's report contract controls the visible section order, required tables, length, and wording. Do not append legacy sections.
{outline}
Use HubSpot labeled properties, raw properties, missing core fields, deal/company/commerce data, and uploaded media filenames/endpoints as private source context only.
Treat payload["client_fact_sheet"] as the highest-priority source for business name, inferred industry, service-area candidates, contact/domain clues, and production timing guardrails.
Never write generic placeholders such as "Your Local Service Area", "local service business" when a specific inferred industry is available, or "measurable" as a stand-in for an unsourced statistic or discount.
When embedded_media_observations are present, use them to shape visual direction, proof points, brand handling, and Canva/print recommendations. Use ocr_text only as visible image text. Do not invent image details beyond filename, dimensions, role, vision_summary, or ocr_text.
Use payload["timing_context"] for all timeline recommendations. Do not recommend a launch, mail, print, or drop date before timing_context.earliest_production_ready_date. Always allow the configured production lead time before first execution.
If the current date has already passed a seasonal setup window, recommend the next practical production window rather than naming a past month.
Analyze the full account graph when present: associated companies, contacts, prior or related deals, statuses, stages, domains, amounts, and useful HubSpot properties. Use that data to sharpen audience, timing, offer, CRM follow-up, and sales-readiness recommendations.
If associated data exists, synthesize it into practical recommendations; if it is missing, say only the customer-facing setup item when appropriate.
Do not invent private facts. If a field is missing, call out only the customer-facing setup item when the contract asks for it.
Never mention private worker names, AI vendors, model names, tokens, HubSpot IDs, or private technical metadata in visible report copy.
No caveman voice. No generic marketing filler. No JSON. No markdown fences. No hidden thinking tags.
Return only the visible client report Markdown.
Make the report feel designed, not like a memo: use large useful headings, short confident paragraphs, scannable bullets, concrete campaign names, red/black callout language, and required Markdown tables.
Use directional proof points unless exact numbers are present in source context. Prefer "track response by QR/phone/CRM source" over invented percentages.
The visible client report must stop after the Final Recommendation section when that section exists in the contract.
Allowed internal AM sections are only the sections named in the AM report contract.
Do not include AM-Facing Actions in client reports, Designer Notes, Print Production Notes, Canva Data Postcard Handoff, Source Data Appendix, HubSpot Properties, Asset List, Human Approval Gates, assumptions tables, prompt notes, payload notes, or technical metadata.
Keep recommendations tied to WIZWIKI services: direct mail, postcards, yard signs, door hangers, print, CRM/source-data follow-up, campaign tracking, and customer approval.
The output will be rendered into a real DOCX by the report worker, so write complete report content only."""


def local_report_prompt(job: dict, retry_note: str | None = None) -> str:
    package = report_prompt_input(job, retry_note=retry_note)
    return (
        f"{report_generation_instructions(job)}\n\n"
        "OUTPUT CONTRACT:\n"
        "- Return only the final client-visible Markdown copy.\n"
        "- Start exactly with WIZWIKI MARKETING.\n"
        "- Do not explain what you are creating.\n"
        "- Do not echo the payload, report_contract, section list, missing inputs, or instructions.\n"
        "- Include required Markdown tables using pipe table syntax where the contract asks for tables.\n"
        "- No <think> tags, hidden reasoning, planning notes, analysis preface, or notes after the final section.\n\n"
        f"PAYLOAD:\n{package}\n\nReturn the final visible report copy now."
    )


def local_attempt_count() -> int:
    return bounded_int(env("DOPE_REPORT_LOCAL_ATTEMPTS"), 5, 1, 8)


def report_audience(job: dict) -> str:
    contract = job.get("report_contract") or {}
    metadata = job.get("metadata") or {}
    runtime = job.get("copy_maker") or {}
    metadata_audience = str(metadata.get("report_audience") or metadata.get("report_mode") or "").strip().lower()
    contract_audience = str(contract.get("audience") or "").strip().lower()
    audience = metadata_audience or contract_audience
    if audience:
        if "copy_maker" in audience or "copy maker" in audience:
            return "copy_maker"
        if audience == "am" or "internal am" in audience:
            return "am"
        if audience == "client" or "client" in audience:
            return "client"
        return audience
    if truthy(metadata.get("copy_maker_enabled")) or truthy(runtime.get("enabled")):
        return "copy_maker"
    return "client"


def report_document_kind(job: dict) -> str:
    audience = report_audience(job)
    if audience == "copy_maker":
        return "copy-maker"
    if audience == "am":
        return "am-brief"
    return "market-report"


def local_retry_note(job: dict, report_text: str, quality_errors: list[str], minimum: int) -> str:
    words = word_count(report_text)
    target = max(minimum + 150, 650)
    errors = "; ".join(quality_errors) or "too short"
    audience = report_audience(job)
    if audience == "copy_maker":
        visible_label = "copy-focused visible output"
        section_rule = "Include Header, Source-Aware Copy Direction, Generated Copy, and Usage Notes unless the contract changes them. "
        table_rule = "Do not add tables unless the custom prompt asks for them. "
    elif audience == "am":
        visible_label = "internal AM-facing copy"
        section_rule = "Include all required internal sections, especially Internal Next Moves. "
        table_rule = "Use tables only when they help the AM act faster. "
    else:
        visible_label = "client-visible copy"
        section_rule = "Include all required client-facing sections. "
        table_rule = "Include the required campaign and investment Markdown tables. "
    return (
        f"The previous draft failed preflight: words={words}, minimum={minimum}, errors={errors}. "
        f"Revise the previous draft with {target}-{target + 250} words while staying concise and {visible_label}. "
        f"Start exactly with WIZWIKI MARKETING. Return only {visible_label}. "
        f"{section_rule}{table_rule}Do not include planning notes, "
        "payload summaries, missing-input labels, hidden thinking, or explanation of the task. "
        "Do not use unsupported exact percentages or statistics. Do not use internal ticket/status words like abandoned, SAM, HubSpot ID, or workflow stage names in client copy. "
        "Do not leave any section heading empty or duplicate section headings."
    )


def copy_maker_enabled(job: dict) -> bool:
    return report_audience(job) == "copy_maker"


def copy_maker_local_prep_required(job: dict) -> bool:
    runtime = job.get("copy_maker", {}) or {}
    metadata = job.get("metadata", {}) or {}
    if "local_prep_required" in runtime:
        return truthy(runtime.get("local_prep_required"))
    if "copy_maker_local_prep_enabled" in metadata:
        return truthy(metadata.get("copy_maker_local_prep_enabled"))
    return True


def copy_maker_comm_kit_enabled(job: dict) -> bool:
    runtime = job.get("copy_maker", {}) or {}
    metadata = job.get("metadata", {}) or {}
    return copy_maker_enabled(job) and (
        truthy(runtime.get("comm_kit_enabled"))
        or truthy(metadata.get("copy_maker_comm_kit_enabled"))
    )


def copy_maker_comm_kit_direction(job: dict) -> str:
    runtime = job.get("copy_maker", {}) or {}
    metadata = job.get("metadata", {}) or {}
    contract = runtime.get("comm_kit_contract") or metadata.get("copy_maker_comm_kit_contract") or {}
    if isinstance(contract, str):
        try:
            contract = json.loads(contract)
        except json.JSONDecodeError:
            contract = {}
    value = str(
        runtime.get("comm_kit_direction")
        or metadata.get("copy_maker_comm_kit_direction")
        or (contract or {}).get("direction")
        or "dope_out"
    ).strip().lower()
    return "client_out" if value == "client_out" else "dope_out"


def copy_maker_comm_kit_direction_label(job: dict) -> str:
    return "CLIENT OUT" if copy_maker_comm_kit_direction(job) == "client_out" else "DOPE OUT"


def copy_maker_comm_kit_direction_rules(job: dict) -> str:
    if copy_maker_comm_kit_direction(job) == "client_out":
        return (
            "DIRECTION: CLIENT OUT.\n"
            "- Write as the client business, not as DOPE Marketing.\n"
            "- The recipient is the client's customer or prospect in the client's CRM.\n"
            "- Help the client promote its own service, estimate, appointment, offer, follow-up, or seasonal campaign.\n"
            "- Do not pitch DOPE, direct-mail setup, or DOPE pricing in CLIENT OUT mode unless the user's prompt explicitly asks for it.\n"
        )
    return (
        "DIRECTION: DOPE OUT.\n"
        "- Write as DOPE Marketing to the business owner or decision maker.\n"
        "- The product is direct-mail marketing: postcards, neighborhood campaigns, print follow-up, and CRM-friendly campaign setup.\n"
        "- The current campaign angle is July 4 / Happy 250th America specials, with enough lead time for setup and approvals.\n"
        "- Keep it helpful and sales-ready without fake urgency, fake discounts, or unsupported claims.\n"
    )


def copy_maker_user_prompt(job: dict) -> str:
    runtime = job.get("copy_maker", {}) or {}
    metadata = job.get("metadata", {}) or {}
    contract = job.get("report_contract", {}) or {}
    prompt = (
        runtime.get("prompt")
        or metadata.get("copy_maker_prompt")
        or contract.get("copy_maker_prompt")
        or "Create useful client-ready marketing copy from the related CRM data."
    )
    return str(prompt).strip()


def comm_kit_clean_line(value: str) -> str:
    cleaned = re.sub(r"^[-*#>\s]+", "", str(value or "").strip())
    cleaned = cleaned.replace("**", "")
    cleaned = re.sub(r"\s+", " ", cleaned)
    return cleaned.strip()


def comm_kit_section(text: str, start_pattern: str, end_pattern: str) -> str:
    match = re.search(start_pattern, text or "", flags=re.I)
    if not match:
        return ""
    rest = (text or "")[match.end() :]
    ending = re.search(end_pattern, rest, flags=re.I)
    return rest[: ending.start()] if ending else rest


def comm_kit_sms_options(report_text: str) -> list[dict]:
    section = comm_kit_section(
        report_text,
        r"comm\s+kit\s+text\s+messages|text\s+messages|sms\s+messages",
        r"comm\s+kit\s+sales\s+emails|sales\s+emails|email\s+templates|usage\s+notes",
    ) or report_text
    labels = [
        ("sms_warm", "Warm Check-In", "warm check-in", "low"),
        ("sms_helpful", "Helpful Reminder", "helpful reminder", "medium"),
        ("sms_clear_next_step", "Clear Next-Step", "clear next-step", "high without pressure"),
    ]
    candidates = []
    for line in section.splitlines():
        cleaned = comm_kit_clean_line(line)
        if not cleaned or re.match(r"^(comm kit|text messages|sms messages|usage notes)\b", cleaned, flags=re.I):
            continue
        match = re.match(
            r"^(?:\d+[.)]\s*)?(?:text|sms)?\s*(?:message)?\s*(?:\d+)?\s*(?:[-:])?\s*(warm check-in|warm|helpful reminder|helpful|clear next-step|clear next step|urgent|direct)?\s*[:\-–]\s*(.+)$",
            cleaned,
            flags=re.I,
        )
        if match:
            candidates.append(comm_kit_clean_line(match.group(2)))
        elif re.match(r"^\d+[.)]\s+", cleaned):
            candidates.append(comm_kit_clean_line(re.sub(r"^\d+[.)]\s+", "", cleaned)))
    candidates = [body for body in candidates if 12 <= len(body) <= 520]
    options = []
    for index, (option_id, label, tone, urgency) in enumerate(labels):
        body = candidates[index] if index < len(candidates) else ""
        options.append({
            "id": option_id,
            "label": label,
            "tone": tone,
            "urgency": urgency,
            "body": body[:520],
        })
    return options


def comm_kit_email_options(report_text: str) -> list[dict]:
    section = comm_kit_section(
        report_text,
        r"comm\s+kit\s+sales\s+emails|sales\s+emails|email\s+templates",
        r"usage\s+notes|source-aware|generated copy",
    ) or report_text
    chunks = re.split(r"(?=^\s*(?:[-*]\s*)?(?:email|sales email)\s*(?:\d+|one|two)?\s*[:\-–])", section, flags=re.I | re.M)
    emails = []
    for chunk in chunks:
        if not re.search(r"\bsubject\s*:", chunk, flags=re.I):
            continue
        subject = re.search(r"\bsubject\s*:\s*(.+)", chunk, flags=re.I)
        body = re.search(r"\bbody\s*:\s*(.+)", chunk, flags=re.I | re.S)
        subject_text = comm_kit_clean_line(subject.group(1) if subject else "")
        body_text = comm_kit_clean_line(body.group(1) if body else "")
        if subject_text or body_text:
            emails.append((subject_text, body_text))
    labels = [
        ("email_intro", "Friendly sales email"),
        ("email_follow_up", "Friendly follow-up email"),
    ]
    options = []
    for index, (option_id, label) in enumerate(labels):
        subject, body = emails[index] if index < len(emails) else ("", "")
        options.append({
            "id": option_id,
            "label": label,
            "subject": subject[:180],
            "body": body[:2400],
        })
    return options


def comm_kit_selection_prompt(job: dict, sms_options: list[dict], email_options: list[dict]) -> str:
    company = compact(job.get("company", {}).get("name") or job.get("deal", {}).get("company_name"), "client")
    contact_intelligence = job.get("contact_intelligence", {}) or job.get("ai_runtime", {}).get("contact_intelligence", {}) or {}
    return (
        "Pick the strongest Aircall-ready COMM KIT pair.\n"
        "Choose one SMS and one email from the provided JSON.\n"
        "Favor specific, friendly, useful copy with clear next steps. Avoid fake urgency or unsupported claims.\n"
        "Return strict JSON only: {\"selected_sms_id\":\"...\",\"selected_email_id\":\"...\",\"reason\":\"...\"}.\n\n"
        f"Company: {company}\n"
        f"Direction: {copy_maker_comm_kit_direction_label(job)}\n"
        f"Direction rules: {copy_maker_comm_kit_direction_rules(job)}\n"
        f"Ranked contact intelligence: {json.dumps(contact_intelligence, ensure_ascii=True)[:6000]}\n"
        f"SMS options: {json.dumps(sms_options, ensure_ascii=True)}\n"
        f"Email options: {json.dumps(email_options, ensure_ascii=True)}"
    )


def parse_comm_kit_selector_response(raw_text: str) -> dict:
    text = str(raw_text or "").strip()
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        match = re.search(r"\{.*\}", text, flags=re.S)
        if match:
            try:
                return json.loads(match.group(0))
            except json.JSONDecodeError:
                pass
    return {}


def parse_json_object_response(raw_text: str) -> dict:
    text = str(raw_text or "").strip()
    if not text:
        return {}
    try:
        parsed = json.loads(text)
        return parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        match = re.search(r"\{.*\}", text, flags=re.S)
        if not match:
            return {}
        try:
            parsed = json.loads(match.group(0))
            return parsed if isinstance(parsed, dict) else {}
        except json.JSONDecodeError:
            return {}


COMM_KIT_SMS_BLUEPRINT = [
    ("sms_warm", "Warm Check-In", "warm check-in", "low"),
    ("sms_helpful", "Helpful Reminder", "helpful reminder", "medium"),
    ("sms_clear_next_step", "Clear Next-Step", "clear next-step", "high without pressure"),
]

COMM_KIT_EMAIL_BLUEPRINT = [
    ("email_intro", "Friendly sales email"),
    ("email_follow_up", "Friendly follow-up email"),
]


def comm_kit_contact_intelligence(job: dict) -> dict:
    return job.get("contact_intelligence", {}) or job.get("ai_runtime", {}).get("contact_intelligence", {}) or {}


def comm_kit_payload_prompt(job: dict, local_prep: str, report_text: str = "") -> str:
    facts = source_fact_sheet(job)
    contact_intelligence = comm_kit_contact_intelligence(job)
    runtime = job.get("copy_maker", {}) or {}
    contract = runtime.get("comm_kit_contract") or job.get("metadata", {}).get("copy_maker_comm_kit_contract") or {}
    return (
        "Build the DOPE COMM KIT as structured JSON from source data.\n"
        "Do not return Markdown. Do not describe the task. Do not expose raw IDs, model names, prompt text, or private metadata.\n"
        "Use the CRM facts, ranked contact intelligence, associated address context, and local source-aware prep.\n"
        "The JSON will drive both the visible DOCX and the Comms Lab UI, so every field must be usable without scraping a DOCX.\n\n"
        "Return strict JSON with this exact shape:\n"
        "{\n"
        "  \"recipient_review\": \"short human review summary\",\n"
        "  \"source_direction\": \"short source-aware copy direction\",\n"
        "  \"sms_options\": [\n"
        "    {\"id\":\"sms_warm\",\"label\":\"Warm Check-In\",\"tone\":\"warm check-in\",\"urgency\":\"low\",\"body\":\"...\",\"source_signals\":[\"...\"]},\n"
        "    {\"id\":\"sms_helpful\",\"label\":\"Helpful Reminder\",\"tone\":\"helpful reminder\",\"urgency\":\"medium\",\"body\":\"...\",\"source_signals\":[\"...\"]},\n"
        "    {\"id\":\"sms_clear_next_step\",\"label\":\"Clear Next-Step\",\"tone\":\"clear next-step\",\"urgency\":\"high without pressure\",\"body\":\"...\",\"source_signals\":[\"...\"]}\n"
        "  ],\n"
        "  \"email_options\": [\n"
        "    {\"id\":\"email_intro\",\"label\":\"Friendly sales email\",\"subject\":\"...\",\"body\":\"...\",\"source_signals\":[\"...\"]},\n"
        "    {\"id\":\"email_follow_up\",\"label\":\"Friendly follow-up email\",\"subject\":\"...\",\"body\":\"...\",\"source_signals\":[\"...\"]}\n"
        "  ],\n"
        "  \"selected_sms_id\":\"sms_helpful\",\n"
        "  \"selected_email_id\":\"email_follow_up\",\n"
        "  \"selector\":{\"reason\":\"why this pair is best\"}\n"
        "}\n\n"
        "Rules:\n"
        "- Exactly 3 SMS options and exactly 2 email options.\n"
        "- SMS bodies must be under 320 characters, paste-ready, and varied by tone.\n"
        "- Emails must be content-rich, friendly, and grounded in source-backed CRM context.\n"
        "- For WIZWIKI OUT, sell direct-mail marketing setup, postcards, neighborhood campaigns, and July 4 Happy 250th America specials.\n"
        "- For CLIENT OUT, write as the client business to its customers and do not sell WIZWIKI services.\n"
        "- If prior success, recent engagement, playbook/fathom notes, or campaign history are present, reference them naturally.\n"
        "- Never invent percentages, discounts, guarantees, or unsupported campaign results.\n\n"
        f"Direction: {copy_maker_comm_kit_direction_label(job)}\n"
        f"Direction rules: {copy_maker_comm_kit_direction_rules(job)}\n"
        f"Custom Copy Maker prompt: {copy_maker_user_prompt(job)[:2000]}\n"
        f"COMM KIT contract: {json.dumps(contract, ensure_ascii=True)[:6000]}\n"
        f"Source fact sheet: {json.dumps(facts, ensure_ascii=True)[:12000]}\n"
        f"Ranked contact intelligence: {json.dumps(contact_intelligence, ensure_ascii=True)[:12000]}\n"
        f"Local source-aware prep: {local_prep[:8000]}\n"
        f"Visible draft to align with, if useful: {report_text[:8000]}"
    )


def normalize_source_signals(value) -> list[str]:
    signals = []
    for item in value or []:
        text = comm_kit_clean_line(item)
        if text:
            signals.append(text[:180])
    return signals[:4]


def option_payload_by_id(options, option_id: str, index: int) -> dict:
    for option in options:
        if isinstance(option, dict) and str(option.get("id") or "").strip() == option_id:
            return option
    if index < len(options) and isinstance(options[index], dict):
        return options[index]
    return {}


def normalize_structured_sms_options(payload: dict) -> list[dict]:
    raw_options = payload.get("sms_options") or payload.get("texts") or payload.get("sms") or []
    raw_options = raw_options if isinstance(raw_options, list) else []
    options = []
    for index, (option_id, label, tone, urgency) in enumerate(COMM_KIT_SMS_BLUEPRINT):
        raw = option_payload_by_id(raw_options, option_id, index)
        body = comm_kit_clean_line(raw.get("body") or raw.get("message") or raw.get("text") or "")
        options.append({
            "id": option_id,
            "label": comm_kit_clean_line(raw.get("label") or label)[:80],
            "tone": comm_kit_clean_line(raw.get("tone") or tone)[:80],
            "urgency": comm_kit_clean_line(raw.get("urgency") or urgency)[:80],
            "body": body[:520],
            "source_signals": normalize_source_signals(raw.get("source_signals") or raw.get("signals")),
        })
    return options


def normalize_structured_email_options(payload: dict) -> list[dict]:
    raw_options = payload.get("email_options") or payload.get("emails") or []
    raw_options = raw_options if isinstance(raw_options, list) else []
    options = []
    for index, (option_id, label) in enumerate(COMM_KIT_EMAIL_BLUEPRINT):
        raw = option_payload_by_id(raw_options, option_id, index)
        subject = comm_kit_clean_line(raw.get("subject") or "")
        body = comm_kit_clean_line(raw.get("body") or raw.get("email_body") or raw.get("copy") or "")
        options.append({
            "id": option_id,
            "label": comm_kit_clean_line(raw.get("label") or label)[:80],
            "subject": subject[:180],
            "body": body[:2400],
            "source_signals": normalize_source_signals(raw.get("source_signals") or raw.get("signals")),
        })
    return options


def comm_kit_options_valid(sms_options: list[dict], email_options: list[dict]) -> bool:
    sms_valid = len(sms_options) == 3 and all(option.get("id") and option.get("body") for option in sms_options)
    email_valid = len(email_options) == 2 and all(option.get("id") and option.get("subject") and option.get("body") for option in email_options)
    return sms_valid and email_valid


def select_comm_kit_pair(job: dict, sms_options: list[dict], email_options: list[dict], local_model: str, default_reason: str) -> dict:
    selected_sms_id = next((option["id"] for option in sms_options if option.get("body") and option["id"] == "sms_helpful"), sms_options[0]["id"] if sms_options else None)
    selected_email_id = next((option["id"] for option in email_options if option.get("body") and option["id"] == "email_follow_up"), email_options[0]["id"] if email_options else None)
    selector = {
        "provider": "alice/fallback",
        "model": "heuristic",
        "reason": default_reason,
        "error": None,
    }
    try:
        parsed = ollama_report_response(local_model, comm_kit_selection_prompt(job, sms_options, email_options))
        choice = parse_comm_kit_selector_response(parsed.get("response"))
        candidate_sms = str(choice.get("selected_sms_id") or choice.get("sms_id") or "")
        candidate_email = str(choice.get("selected_email_id") or choice.get("email_id") or "")
        valid_sms_ids = {option["id"] for option in sms_options}
        valid_email_ids = {option["id"] for option in email_options}
        if candidate_sms in valid_sms_ids and candidate_email in valid_email_ids:
            selected_sms_id = candidate_sms
            selected_email_id = candidate_email
            selector = {
                "provider": "ollama/local",
                "model": parsed.get("model") or local_model,
                "reason": comm_kit_clean_line(choice.get("reason") or "Local Qwen selected the most useful COMM KIT pair."),
                "error": None,
            }
    except Exception as error:
        selector["error"] = f"{type(error).__name__}: {str(error)[:240]}"

    return {
        "selected_sms_id": selected_sms_id,
        "selected_email_id": selected_email_id,
        "selector": selector,
    }


def build_structured_comm_kit_from_source(job: dict, local_prep: str, local_model: str, report_text: str = "") -> dict | None:
    if not truthy(env("DOPE_COMM_KIT_STRUCTURED_ENABLED", "1")):
        return None
    parsed = ollama_report_response(local_model, comm_kit_payload_prompt(job, local_prep, report_text))
    payload = parse_json_object_response(parsed.get("response"))
    if not payload:
        raise RuntimeError("structured COMM KIT JSON response was empty or invalid")

    sms_options = normalize_structured_sms_options(payload)
    email_options = normalize_structured_email_options(payload)
    if not comm_kit_options_valid(sms_options, email_options):
        raise RuntimeError("structured COMM KIT JSON missing required SMS/email fields")

    selected = select_comm_kit_pair(
        job,
        sms_options,
        email_options,
        local_model,
        comm_kit_clean_line(payload.get("selector", {}).get("reason") if isinstance(payload.get("selector"), dict) else "")
        or "Structured source JSON selected the most balanced COMM KIT pair for review.",
    )
    selector = selected["selector"]
    raw_selector = payload.get("selector") if isinstance(payload.get("selector"), dict) else {}
    if raw_selector.get("reason") and selector["provider"] == "alice/fallback":
        selector["reason"] = comm_kit_clean_line(raw_selector.get("reason"))[:320]

    return {
        "enabled": True,
        "source": "structured_source_json",
        "source_model": parsed.get("model") or local_model,
        "direction": copy_maker_comm_kit_direction(job),
        "direction_label": copy_maker_comm_kit_direction_label(job),
        "recipient_review": comm_kit_clean_line(payload.get("recipient_review") or "")[:1200],
        "source_direction": comm_kit_clean_line(payload.get("source_direction") or "")[:1000],
        "contact_intelligence": comm_kit_contact_intelligence(job),
        "sms_options": sms_options,
        "email_options": email_options,
        "selected_sms_id": selected["selected_sms_id"],
        "selected_email_id": selected["selected_email_id"],
        "selector": selector,
    }


def build_comm_kit_manifest(job: dict, report_text: str, local_model: str, local_prep: str = "") -> dict:
    if not copy_maker_comm_kit_enabled(job):
        return {"enabled": False}
    structured_error = None
    try:
        structured = build_structured_comm_kit_from_source(job, local_prep, local_model, report_text)
        if structured:
            return structured
        structured_error = "structured COMM KIT JSON disabled"
    except Exception as error:
        structured_error = f"{type(error).__name__}: {str(error)[:240]}"

    sms_options = comm_kit_sms_options(report_text)
    email_options = comm_kit_email_options(report_text)
    selected = select_comm_kit_pair(
        job,
        sms_options,
        email_options,
        local_model,
        "Fallback parsed the visible copy because structured COMM KIT JSON was unavailable.",
    )
    selector = selected["selector"]
    selector["structured_error"] = structured_error

    return {
        "enabled": True,
        "source": "visible_text_fallback",
        "source_model": local_model,
        "direction": copy_maker_comm_kit_direction(job),
        "direction_label": copy_maker_comm_kit_direction_label(job),
        "recipient_review": "",
        "source_direction": "",
        "contact_intelligence": comm_kit_contact_intelligence(job),
        "sms_options": sms_options,
        "email_options": email_options,
        "selected_sms_id": selected["selected_sms_id"],
        "selected_email_id": selected["selected_email_id"],
        "selector": selector,
    }


def selected_contact_review_lines(job: dict, comm_kit: dict) -> list[str]:
    intelligence = comm_kit.get("contact_intelligence") or comm_kit_contact_intelligence(job)
    lines = []
    summary = comm_kit_clean_line(intelligence.get("selected_summary") or comm_kit.get("recipient_review") or "")
    if summary:
        lines.append(f"- Recommended path: {summary}")
    for contact in (intelligence.get("ranked_contacts") or [])[:4]:
        if not isinstance(contact, dict):
            continue
        name = comm_kit_clean_line(contact.get("name") or "Unknown contact")
        parts = [name]
        for key in ("title", "record_type", "association_type"):
            value = comm_kit_clean_line(contact.get(key) or "")
            if value:
                parts.append(value)
        reason = comm_kit_clean_line(contact.get("reason") or "")
        line = f"- {' // '.join(parts)}"
        if reason:
            line += f": {reason}"
        lines.append(line)
    for address in (intelligence.get("address_options") or [])[:4]:
        if not isinstance(address, dict):
            continue
        name = comm_kit_clean_line(address.get("name") or "Address")
        value = comm_kit_clean_line(address.get("value") or "")
        reason = comm_kit_clean_line(address.get("reason") or "")
        if value:
            line = f"- {name}: {value}"
            if reason:
                line += f" ({reason})"
            lines.append(line)
    return lines[:9] or ["- Review the associated CRM contacts, phone numbers, emails, and addresses before outreach."]


def render_structured_comm_kit_document(job: dict, comm_kit: dict, local_prep: str) -> str:
    facts = source_fact_sheet(job)
    business_name = facts.get("client_visible_name") or facts.get("business_name") or "Client"
    current_date = facts.get("current_date") or now_iso()[:10]
    source_direction = comm_kit_clean_line(comm_kit.get("source_direction") or "")
    if not source_direction:
        source_direction = (
            "Use the associated CRM context, ranked recipient data, and campaign direction to make outreach useful, specific, and easy to review."
        )
    recipient_review = comm_kit_clean_line(comm_kit.get("recipient_review") or "")
    contact_lines = selected_contact_review_lines(job, comm_kit)
    sms_lines = []
    for option in comm_kit.get("sms_options", []) or []:
        sms_lines.append(f"{option.get('label') or option.get('id')}: {option.get('body')}")
    email_lines = []
    for option in comm_kit.get("email_options", []) or []:
        email_lines.append(f"{option.get('label') or option.get('id')}")
        email_lines.append(f"Subject: {option.get('subject')}")
        email_lines.append(f"Body: {option.get('body')}")

    return "\n\n".join([
        "WIZWIKI MARKETING",
        f"Copy Maker COMM KIT: {business_name}",
        f"{copy_maker_comm_kit_direction_label(job)} // {current_date}",
        "Source-Aware Copy Direction",
        source_direction,
        "Recipient & Address Review",
        recipient_review or "AUTOS ranked associated CRM contacts, phone numbers, emails, and addresses for human review before outreach.",
        "\n".join(contact_lines),
        "COMM KIT // Text Messages",
        "\n".join(sms_lines),
        "COMM KIT // Sales Emails",
        "\n\n".join(email_lines),
        "Usage Notes",
        "Review the recipient, phone, email, and address in COMMS LAB before pressing RUN COMMS. Aircall sending is staged separately and no message is sent from this document.",
    ]).strip()


def copy_maker_cloud_provider(job: dict) -> str:
    runtime = job.get("copy_maker", {}) or {}
    metadata = job.get("metadata", {}) or {}
    value = str(
        runtime.get("cloud_provider")
        or metadata.get("copy_maker_cloud_provider")
        or env("DOPE_COPY_MAKER_CLOUD_PROVIDER")
        or "nvidia"
    ).strip().lower()
    if value.startswith("qwen") or value in {"local", "local_qwen"}:
        return "qwen"
    return "openai" if value == "openai" else "nvidia"


def copy_maker_cloud_model(job: dict, provider: str | None = None) -> str:
    runtime = job.get("copy_maker", {}) or {}
    metadata = job.get("metadata", {}) or {}
    selected_provider = provider or copy_maker_cloud_provider(job)
    if selected_provider == "qwen":
        return str(
            env("DOPE_COPY_MAKER_QWEN_MODEL")
            or runtime.get("cloud_model")
            or metadata.get("copy_maker_cloud_model")
            or runtime.get("local_llm_model")
            or metadata.get("report_local_model")
            or env("DOPE_REPORT_LOCAL_MODEL")
            or "qwen3:8b"
        ).strip()

    if selected_provider == "openai":
        return str(
            env("DOPE_COPY_MAKER_OPENAI_MODEL")
            or runtime.get("cloud_model")
            or metadata.get("copy_maker_cloud_model")
            or env("OPENAI_MODEL")
            or "gpt-5.4"
        ).strip()

    return str(
        env("DOPE_COPY_MAKER_NVIDIA_MODEL")
        or runtime.get("cloud_model")
        or metadata.get("copy_maker_cloud_model")
        or "nvidia/nemotron-3-ultra-550b-a55b"
    ).strip()


def copy_maker_cloud_base_url(job: dict, provider: str | None = None) -> str:
    runtime = job.get("copy_maker", {}) or {}
    metadata = job.get("metadata", {}) or {}
    selected_provider = provider or copy_maker_cloud_provider(job)
    if selected_provider == "qwen":
        return str(env("OLLAMA_URL", "http://127.0.0.1:11434") or "http://127.0.0.1:11434").rstrip("/")

    if selected_provider == "openai":
        return str(
            env("DOPE_COPY_MAKER_OPENAI_BASE_URL")
            or runtime.get("cloud_base_url")
            or metadata.get("copy_maker_cloud_base_url")
            or "https://api.openai.com/v1"
        ).rstrip("/")

    return str(
        env("DOPE_COPY_MAKER_NVIDIA_BASE_URL")
        or runtime.get("cloud_base_url")
        or metadata.get("copy_maker_cloud_base_url")
        or "https://integrate.api.nvidia.com/v1"
    ).rstrip("/")


def ensure_copy_maker_usage_notes(job: dict, text: str) -> str:
    if not copy_maker_enabled(job):
        return text
    missing = {normalize_section_text(title) for title in missing_required_section_titles(job, text)}
    if "usage notes" not in missing:
        return text
    notes = (
        "\n\nUsage Notes\n\n"
        "- Review the selected contact, phone number, email address, and company details in COMMS LAB before sending.\n"
        "- Treat this as staged sales copy: edit for relationship context, timing, and current offer details.\n"
        "- No SMS, email, or Aircall action is sent from this document until a human approves the staged communication."
    )
    return sanitize_visible_report_text(f"{text.rstrip()}{notes}")


def copy_maker_api_key(job: dict, provider: str) -> tuple[str | None, str]:
    if provider == "qwen":
        return None, ""

    runtime = job.get("copy_maker", {}) or {}
    metadata = job.get("metadata", {}) or {}
    configured_env = str(runtime.get("api_key_env") or metadata.get("copy_maker_cloud_api_key_env") or "").strip()
    if configured_env:
        key = env(configured_env)
        if key:
            return key, configured_env

    if provider == "openai":
        return env("OPENAI_API_KEY"), "OPENAI_API_KEY"

    return env("NVIDIA_API_KEY") or env("NVIDIA_NIM_API_KEY"), "NVIDIA_API_KEY"


def copy_maker_local_prep_prompt(job: dict) -> str:
    retry_note = str(job.get("_alice_retry_note") or "").strip()
    package = report_prompt_input(job, retry_note=retry_note or None)
    return (
        "You are Alice local prep for WIZWIKI Copy Maker.\n"
        "Use the selected local embedder context and CRM/account payload to prepare a compact source-aware brief for a cloud copywriter.\n"
        "This is NOT the final customer document. Do not write hidden thinking, raw JSON, or generic filler.\n\n"
        "Return these sections only:\n"
        "## CRM Facts To Use\n"
        "## Audience And Offer Angle\n"
        "## Copy Requirements\n"
        "## Guardrails\n\n"
        "Guardrail: do not carry internal stage/status words like abandoned, SAM, HubSpot ID, workflow stage, or ticket status into final visible copy.\n\n"
        f"CUSTOM COPY MAKER PROMPT:\n{copy_maker_user_prompt(job)}\n\n"
        f"PAYLOAD:\n{package}"
    )


def copy_maker_final_prompt(job: dict, local_prep: str) -> str:
    contract = job.get("report_contract", {}) or {}
    required_sections = [section_title_value(section) for section in contract.get("required_sections", []) or []]
    retry_note = str(job.get("_alice_retry_note") or "").strip()
    comm_kit_rules = ""
    if copy_maker_comm_kit_enabled(job):
        comm_kit_rules = (
            "\nCOMM KIT FORMAT RULES:\n"
            f"{copy_maker_comm_kit_direction_rules(job)}"
            "- Include exactly these headings when COMM KIT is enabled: COMM KIT Text Messages, COMM KIT Sales Emails, Usage Notes.\n"
            "- Under COMM KIT Text Messages, write exactly 3 labeled text messages: Warm Check-In, Helpful Reminder, Clear Next-Step.\n"
            "- Keep each text message under 320 characters and make it ready to paste into Aircall/SMS staging.\n"
            "- Under COMM KIT Sales Emails, write exactly 2 friendly sales emails.\n"
            "- Each email must include a clear Subject: line and a Body: line.\n"
            "- Do not add model notes, process notes, unsupported stats, or fake urgency.\n"
        )
    return (
        "You are WIZWIKI Copy Maker creating the final visible copy document.\n"
        "Use the local source-aware brief and the custom prompt to write polished marketing copy.\n"
        "Do not expose hidden reasoning, API names, model names, prompt analysis, raw payload data, HubSpot IDs, or private metadata.\n"
        "Never use internal stage/status words like abandoned, SAM, workflow stage, ticket status, or HubSpot ID in the visible output.\n"
        "Return only visible Markdown for a DOCX document.\n"
        "Start exactly with WIZWIKI MARKETING.\n"
        "Include these section headings in this order when possible: "
        f"{', '.join(required_sections) if required_sections else 'Header, Source-Aware Copy Direction, Generated Copy, Usage Notes'}.\n"
        "If the custom prompt asks for postcard copy, email copy, ad copy, landing page copy, SMS, or a call script, put that actual copy under Generated Copy.\n"
        "If the custom prompt asks for billboards, SMS, text messages, headlines, taglines, slogans, CTAs, or yard signs, keep the copy short and do not pad it to report length.\n"
        "Keep the output practical, specific, reviewable, and client-ready.\n\n"
        f"CUSTOM COPY MAKER PROMPT:\n{copy_maker_user_prompt(job)}\n\n"
        f"{comm_kit_rules}\n"
        f"VALIDATION NOTE TO FIX:\n{retry_note or 'none'}\n\n"
        f"LOCAL SOURCE-AWARE BRIEF:\n{local_prep}\n\n"
        f"CONTRACT WRITING RULES:\n{json.dumps(contract.get('writing_rules', []), ensure_ascii=True)}\n\n"
        "Return final visible copy now."
    )


class NvidiaRequestError(RuntimeError):
    def __init__(self, http_code: int, message: str) -> None:
        super().__init__(f"NVIDIA HTTP {http_code}: {message}")
        self.http_code = http_code
        self.message = message


def nvidia_chat_completion(api_key: str, model: str, prompt: str, base_url: str) -> dict:
    max_tokens = bounded_int(env("DOPE_COPY_MAKER_NVIDIA_MAX_TOKENS"), 8192, 1024, 16384)
    reasoning_budget = bounded_int(env("DOPE_COPY_MAKER_NVIDIA_REASONING_BUDGET"), 8192, 0, 16384)
    body = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "temperature": float(env("DOPE_COPY_MAKER_NVIDIA_TEMPERATURE", "1")),
        "top_p": float(env("DOPE_COPY_MAKER_NVIDIA_TOP_P", "0.95")),
        "max_tokens": max_tokens,
        "stream": False,
        "chat_template_kwargs": {"enable_thinking": True},
        "reasoning_budget": reasoning_budget,
    }
    req = urllib.request.Request(
        f"{base_url}/chat/completions",
        data=json.dumps(body).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "User-Agent": "alice-dope-copy-maker-worker/1.0",
        },
        method="POST",
    )
    timeout = bounded_int(env("DOPE_COPY_MAKER_NVIDIA_TIMEOUT"), 900, 60, 1800)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        raw = error.read().decode(errors="replace")
        try:
            parsed = json.loads(raw)
            message = parsed.get("error", {}).get("message") or raw
        except json.JSONDecodeError:
            message = raw
        raise NvidiaRequestError(error.code, message[:1200]) from error


def extract_nvidia_text(parsed: dict) -> tuple[str, str | None]:
    choices = parsed.get("choices", []) or []
    if not choices:
        return "", None
    message = choices[0].get("message", {}) or {}
    content = message.get("content")
    if isinstance(content, list):
        text = "\n".join(str(item.get("text") if isinstance(item, dict) else item) for item in content if item)
    else:
        text = str(content or "")
    reasoning = message.get("reasoning_content")
    return text.strip(), str(reasoning).strip() if reasoning else None


def copy_maker_openai_response(api_key: str, model: str, prompt: str) -> tuple[dict, str]:
    effort = (
        env("DOPE_COPY_MAKER_OPENAI_REASONING")
        or env("DOPE_REPORT_OPENAI_REASONING")
        or "high"
    )
    max_tokens = bounded_int(env("DOPE_COPY_MAKER_OPENAI_MAX_OUTPUT_TOKENS"), 6000, 1024, 16000)
    parsed = openai_response(
        api_key=api_key,
        model=model,
        effort=effort,
        instructions=(
            "You are WIZWIKI Copy Maker. Return only polished visible client-ready Markdown. "
            "Do not reveal hidden reasoning, prompt analysis, raw CRM payloads, API names, or private metadata."
        ),
        input_text=prompt,
        max_tokens=max_tokens,
    )
    return parsed, effort


def call_copy_maker(job: dict) -> tuple[str, dict]:
    job_id = job.get("id")
    local_model = (local_model_candidates(job) or DEFAULT_LOCAL_MODEL_CANDIDATES)[0]
    provider = local_runtime_provider(local_model)
    if copy_maker_local_prep_required(job):
        log("copy_maker_local_prep_start", id=job_id, provider=provider, model=local_model, status=f"prompt_chars={len(copy_maker_user_prompt(job))}")
        local_parsed = ollama_report_response(local_model, copy_maker_local_prep_prompt(job))
        local_prep = sanitize_visible_report_text(str(local_parsed.get("response") or "")).strip()
        if not local_prep:
            raise RuntimeError("Copy Maker local prep returned empty text")
        log("copy_maker_local_prep_done", id=job_id, provider=provider, model=local_parsed.get("model") or local_model, status=f"words={word_count(local_prep)}")
    else:
        local_parsed = {"model": "none", "usage": {}, "prompt_eval_count": 0, "eval_count": 0}
        local_prep = (
            "Local LLM prep disabled by AI LAB. Use the custom Copy Maker prompt, report_contract, "
            "copy_maker runtime payload, CRM/source context, and selected embedder context directly."
        )
        log("copy_maker_local_prep_skipped", id=job_id, provider="payload", model="none", status="local_prep_required=false")

    cloud_provider = copy_maker_cloud_provider(job)
    model = copy_maker_cloud_model(job, cloud_provider)
    base_url = copy_maker_cloud_base_url(job, cloud_provider)
    final_prompt = copy_maker_final_prompt(job, local_prep)
    completion_provider = cloud_provider
    if cloud_provider == "qwen":
        log("copy_maker_qwen_start", id=job_id, provider="qwen/local", model=model, status=f"prompt_chars={len(final_prompt)}")
        parsed = ollama_report_response(model, final_prompt)
        report_text = sanitize_visible_report_text(str(parsed.get("response") or ""))
        if not report_text:
            raise RuntimeError("Qwen Copy Maker returned empty text")
        log("copy_maker_qwen_done", id=job_id, provider="qwen/local", model=parsed.get("model") or model, status=f"words={word_count(report_text)}")
        reasoning = None
        reasoning_effort = "local_qwen"
        completion_provider = "qwen/local"
    else:
        api_key, api_key_env = copy_maker_api_key(job, cloud_provider)
        if not api_key:
            raise RuntimeError(f"{api_key_env} is required for Copy Maker {cloud_provider} cloud completion")

        if cloud_provider == "openai":
            log("copy_maker_openai_start", id=job_id, provider="openai", model=model, status=f"prompt_chars={len(final_prompt)}")
            parsed, effort = copy_maker_openai_response(api_key, model, final_prompt)
            report_text = sanitize_visible_report_text(extract_openai_text(parsed))
            if not report_text:
                raise RuntimeError("OpenAI Copy Maker returned empty text")
            log("copy_maker_openai_done", id=job_id, provider="openai", model=parsed.get("model") or model, status=f"words={word_count(report_text)}")
            reasoning = None
            reasoning_effort = effort
        else:
            log("copy_maker_nvidia_start", id=job_id, provider="nvidia", model=model, status=f"prompt_chars={len(final_prompt)}")
            parsed = nvidia_chat_completion(api_key, model, final_prompt, base_url)
            report_text, reasoning = extract_nvidia_text(parsed)
            report_text = sanitize_visible_report_text(report_text)
            if not report_text:
                raise RuntimeError("NVIDIA Copy Maker returned empty text")
            log("copy_maker_nvidia_done", id=job_id, provider="nvidia", model=parsed.get("model") or model, status=f"words={word_count(report_text)}")
            reasoning_effort = "nvidia_thinking"

    report_text = sanitize_visible_report_text(report_text)
    comm_kit = build_comm_kit_manifest(job, report_text, local_model, local_prep)
    if copy_maker_comm_kit_enabled(job) and truthy(comm_kit.get("enabled")):
        report_text = sanitize_visible_report_text(render_structured_comm_kit_document(job, comm_kit, local_prep))
    report_text = ensure_copy_maker_usage_notes(job, report_text)
    return report_text, {
        "provider": completion_provider,
        "model": parsed.get("model") or model,
        "local_runtime_provider": provider,
        "local_model_family": local_model_family(local_parsed.get("model") or local_model),
        "usage": parsed.get("usage", {}),
        "reasoning_effort": reasoning_effort,
        "copy_maker": {
            "local_prep_model": local_parsed.get("model") or local_model,
            "local_prep_usage": {
                "prompt_eval_count": local_parsed.get("prompt_eval_count"),
                "eval_count": local_parsed.get("eval_count"),
                "total_duration": local_parsed.get("total_duration"),
                "load_duration": local_parsed.get("load_duration"),
            },
            "local_prep_words": word_count(local_prep),
            "local_prep_required": copy_maker_local_prep_required(job),
            "cloud_provider": cloud_provider,
            "cloud_base_url": base_url,
            "cloud_model": parsed.get("model") or model,
            "reasoning_captured": bool(reasoning),
            "comm_kit": comm_kit,
        },
    }


def ollama_report_response(model: str, prompt: str, on_progress=None) -> dict:
    base_url = str(env("OLLAMA_URL", "http://127.0.0.1:11434") or "http://127.0.0.1:11434").rstrip("/")
    max_tokens = int(env("DOPE_REPORT_LOCAL_MAX_TOKENS", "3600"))
    streaming = callable(on_progress)
    body = {
        "model": model,
        "prompt": prompt,
        "stream": streaming,
        "think": False,
        "options": {
            "temperature": float(env("DOPE_REPORT_LOCAL_TEMPERATURE", "0.28")),
            "top_k": int(env("DOPE_REPORT_LOCAL_TOP_K", "30")),
            "top_p": float(env("DOPE_REPORT_LOCAL_TOP_P", "0.86")),
            "repeat_penalty": float(env("DOPE_REPORT_LOCAL_REPEAT_PENALTY", "1.16")),
            "repeat_last_n": int(env("DOPE_REPORT_LOCAL_REPEAT_LAST_N", "256")),
            "num_ctx": int(env("DOPE_REPORT_LOCAL_CONTEXT", "16384")),
            "num_predict": max_tokens,
        },
    }
    req = urllib.request.Request(
        f"{base_url}/api/generate",
        data=json.dumps(body).encode("utf-8"),
        headers={"Content-Type": "application/json", "User-Agent": "alice-dope-market-report-worker/2.1"},
        method="POST",
    )
    timeout = int(env("DOPE_REPORT_LOCAL_TIMEOUT", "900"))
    with urllib.request.urlopen(req, timeout=timeout) as response:
        if not streaming:
            return json.loads(response.read().decode("utf-8"))

        response_parts = []
        thinking_parts = []
        final_payload = {}
        decoded_chunks = 0
        last_progress_at = 0.0
        progress_interval = max(float(env("DOPE_REPORT_STREAM_PROGRESS_SECONDS", "15") or "15"), 5.0)
        for raw_line in response:
            line = raw_line.decode("utf-8", errors="replace").strip()
            if not line:
                continue
            parsed = json.loads(line)
            text_chunk = str(parsed.get("response") or "")
            thinking_chunk = str(parsed.get("thinking") or "")
            if text_chunk:
                response_parts.append(text_chunk)
            if thinking_chunk:
                thinking_parts.append(thinking_chunk)
            if text_chunk or thinking_chunk:
                decoded_chunks += 1
            if parsed.get("done"):
                final_payload = parsed

            now = time.monotonic()
            if decoded_chunks and (now - last_progress_at >= progress_interval or parsed.get("done")):
                on_progress(decoded_chunks, max_tokens)
                last_progress_at = now

        final_payload["response"] = "".join(response_parts)
        if thinking_parts:
            final_payload["thinking"] = "".join(thinking_parts)
        return final_payload


def post_generation_review_prompt(job: dict, report_text: str) -> str:
    previous_draft = job.get("_alice_previous_draft")
    previous_errors = job.get("_alice_quality_errors")
    job["_alice_previous_draft"] = report_text
    job["_alice_quality_errors"] = [
        "post-review requested: tighten copy, improve specificity, preserve headings and tables, and remove generic filler"
    ]
    try:
        package = report_prompt_input(
            job,
            retry_note=(
                "POST REVIEW PASS. Lightly revise the current draft into stronger client-ready copy. "
                "Preserve the exact required section order and Markdown tables. Do not add unsupported percentages, "
                "internal notes, AI/model names, filenames, endpoints, or planning commentary."
            ),
        )
    finally:
        if previous_draft is None:
            job.pop("_alice_previous_draft", None)
        else:
            job["_alice_previous_draft"] = previous_draft
        if previous_errors is None:
            job.pop("_alice_quality_errors", None)
        else:
            job["_alice_quality_errors"] = previous_errors

    return (
        f"{report_generation_instructions(job)}\n\n"
        "POST REVIEW CONTRACT:\n"
        "- Return only the revised visible Markdown report.\n"
        "- Start exactly with WIZWIKI MARKETING.\n"
        "- Preserve all required section headings and required Markdown tables.\n"
        "- Improve clarity, rhythm, specificity, and sales-readiness without making the report longer than needed.\n"
        "- Do not add unsupported exact percentages or statistics.\n"
        "- Do not include filenames, endpoints, model names, worker names, prompt notes, or explanation of the task.\n\n"
        f"PAYLOAD:\n{package}\n\nReturn the revised visible report copy now."
    )


def run_post_generation_review(job: dict, report_text: str, model: str) -> tuple[str, dict]:
    if not report_post_review_enabled(job):
        return report_text, {"enabled": False}
    review_model = report_post_review_model(job, model)
    if not review_model:
        return report_text, {"enabled": False, "rejected_reason": "no post-review model configured"}

    job_id = job.get("id")
    provider = local_runtime_provider(review_model)
    log("post_review_start", id=job_id, provider=provider, model=review_model, status=f"words={word_count(report_text)}")
    try:
        parsed = ollama_report_response(review_model, post_generation_review_prompt(job, report_text))
        reviewed = sanitize_visible_report_text(str(parsed.get("response") or ""))
        reviewed = sanitize_unsupported_exact_stats(reviewed, job)
        reviewed = sanitize_past_timing_windows(reviewed, job)
        document_preview = full_document_text(job, reviewed)
        quality_errors = visible_text_quality_errors(document_preview, job)
        words = word_count(reviewed)
        if words < hard_minimum_words(job):
            quality_errors.append(f"post-review copy too short: {words} words")
        if quality_errors:
            log("post_review_rejected", id=job_id, provider=provider, model=parsed.get("model") or review_model, status="; ".join(quality_errors)[:160])
            return report_text, {
                "enabled": True,
                "accepted": False,
                "model": parsed.get("model") or review_model,
                "errors": quality_errors,
            }
        log("post_review_accepted", id=job_id, provider=provider, model=parsed.get("model") or review_model, status=f"words={words}")
        return reviewed, {
            "enabled": True,
            "accepted": True,
            "provider": provider,
            "model": parsed.get("model") or review_model,
            "usage": {
                "prompt_eval_count": parsed.get("prompt_eval_count"),
                "eval_count": parsed.get("eval_count"),
                "total_duration": parsed.get("total_duration"),
            },
            "word_count": words,
        }
    except Exception as error:
        log("post_review_error", id=job_id, provider=provider, model=review_model, status=f"{type(error).__name__}: {str(error)[:160]}")
        return report_text, {
            "enabled": True,
            "accepted": False,
            "model": review_model,
            "errors": [f"{type(error).__name__}: {str(error)[:180]}"],
        }


def strip_model_thinking(text: str) -> str:
    cleaned = re.sub(r"<think>.*?</think>", "", text or "", flags=re.I | re.S)
    # Some local reasoning models occasionally emit only a dangling closing tag.
    # In that case, everything before the final close tag is internal planning.
    if re.search(r"</think\s*>", cleaned, flags=re.I):
        cleaned = re.split(r"</think\s*>", cleaned, flags=re.I)[-1]
    cleaned = re.sub(r"</?think\s*>", "", cleaned, flags=re.I)
    cleaned = re.sub(r"^\s*```(?:markdown|md)?\s*", "", cleaned, flags=re.I)
    cleaned = re.sub(r"\s*```\s*$", "", cleaned)
    return cleaned.strip()


META_LEAK_PATTERNS = [
    r"\bwe are creating\b",
    r"\bthe visible document\b",
    r"\breport_contract\b",
    r"\bpayload specifies\b",
    r"\bfrom the payload\b",
    r"\bvisible markdown content\b",
    r"\bconverted to docx\b",
    r"\blet'?s structure\b",
    r"\bnow,?\s+we write\b",
    r"\bclient inputs\b",
    r"\bmissing inputs\b",
    r"\bwe have the following sections\b",
    r"\bwe are to write\b",
    r"\bimportant:\b",
    r"\bnote:\b",
    r"</?think\s*>",
]


def contains_meta_leak(text: str) -> bool:
    lowered = text or ""
    return any(re.search(pattern, lowered, flags=re.I) for pattern in META_LEAK_PATTERNS)


def sanitize_visible_report_text(text: str) -> str:
    cleaned = strip_model_thinking(text)
    cleaned = re.sub(r"\bDOPEIPEDIA\b", "WIZWIKI", cleaned, flags=re.I)
    cleaned = re.sub(r"\bDOPE\s+MARKETING\b", "WIZWIKI MARKETING", cleaned, flags=re.I)
    cleaned = re.sub(r"\bDOPE\s+BOLD\b", "WIZWIKI", cleaned, flags=re.I)
    cleaned = re.sub(r"\bDOPE\s+services\b", "WIZWIKI services", cleaned, flags=re.I)
    cleaned = re.sub(r"\bDVE\b", "AUTOS", cleaned, flags=re.I)
    starts = [match.start() for match in re.finditer(r"\bWIZWIKI MARKETING\b", cleaned, flags=re.I)]
    if len(starts) > 1 and contains_meta_leak(cleaned[: starts[1]]):
        cleaned = cleaned[starts[1]:]
    elif starts and starts[0] > 0 and contains_meta_leak(cleaned[: starts[0]]):
        cleaned = cleaned[starts[0]:]
    seen_brand_header = False
    deduped_lines = []
    for line in cleaned.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if re.match(r"^\s*(?:#{1,6}\s*)?(?:\*\*)?WIZWIKI MARKETING(?:\*\*)?\s*$", line, flags=re.I):
            if seen_brand_header:
                continue
            seen_brand_header = True
            deduped_lines.append("WIZWIKI MARKETING")
            continue
        deduped_lines.append(line)
    cleaned = "\n".join(deduped_lines)
    cleaned = re.sub(r"\bworkswith\b", "works with", cleaned, flags=re.I)
    cleaned = re.sub(r"[ \t]{2,}", " ", cleaned)
    return cleaned.strip()


def markdown_table_count(text: str) -> int:
    count = 0
    in_table = False
    for line in (text or "").splitlines():
        is_table_line = line.strip().startswith("|") and "|" in line.strip()[1:]
        if is_table_line and not in_table:
            count += 1
            in_table = True
        elif not is_table_line:
            in_table = False
    return count


def normalized_heading_title(line: str) -> str | None:
    raw = line or ""
    cleaned = re.sub(r"^\s*#{1,6}\s*", "", raw)
    cleaned = re.sub(r"^\s*[-*_]{3,}\s*$", "", cleaned).strip()
    cleaned = re.sub(r"[:\s]+$", "", cleaned).strip()
    if not cleaned or len(cleaned) > 90:
        return None
    if re.search(r"[.!?]\s+", cleaned):
        return None
    if re.match(r"^(WIZWIKI MARKETING|Header / Cover|Executive Summary|Market Snapshot|Seasonality Timeline|Recommended Campaign|Campaign Recommendation|Channel Strategy|Neighborhood Targeting|Offer Strategy|Timeline / Launch Plan|Final Recommendation|Best Opportunity Callout|Big Stat Cards|Customer Mindset|Buying Triggers|Why Print/Direct Mail Fits|Offer Card \d+)$", cleaned, flags=re.I):
        return cleaned.lower()
    return None


def duplicate_heading_titles(text: str) -> list[str]:
    seen: set[str] = set()
    duplicates: list[str] = []
    for line in (text or "").splitlines():
        title = normalized_heading_title(line)
        if not title:
            continue
        if title in seen and title not in duplicates:
            duplicates.append(title)
        seen.add(title)
    return duplicates


def empty_heading_titles(text: str) -> list[str]:
    lines = (text or "").splitlines()
    empties: list[str] = []
    for index, line in enumerate(lines):
        title = normalized_heading_title(line)
        if not title:
            continue
        if title == "dope marketing":
            continue
        following = []
        for next_line in lines[index + 1:index + 4]:
            stripped = next_line.strip()
            if stripped in {"---", "--", "___"}:
                continue
            following.append(stripped)
        if not any(following) or any(normalized_heading_title(item) for item in following[:1]):
            empties.append(title)
    return empties


def unsupported_exact_stats(text: str, job: dict) -> list[str]:
    source_blob = json.dumps(
        {
            "deal": job.get("deal", {}),
            "company": job.get("company", {}),
            "commerce": job.get("commerce", {}),
            "campaign_context": job.get("campaign_context", {}),
            "hubspot_context": job.get("hubspot_context", {}),
            "account_graph": job.get("account_graph", {}),
        },
        ensure_ascii=False,
        default=str,
    )
    found = []
    for match in re.finditer(r"(?<![\w.])\d+(?:\.\d+)?\s*%", text or ""):
        stat = re.sub(r"\s+", "", match.group(0))
        if stat not in source_blob.replace(" ", ""):
            found.append(stat)
    return sorted(set(found))


def sanitize_unsupported_exact_stats(text: str, job: dict) -> str:
    cleaned = str(text or "")
    for stat in unsupported_exact_stats(cleaned, job):
        spaced = re.sub(r"(?<=\d)(?=%)", r"\\s*", re.escape(stat))
        stat_pattern = rf"(?<![\w.])(?:{re.escape(stat)}|{spaced})(?![\w.])"
        cleaned = re.sub(rf"{stat_pattern}\s*(?:off|discount|savings)\b(?:\s+(?:your|the)\s+first\s+service)?", "a clear first-service offer", cleaned, flags=re.I)
        cleaned = re.sub(rf"{stat_pattern}\s+of\s+customers\b", "many local customers", cleaned, flags=re.I)
        cleaned = re.sub(rf"{stat_pattern}\s+(?:higher|better|more)\s+(?:response|conversion|lift|growth)\b", "stronger trackable response", cleaned, flags=re.I)
        cleaned = re.sub(rf"{stat_pattern}\s+(?:response|conversion|growth|lift|increase|improvement)\b", "trackable response", cleaned, flags=re.I)
        cleaned = re.sub(stat_pattern, "trackable", cleaned, flags=re.I)
    cleaned = re.sub(r"\btrackable\s+(?:increase|lift|response|conversion|growth|improvement)\b", "trackable lift", cleaned, flags=re.I)
    cleaned = re.sub(r"\btrackable\s*-\s*trackable\b", "trackable", cleaned, flags=re.I)
    cleaned = re.sub(r"\b(?:measurable|trackable)\s+of\s+customers\b", "many local customers", cleaned, flags=re.I)
    cleaned = re.sub(r"\b(?:measurable|trackable)\s+off\b(?:\s+(?:your|the)\s+first\s+service)?", "a clear first-service offer", cleaned, flags=re.I)
    return cleaned


def display_date(value: str | None) -> str:
    parsed = parse_iso_date(value)
    if not parsed:
        return str(value or "").strip()
    return parsed.strftime("%B %-d, %Y") if sys.platform != "win32" else parsed.strftime("%B %#d, %Y")


def visible_placeholder_markers(text: str, job: dict) -> list[str]:
    markers = []
    cleaned = text or ""
    facts = source_fact_sheet(job)
    inferred = str(facts.get("inferred_industry") or "").strip().lower()
    if re.search(r"\byour local service area\b|\blocal service area\b", cleaned, flags=re.I):
        markers.append("generic service-area placeholder")
    if re.search(r"\bmeasurable\s+(?:of|off|higher|response|conversion|growth|lift|increase|improvement)\b", cleaned, flags=re.I):
        markers.append("measurable placeholder wording")
    if inferred and inferred != "local service business" and re.search(r"\bindustry\s*:\s*local service business\b", cleaned, flags=re.I):
        markers.append("generic industry header despite inferred industry")
    brand_mentions = len(re.findall(r"^\s*(?:#\s*)?WIZWIKI MARKETING\s*$", cleaned, flags=re.I | re.M))
    if brand_mentions > 1:
        markers.append("duplicate WIZWIKI MARKETING header")
    if re.search(r"^\s*Client Strategy Proposal\s*$", cleaned, flags=re.I | re.M):
        markers.append("legacy Client Strategy Proposal heading")
    return markers


def parse_iso_date(value: str | None):
    try:
        return dt.date.fromisoformat(str(value or "")[:10])
    except ValueError:
        return None


MONTH_NAME_TO_NUMBER = {
    "january": 1,
    "february": 2,
    "march": 3,
    "april": 4,
    "may": 5,
    "june": 6,
    "july": 7,
    "august": 8,
    "september": 9,
    "october": 10,
    "november": 11,
    "december": 12,
}


def past_timing_markers(text: str, job: dict) -> list[str]:
    timing = report_timing_context(job)
    current_date = parse_iso_date(timing.get("authoritative_current_date"))
    if not current_date:
        return []
    markers = []
    timing_words = r"launch|mail|drop|start|begin|production|print|timing|response|campaign"
    for match in re.finditer(
        r"\b(?:early|mid|late)?\s*(january|february|march|april|may|june|july|august|september|october|november|december)\b",
        text or "",
        flags=re.I,
    ):
        month = MONTH_NAME_TO_NUMBER.get(match.group(1).lower())
        if not month or month >= current_date.month:
            continue
        window = (text or "")[max(0, match.start() - 90): match.end() + 90]
        if re.search(timing_words, window, flags=re.I):
            label = re.sub(r"\s+", " ", match.group(0)).strip()
            if label not in markers:
                markers.append(label)
    return markers


def sanitize_past_timing_windows(text: str, job: dict) -> str:
    timing = report_timing_context(job)
    replacement = display_date(timing.get("earliest_production_ready_date")) or "the next practical production window"
    cleaned = str(text or "")
    for marker in past_timing_markers(cleaned, job):
        marker_pattern = re.escape(marker).replace(r"\ ", r"\s+")
        cleaned = re.sub(rf"\b(in|by|during|for)\s+{marker_pattern}\b", f"after {replacement}", cleaned, flags=re.I)
        cleaned = re.sub(rf"\b{marker_pattern}\b", f"after {replacement}", cleaned, flags=re.I)
    cleaned = re.sub(r"\blaunch\s+in\s+after\b", "launch after", cleaned, flags=re.I)
    cleaned = re.sub(r"\bmail\s+in\s+after\b", "mail after", cleaned, flags=re.I)
    cleaned = re.sub(r"\bdrop\s+in\s+after\b", "drop after", cleaned, flags=re.I)
    return cleaned


def visible_client_forbidden_terms(text: str) -> list[str]:
    terms = []
    patterns = {
        "abandoned": r"\babandoned\b",
        "sam": r"\bSAM\b",
        "hubspot id": r"\bHubSpot\s+ID\b|\bhs_[a-z0-9_]+\b",
        "internal status": r"\bChecklist Not Completed\b|\bDesign Uploaded\b|\bWaiting for Approval\b|\bDemo Call Scheduled\b",
        "ai/model mention": r"\bAlice\b|\bQwen\b|\bOpenAI\b|\bOllama\b|\bMLX\b",
    }
    for label, pattern in patterns.items():
        if re.search(pattern, text or "", flags=re.I):
            terms.append(label)
    return terms


def generic_report_markers(text: str, job: dict) -> list[str]:
    markers = []
    company_name = str((job.get("company") or {}).get("name") or (job.get("deal") or {}).get("company_name") or "").strip()
    business_name = str((job.get("report_contract") or {}).get("client", {}).get("business_name") or company_name).strip()
    visible_name = business_name or company_name
    visible_variants = [
        visible_name,
        re.sub(r"^\s*New Signup\s*-\s*", "", visible_name, flags=re.I),
    ]
    if visible_name and not any(variant and variant.lower() in (text or "").lower() for variant in visible_variants):
        markers.append("client name missing")
    industry = inferred_industry(job)
    if industry and industry.lower() != "local service business" and not industry_present_in_text(industry, text):
        markers.append("specific industry missing")
    if re.search(r"\blocal service business\b", text or "", flags=re.I) and industry and industry.lower() not in {"", "local service business"}:
        markers.append("generic local service business wording")
    return markers


def industry_present_in_text(industry: str, text: str) -> bool:
    lowered = (text or "").lower()
    industry_lower = str(industry or "").lower()
    if industry_lower in lowered:
        return True
    parts = [part.strip() for part in re.split(r"\s*(?:/|&|\band\b|,)\s*", industry_lower) if part.strip()]
    return any(len(part) >= 4 and part in lowered for part in parts)


def visible_text_quality_errors(text: str, job: dict) -> list[str]:
    errors = []
    cleaned = text or ""
    audience = report_audience(job)
    if contains_meta_leak(cleaned):
        errors.append("visible copy contains model planning or prompt echo")
    if audience == "copy_maker":
        duplicate_headings = duplicate_heading_titles(cleaned)
        if duplicate_headings:
            errors.append(f"visible copy repeats section headings: {', '.join(duplicate_headings[:5])}")
        empty_headings = empty_heading_titles(cleaned)
        if empty_headings:
            errors.append(f"visible copy has empty section headings: {', '.join(empty_headings[:5])}")
        return errors
    if not re.match(r"^\s*(#\s*)?(\*\*)?WIZWIKI MARKETING\b", cleaned, flags=re.I):
        errors.append("visible copy does not start with WIZWIKI MARKETING")
    required_tables = job.get("report_contract", {}).get("required_tables", []) or []
    expected_table_count = min(len(required_tables), bounded_int(env("DOPE_REPORT_MAX_REQUIRED_TABLES"), 2, 1, 4))
    if audience != "am" and expected_table_count >= 2 and markdown_table_count(cleaned) < expected_table_count:
        errors.append(f"visible client report is missing required Markdown tables: expected at least {expected_table_count} table(s)")
    missing_sections = missing_required_section_titles(job, cleaned)
    if missing_sections:
        label = "internal AM brief" if audience == "am" else "client report"
        errors.append(f"visible {label} is missing required sections: {', '.join(missing_sections)}")
    duplicate_headings = duplicate_heading_titles(cleaned)
    if duplicate_headings:
        errors.append(f"visible copy repeats section headings: {', '.join(duplicate_headings[:5])}")
    empty_headings = empty_heading_titles(cleaned)
    if empty_headings:
        errors.append(f"visible copy has empty section headings: {', '.join(empty_headings[:5])}")
    if audience != "am":
        forbidden_terms = visible_client_forbidden_terms(cleaned)
        if forbidden_terms:
            errors.append(f"visible client report leaks internal language: {', '.join(forbidden_terms)}")
        fake_stats = unsupported_exact_stats(cleaned, job)
        if fake_stats:
            errors.append(f"visible client report includes unsupported exact percentages/statistics: {', '.join(fake_stats[:6])}")
        placeholder_markers = visible_placeholder_markers(cleaned, job)
        if placeholder_markers:
            errors.append(f"visible client report contains generic placeholders: {', '.join(placeholder_markers)}")
        past_timing = past_timing_markers(cleaned, job)
        if past_timing:
            errors.append(f"visible client report recommends past timing windows: {', '.join(past_timing[:4])}")
        generic_markers = generic_report_markers(cleaned, job)
        if generic_markers:
            errors.append(f"visible client report is too generic: {', '.join(generic_markers)}")
    return errors


def structural_quality_errors(errors: list[str]) -> bool:
    text = " ".join(str(error or "").lower() for error in errors)
    return any(
        marker in text
        for marker in [
            "missing required markdown tables",
            "missing required sections",
            "does not start with wizwiki marketing",
            "prompt echo",
            "model planning",
            "unsupported exact percentages",
            "generic placeholders",
            "past timing windows",
            "leaks internal language",
            "empty section headings",
            "repeats section headings",
            "too generic",
        ]
    )


def local_model_attempt_limit(job: dict, errors: list[str], default_attempts: int) -> int:
    if not errors or not structural_quality_errors(errors):
        return default_attempts
    return bounded_int(env("DOPE_REPORT_STRUCTURAL_ATTEMPTS_PER_MODEL"), 3, 1, default_attempts)


def call_local_ollama(job: dict, progress_callback=None) -> tuple[str, dict]:
    target_minimum = minimum_words(job)
    hard_minimum = hard_minimum_words(job)
    job_id = job.get("id")
    primary_prompt = job.get("generation_prompt") or job.get("report_contract", {}).get("llm_prompt") or job.get("report_contract", {}).get("requested_output") or job.get("title") or ""
    input_text = report_prompt_input(job)
    log(
        "generation_prompt",
        id=job_id,
        provider="ollama/local",
        status=f"context_chars={len(input_text)} prompt={clip(primary_prompt, 260)}",
    )

    last_error = None
    for model in local_model_candidates(job):
        provider = local_runtime_provider(model)
        try:
            report_text = ""
            parsed = {}
            quality_errors = []
            best_under_target = None
            retry_note = job.pop("_alice_retry_note", None)
            attempts = local_attempt_count()
            for attempt in range(1, attempts + 1):
                log("local_request", id=job_id, provider=provider, model=model, status=f"attempt={attempt} target_words={target_minimum} hard_min_words={hard_minimum}")
                parsed = ollama_report_response(
                    model,
                    local_report_prompt(job, retry_note=retry_note),
                    on_progress=progress_callback,
                )
                report_text = sanitize_visible_report_text(str(parsed.get("response") or ""))
                report_text = sanitize_unsupported_exact_stats(report_text, job)
                report_text = sanitize_past_timing_windows(report_text, job)
                document_preview = full_document_text(job, report_text)
                quality_errors = visible_text_quality_errors(document_preview, job)
                words = word_count(report_text)
                if words >= target_minimum and not quality_errors:
                    break
                if words >= hard_minimum and not quality_errors:
                    best_under_target = {
                        "attempt": attempt,
                        "parsed": parsed,
                        "report_text": report_text,
                        "words": words,
                    }
                if attempt == attempts and best_under_target:
                    parsed = best_under_target["parsed"]
                    report_text = best_under_target["report_text"]
                    quality_errors = []
                    log(
                        "local_under_target_accepted",
                        id=job_id,
                        provider=provider,
                        model=parsed.get("model") or model,
                        status=f"attempt={best_under_target['attempt']} words={best_under_target['words']} target_words={target_minimum} hard_min_words={hard_minimum}",
                    )
                    break

                job["_alice_previous_draft"] = report_text
                job["_alice_quality_errors"] = quality_errors
                retry_note = local_retry_note(job, report_text, quality_errors, target_minimum)
                model_attempt_limit = local_model_attempt_limit(job, quality_errors, attempts)
                abandon_model = quality_errors and attempt >= model_attempt_limit
                event = "local_candidate_failed" if abandon_model or attempt >= attempts else "local_retry"
                log(
                    event,
                    id=job_id,
                    provider=provider,
                    model=parsed.get("model") or model,
                    status=f"attempt={attempt} words={words} target_words={target_minimum} hard_min_words={hard_minimum} errors={'; '.join(quality_errors)[:120]}",
                )
                if abandon_model and best_under_target:
                    parsed = best_under_target["parsed"]
                    report_text = best_under_target["report_text"]
                    quality_errors = []
                    log(
                        "local_under_target_accepted",
                        id=job_id,
                        provider=provider,
                        model=parsed.get("model") or model,
                        status=(
                            f"attempt={best_under_target['attempt']} words={best_under_target['words']} "
                            f"target_words={target_minimum} hard_min_words={hard_minimum} "
                            "reason=best_clean_candidate_after_structural_retry"
                        ),
                    )
                    break
                if abandon_model:
                    raise RuntimeError(
                        f"local Ollama structural preflight failed after {attempt} attempts: "
                        f"words={words}, hard_minimum={hard_minimum}, target_words={target_minimum}, errors={'; '.join(quality_errors)}"
                    )

            words = word_count(report_text)
            if words < hard_minimum or quality_errors:
                raise RuntimeError(
                    f"local Ollama preflight failed after {attempts} attempts: "
                    f"words={words}, hard_minimum={hard_minimum}, target_words={target_minimum}, errors={'; '.join(quality_errors) or 'too short'}"
                )

            if not report_text:
                raise RuntimeError("local Ollama returned empty report text")

            final_model = parsed.get("model") or model
            report_text, post_review_meta = run_post_generation_review(job, report_text, final_model)

            log(
                "local_response",
                id=job_id,
                provider=provider,
                model=final_model,
                status=f"words={word_count(report_text)}",
            )
            return report_text, {
                "provider": provider,
                "model": final_model,
                "local_runtime_provider": "ollama/local",
                "local_model_family": local_model_family(final_model),
                "usage": {
                    "prompt_eval_count": parsed.get("prompt_eval_count"),
                    "eval_count": parsed.get("eval_count"),
                    "total_duration": parsed.get("total_duration"),
                    "load_duration": parsed.get("load_duration"),
                },
                "post_review": post_review_meta,
                "reasoning_effort": "local",
            }
        except Exception as error:
            last_error = error
            log("local_candidate_failed", id=job_id, provider=provider, model=model, status=f"{type(error).__name__}: {str(error)[:160]}")
            continue

    raise RuntimeError(f"all local Ollama candidates failed: {last_error}")


def generate_report_text(job: dict, progress_callback=None) -> tuple[str, dict]:
    log(
        "audience_detected",
        id=job.get("id"),
        status=f"audience={report_audience(job)} copy_maker={copy_maker_enabled(job)}",
    )
    if copy_maker_enabled(job):
        return call_copy_maker(job)
    if not local_report_required(job):
        log("forcing_local_report", id=job.get("id"), provider="ollama/local", status="DOPE reports are local-only")
    return call_local_ollama(job, progress_callback=progress_callback)

def call_openai(job: dict) -> tuple[str, dict]:
    api_key = env("OPENAI_API_KEY")
    if not api_key:
        raise RuntimeError("OPENAI_API_KEY is required for DOPE market reports")

    minimum = minimum_words(job)
    max_tokens = int(env("DOPE_REPORT_OPENAI_MAX_OUTPUT_TOKENS", "6000"))
    max_tokens = max(2500, min(max_tokens, 12000))

    instructions = report_generation_instructions()

    job_id = job.get("id")
    contract = job.get("report_contract", {}) or {}
    primary_prompt = job.get("generation_prompt") or contract.get("llm_prompt") or contract.get("requested_output") or job.get("title") or ""
    input_text = report_prompt_input(job)
    log(
        "generation_prompt",
        id=job_id,
        provider="openai",
        status=f"context_chars={len(input_text)} prompt={clip(primary_prompt, 260)}",
    )

    last_error = None
    for model in openai_model_candidates():
        for effort in reasoning_effort_candidates():
            try:
                log("openai_request", id=job_id, provider="openai", model=model, status=f"effort={effort} max_tokens={max_tokens}")
                parsed = openai_response(
                    api_key=api_key,
                    model=model,
                    effort=effort,
                    instructions=instructions,
                    input_text=input_text,
                    max_tokens=max_tokens,
                )
                report_text = sanitize_visible_report_text(extract_openai_text(parsed))
                report_text = sanitize_unsupported_exact_stats(report_text, job)
                report_text = sanitize_past_timing_windows(report_text, job)
                if word_count(report_text) < minimum:
                    log(
                        "openai_retry",
                        id=job_id,
                        provider="openai",
                        model=parsed.get("model") or model,
                        status=f"words={word_count(report_text)} minimum={minimum}",
                    )
                    parsed = openai_response(
                        api_key=api_key,
                        model=model,
                        effort=effort,
                        instructions=instructions,
                        input_text=report_prompt_input(
                            job,
                            retry_note=f"The previous draft was only {word_count(report_text)} words. Rewrite and expand to at least {minimum} words while preserving all required sections.",
                        ),
                        max_tokens=max(max_tokens, 20000),
                    )
                    report_text = sanitize_visible_report_text(extract_openai_text(parsed))
                    report_text = sanitize_unsupported_exact_stats(report_text, job)
                    report_text = sanitize_past_timing_windows(report_text, job)

                if not report_text:
                    raise RuntimeError("OpenAI returned empty report text")

                log(
                    "openai_response",
                    id=job_id,
                    provider="openai",
                    model=parsed.get("model") or model,
                    status=f"words={word_count(report_text)} effort={effort}",
                )
                return report_text, {
                    "provider": "openai",
                    "model": parsed.get("model") or model,
                    "usage": parsed.get("usage", {}),
                    "reasoning_effort": effort,
                }
            except OpenAIRequestError as error:
                last_error = error
                log("openai_candidate_failed", model=model, status=f"{error.http_code}: {error.message[:140]}")
                if error.http_code in {401, 403, 429}:
                    raise
                continue

    raise RuntimeError(f"all OpenAI model/effort candidates failed: {last_error}")


class OpenAIRequestError(RuntimeError):
    def __init__(self, http_code: int, message: str) -> None:
        super().__init__(f"OpenAI HTTP {http_code}: {message}")
        self.http_code = http_code
        self.message = message


def openai_response(api_key: str, model: str, effort: str, instructions: str, input_text: str, max_tokens: int) -> dict:
    body = {
        "model": model,
        "instructions": instructions,
        "input": input_text,
        "reasoning": {"effort": effort},
        "text": {"verbosity": "high"},
        "max_output_tokens": max_tokens,
    }
    req = urllib.request.Request(
        "https://api.openai.com/v1/responses",
        data=json.dumps(body).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "User-Agent": "alice-dope-market-report-worker/2.0",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=360) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        raw = error.read().decode(errors="replace")
        try:
            parsed = json.loads(raw)
            message = parsed.get("error", {}).get("message") or raw
        except json.JSONDecodeError:
            message = raw
        raise OpenAIRequestError(error.code, message[:1200]) from error


def openai_image_generation(api_key: str, model: str, prompt: str, size: str, quality: str, output_format: str = "jpeg") -> dict:
    body = {
        "model": model,
        "prompt": prompt,
        "size": size,
        "quality": quality,
        "output_format": output_format,
    }
    req = urllib.request.Request(
        "https://api.openai.com/v1/images/generations",
        data=json.dumps(body).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "User-Agent": "alice-dope-market-report-worker/design-press",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=360) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        raw = error.read().decode(errors="replace")
        try:
            parsed = json.loads(raw)
            message = parsed.get("error", {}).get("message") or raw
        except json.JSONDecodeError:
            message = raw
        raise OpenAIRequestError(error.code, message[:1200]) from error


def extract_openai_text(parsed: dict) -> str:
    texts = []
    if isinstance(parsed.get("output_text"), str):
        texts.append(parsed["output_text"])
    for item in parsed.get("output", []) or []:
        for content in item.get("content", []) or []:
            if isinstance(content, str):
                texts.append(content)
            elif isinstance(content, dict):
                if isinstance(content.get("text"), str):
                    texts.append(content["text"])
                elif isinstance(content.get("text"), dict) and isinstance(content["text"].get("value"), str):
                    texts.append(content["text"]["value"])
    return "\n".join(text.strip() for text in texts if text and text.strip())


def parse_report_json(text: str) -> dict:
    cleaned = text.strip()
    match = re.search(r"```(?:json)?\s*(.*?)```", cleaned, re.S | re.I)
    if match:
        cleaned = match.group(1).strip()
    try:
        return json.loads(cleaned)
    except json.JSONDecodeError:
        return {"executive_summary": cleaned}



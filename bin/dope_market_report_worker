def load_env_files() -> None:
    for path in [
        Path.home() / "Desktop" / "alice-brain" / ".env",
        Path.home() / ".config" / "alice-brain" / "node.env",
        Path.home() / ".config" / "autos" / "alice.env",
        Path.home() / ".config" / "autos" / "dope.env",
        Path.home() / "Desktop" / "PB" / ".env.alice",
    ]:
        if not path.exists():
            continue
        try:
            lines = path.read_text(errors="ignore").splitlines()
        except OSError:
            continue
        for raw_line in lines:
            line = raw_line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip().strip('"').strip("'")
            if key and not os.environ.get(key):
                os.environ[key] = value


def env(name: str, default: str | None = None) -> str | None:
    value = os.environ.get(name)
    return value if value not in (None, "") else default


def env_list(name: str) -> list[str]:
    value = env(name, "")
    return [item.strip() for item in re.split(r"[\s,]+", value or "") if item.strip()]


def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).astimezone().isoformat(timespec="seconds")


def log(event: str, **data) -> None:
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    record = {"time": now_iso(), "event": event, **data}
    with LOG_PATH.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, ensure_ascii=True) + "\n")
    printable = " ".join(f"{key}={value}" for key, value in data.items() if key in {"id", "status", "queued", "provider", "model"})
    print(f"[dope_report_worker] {record['time']} {event} {printable}".rstrip(), flush=True)


def ollama_visible_text(parsed: dict) -> str:
    message = parsed.get("message") if isinstance(parsed.get("message"), dict) else {}
    return str(parsed.get("response") or message.get("content") or parsed.get("thinking") or "").strip()


def require_token() -> str:
    token = env("DOPE_REPORT_WORKER_TOKEN") or env("AUTOS_WORKER_TOKEN")
    if not token:
        raise RuntimeError("DOPE_REPORT_WORKER_TOKEN or AUTOS_WORKER_TOKEN is required")
    return token


def node_maza_address() -> str:
    return str(env("MAZA_ADDRESS", "") or "").strip()


def node_id(default: str = DEFAULT_WORKER_ID) -> str:
    return str(env("ALICE_NODE_ID", env("NODE_ID", default)) or default).strip()


class DopeClient:
    def __init__(self, worker_id: str | None = None) -> None:
        self.base_url = (env("DOPE_REPORT_WORKER_BASE_URL") or env("DOPE_WORKER_BASE_URL") or DEFAULT_BASE_URL).rstrip("/")
        self.worker_id = worker_id or env("DOPE_REPORT_WORKER_ID", node_id(DEFAULT_WORKER_ID))
        self.token = require_token()

    def request(self, method: str, path: str, body: bytes | None = None, headers: dict[str, str] | None = None, timeout: int | None = None):
        url = f"{self.base_url}{path}"
        request_headers = {
            "Authorization": f"Bearer {self.token}",
            "X-Dope-Worker-Id": self.worker_id,
            "User-Agent": "alice-dope-market-report-worker/1.0",
        }
        if node_maza_address():
            request_headers["X-Alice-Maza-Address"] = node_maza_address()
        request_headers.update(headers or {})
        req = urllib.request.Request(url, data=body, headers=request_headers, method=method)
        request_timeout = timeout or int(env("DOPE_REPORT_HTTP_TIMEOUT", "180"))
        try:
            with urllib.request.urlopen(req, timeout=request_timeout) as response:
                return response.status, response.headers, response.read()
        except urllib.error.HTTPError as error:
            return error.code, error.headers, error.read()

    def status(self) -> dict:
        code, _headers, body = self.request("GET", "/dope_worker/report_status")
        if code != 200:
            raise RuntimeError(f"status failed HTTP {code}: {body.decode(errors='replace')[:300]}")
        return json.loads(body.decode("utf-8"))

    def next_report(self) -> dict | None:
        code, _headers, body = self.request("POST", "/dope_worker/reports/next", body=b"")
        if code == 204:
            return None
        if code != 200:
            raise RuntimeError(f"next report failed HTTP {code}: {body.decode(errors='replace')[:300]}")
        return json.loads(body.decode("utf-8"))

    def recent_reports(self, limit: int = 25) -> list[dict]:
        code, _headers, body = self.request("GET", f"/dope_worker/reports/recent?limit={int(limit)}")
        if code != 200:
            raise RuntimeError(f"recent reports failed HTTP {code}: {body.decode(errors='replace')[:300]}")
        parsed = json.loads(body.decode("utf-8"))
        return parsed.get("reports", []) or []

    def fetch_logo(self, job: dict) -> tuple[bytes, str, str] | None:
        for source, endpoint in logo_candidates(job):
            code, headers, body = self.fetch_asset(endpoint)
            if code == 204 or not body:
                continue
            if code not in (200, 302):
                log("logo_skipped", id=job.get("id"), status=f"{source}_http_{code}")
                continue
            if len(body) > MAX_LOGO_BYTES:
                log("logo_skipped", id=job.get("id"), status=f"{source}_too_large")
                continue
            content_type = headers.get("Content-Type", "").split(";")[0].strip().lower()
            ext = image_extension(body, content_type)
            if ext not in {"png", "jpg", "jpeg", "gif"}:
                log("logo_skipped", id=job.get("id"), status=f"{source}_unsupported_{content_type or 'unknown'}")
                continue
            return body, "jpg" if ext == "jpeg" else ext, source
        return None

    def fetch_report_images(self, job: dict, logo: tuple | None = None) -> tuple[list[dict], list[str]]:
        limit = bounded_int(env("DOPE_REPORT_MAX_EMBEDDED_MEDIA_IMAGES"), 4, 0, 8)
        if limit <= 0:
            return [], []

        errors: list[str] = []
        images: list[dict] = []
        seen_digests = set()
        if logo:
            seen_digests.add(hashlib.sha256(logo[0]).hexdigest())

        for item in job.get("assets", {}).get("uploaded_media", []) or []:
            if len(images) >= limit:
                break
            content_type = str(item.get("content_type") or "").split(";")[0].strip().lower()
            if not content_type.startswith("image/"):
                continue
            endpoint = item.get("endpoint")
            if not endpoint:
                continue

            code, headers, body = self.fetch_asset(endpoint)
            label = str(item.get("filename") or item.get("id") or endpoint)
            if code == 204 or not body:
                errors.append(f"{label}: empty")
                continue
            if code not in (200, 302):
                errors.append(f"{label}: http_{code}")
                continue
            if len(body) > MAX_LOGO_BYTES:
                errors.append(f"{label}: too_large")
                continue
            response_type = headers.get("Content-Type", content_type).split(";")[0].strip().lower()
            ext = image_extension(body, response_type)
            if ext not in {"png", "jpg", "jpeg", "gif"}:
                errors.append(f"{label}: unsupported_{response_type or content_type or 'unknown'}")
                continue

            digest = hashlib.sha256(body).hexdigest()
            if digest in seen_digests:
                continue
            seen_digests.add(digest)
            width, height = image_size(body)
            images.append(
                {
                    "bytes": body,
                    "ext": "jpg" if ext == "jpeg" else ext,
                    "source": "uploaded_media",
                    "filename": label,
                    "role": item.get("role") or "supporting_media",
                    "endpoint": endpoint,
                    "content_type": response_type or content_type,
                    "byte_size": len(body),
                    "width": width,
                    "height": height,
                }
            )

        if images:
            log("media_images_ready", id=job.get("id"), status=f"embedded={len(images)} skipped={len(errors)}")
        elif errors:
            log("media_images_skipped", id=job.get("id"), status="; ".join(errors[:4]))
        return images, errors

    def fetch_asset(self, endpoint: str):
        if not endpoint:
            return 204, {}, b""
        if endpoint.startswith("http://") or endpoint.startswith("https://"):
            req = urllib.request.Request(endpoint, headers={"User-Agent": "alice-dope-market-report-worker/1.0"})
            try:
                with urllib.request.urlopen(req, timeout=120) as response:
                    return response.status, response.headers, response.read()
            except urllib.error.HTTPError as error:
                return error.code, error.headers, error.read()
            except urllib.error.URLError:
                return 599, {}, b""

        code, headers, body = self.request("GET", endpoint)
        if code == 204 or not body:
            return code, headers, body
        if code not in (200, 302):
            return code, headers, body
        return code, headers, body

    def complete(self, job: dict, docx_path: Path, manifest: dict) -> dict:
        encoded = base64.b64encode(docx_path.read_bytes()).decode("ascii")
        payload = {
            "file_base64": encoded,
            "filename": docx_path.name,
            "content_type": DOCX_CONTENT_TYPE,
            "manifest": manifest,
            "worker_id": self.worker_id,
            "maza_address": manifest.get("maza_address") or node_maza_address(),
            "provider": manifest.get("provider", "template"),
            "model": manifest.get("model", "none"),
            "summary": manifest.get("summary", ""),
        }
        if job.get("claim_token") or job.get("output", {}).get("claim_token"):
            payload["claim_token"] = job.get("claim_token") or job.get("output", {}).get("claim_token")
        endpoint = job.get("output", {}).get("complete_endpoint") or f"/dope_worker/reports/{job['id']}/complete"
        code, _headers, body = self.request(
            "POST",
            endpoint,
            body=json.dumps(payload, ensure_ascii=True).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            timeout=int(env("DOPE_REPORT_COMPLETE_TIMEOUT", "900")),
        )
        if code != 200:
            raise RuntimeError(f"complete failed HTTP {code}: {body.decode(errors='replace')[:500]}")
        return json.loads(body.decode("utf-8"))

    def fail(self, job: dict, message: str) -> None:
        endpoint = job.get("output", {}).get("fail_endpoint") or f"/dope_worker/reports/{job['id']}/fail"
        form_payload = {"error": message[:1800], "worker_id": self.worker_id}
        if job.get("claim_token") or job.get("output", {}).get("claim_token"):
            form_payload["claim_token"] = job.get("claim_token") or job.get("output", {}).get("claim_token")
        form = urllib.parse.urlencode(form_payload).encode("utf-8")
        self.request("POST", endpoint, body=form, headers={"Content-Type": "application/x-www-form-urlencoded"})

    def heartbeat(
        self,
        job: dict,
        phase: str | None = None,
        progress: int | None = None,
        detail: str | None = None,
    ) -> bool:
        endpoint = job.get("output", {}).get("heartbeat_endpoint") or f"/dope_worker/reports/{job['id']}/heartbeat"
        form_payload = {"worker_id": self.worker_id}
        if job.get("claim_token") or job.get("output", {}).get("claim_token"):
            form_payload["claim_token"] = job.get("claim_token") or job.get("output", {}).get("claim_token")
        if phase:
            form_payload["progress_phase"] = str(phase)[:40]
        if progress is not None:
            form_payload["progress_percent"] = str(max(1, min(int(progress), 99)))
        if detail:
            form_payload["progress_detail"] = re.sub(r"\s+", " ", str(detail)).strip()[:180]
        code, _headers, body = self.request(
            "POST",
            endpoint,
            body=urllib.parse.urlencode(form_payload).encode("utf-8"),
            headers={"Content-Type": "application/x-www-form-urlencoded"},
        )
        if code not in (200, 204):
            log("heartbeat_rejected", id=job.get("id"), status=f"HTTP {code}: {body.decode(errors='replace')[:160]}")
            return False
        return True


class ReportHeartbeat:
    def __init__(self, client: DopeClient, job: dict) -> None:
        self.client = client
        self.job = job
        try:
            self.interval = max(int(env("DOPE_REPORT_HEARTBEAT_SECONDS", "60") or "60"), 15)
        except ValueError:
            self.interval = 60
        self.stop_event = threading.Event()
        self.state_lock = threading.Lock()
        self.phase = "claimed"
        self.progress = 12
        self.detail = "Local report worker accepted the job."
        self.last_logged_signature = None
        self.last_logged_at = 0.0
        self.thread = threading.Thread(target=self._run, name="dope-report-heartbeat", daemon=True)

    def __enter__(self):
        self._beat()
        self.thread.start()
        return self

    def __exit__(self, _exc_type, _exc, _traceback):
        self.stop_event.set()
        self.thread.join(timeout=2)
        return False

    def _run(self) -> None:
        while not self.stop_event.wait(self.interval):
            self._beat()

    def _beat(self) -> None:
        try:
            with self.state_lock:
                phase = self.phase
                progress = self.progress
                detail = self.detail
            accepted = self.client.heartbeat(self.job, phase=phase, progress=progress, detail=detail)
            if not accepted:
                return
            now = time.monotonic()
            signature = (phase, progress, detail)
            if signature != self.last_logged_signature or now - self.last_logged_at >= 60:
                log(
                    "progress",
                    id=self.job.get("id"),
                    provider="alice/local",
                    model=env("DOPE_REPORT_LOCAL_MODEL", "qwen3:8b"),
                    status=f"{progress}% {phase} // {detail}",
                )
                self.last_logged_signature = signature
                self.last_logged_at = now
        except Exception as error:
            log("heartbeat_error", id=self.job.get("id"), status=f"{type(error).__name__}: {str(error)[:160]}")

    def update(self, phase: str, progress: int, detail: str) -> None:
        with self.state_lock:
            self.phase = phase
            self.progress = max(self.progress, max(1, min(int(progress), 99)))
            self.detail = detail
        self._beat()


class ReportResourceGate:
    def __init__(self, max_parallel: int) -> None:
        self.max_parallel = max(1, min(int(max_parallel or 1), 2))
        self.active = 0
        self.heavy_active = False
        self.condition = threading.Condition()

    def acquire(self, job: dict) -> bool:
        heavy = report_job_requires_exclusive_slot(job)
        job_id = job.get("id")
        wait_logged = False
        with self.condition:
            while True:
                if self._can_start(heavy):
                    self.active += 1
                    self.heavy_active = self.heavy_active or heavy
                    log(
                        "concurrency_slot_acquired",
                        id=job_id,
                        status=f"{'exclusive' if heavy else 'parallel'} active={self.active}/{self.max_parallel}",
                    )
                    return heavy
                if not wait_logged:
                    log(
                        "concurrency_wait",
                        id=job_id,
                        status=f"{'exclusive' if heavy else 'parallel'} active={self.active}/{self.max_parallel} heavy_active={self.heavy_active}",
                    )
                    wait_logged = True
                self.condition.wait(timeout=5)

    def release(self, heavy: bool) -> None:
        with self.condition:
            self.active = max(0, self.active - 1)
            if heavy:
                self.heavy_active = False
            self.condition.notify_all()

    def _can_start(self, heavy: bool) -> bool:
        if heavy:
            return self.active == 0
        return not self.heavy_active and self.active < self.max_parallel


def image_extension(data: bytes, content_type: str) -> str | None:
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return "png"
    if data.startswith(b"\xff\xd8"):
        return "jpg"
    if data.startswith(b"GIF87a") or data.startswith(b"GIF89a"):
        return "gif"
    if content_type == "image/png":
        return "png"
    if content_type in {"image/jpeg", "image/jpg"}:
        return "jpg"
    if content_type == "image/gif":
        return "gif"
    return None


def image_size(data: bytes) -> tuple[int, int]:
    if data.startswith(b"\x89PNG\r\n\x1a\n") and len(data) >= 24:
        return int.from_bytes(data[16:20], "big"), int.from_bytes(data[20:24], "big")
    if data.startswith(b"\xff\xd8"):
        index = 2
        while index + 9 < len(data):
            if data[index] != 0xFF:
                index += 1
                continue
            marker = data[index + 1]
            index += 2
            if marker in {0xD8, 0xD9}:
                continue
            if index + 2 > len(data):
                break
            length = int.from_bytes(data[index:index + 2], "big")
            if marker in {0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF} and index + 7 < len(data):
                return int.from_bytes(data[index + 5:index + 7], "big"), int.from_bytes(data[index + 3:index + 5], "big")
            index += max(length, 2)
    return 900, 320


def logo_candidates(job: dict) -> list[tuple[str, str]]:
    assets = job.get("assets", {}) or {}
    candidates: list[tuple[str, str]] = []

    if assets.get("logo_endpoint"):
        candidates.append(("logo_endpoint", assets["logo_endpoint"]))
    if assets.get("logo_url"):
        candidates.append(("logo_url", assets["logo_url"]))

    for item in assets.get("uploaded_media", []) or []:
        content_type = str(item.get("content_type") or "").lower()
        role = str(item.get("role") or "").lower()
        endpoint = item.get("endpoint")
        if endpoint and content_type.startswith("image/") and ("logo" in role or "logo" in str(item.get("filename") or "").lower()):
            candidates.append(("uploaded_logo_media", endpoint))

    for item in assets.get("uploaded_media", []) or []:
        content_type = str(item.get("content_type") or "").lower()
        endpoint = item.get("endpoint")
        if endpoint and content_type.startswith("image/"):
            candidates.append(("uploaded_image_media", endpoint))

    seen = set()
    unique = []
    for source, endpoint in candidates:
        if endpoint in seen:
            continue
        seen.add(endpoint)
        unique.append((source, endpoint))
    return unique


def logo_missing_reason(job: dict, logo: tuple | None) -> str:
    if logo:
        return f"embedded from {logo[2] if len(logo) > 2 else 'worker asset'}"
    if logo_candidates(job):
        return "logo candidates were unavailable, empty, unsupported, or too large"
    return "no logo_url, logo_endpoint, or uploaded image media was provided"


def embedded_media_observations(images: list[dict], vision_notes: list[dict] | None = None) -> list[dict]:
    notes_by_filename = {}
    ocr_by_filename = {}
    for item in (vision_notes or []):
        filename = str(item.get("filename") or "")
        if not filename:
            continue
        if item.get("kind") == "ocr":
            ocr_by_filename[filename] = item.get("summary")
        else:
            notes_by_filename[filename] = item.get("summary")
    observations = []
    for index, image in enumerate(images, 1):
        filename = str(image.get("filename") or f"image_{index}")
        observations.append(
            {
                "index": index,
                "filename": filename,
                "role": image.get("role"),
                "content_type": image.get("content_type"),
                "dimensions": f"{image.get('width')}x{image.get('height')}",
                "byte_size": image.get("byte_size"),
                "endpoint": image.get("endpoint"),
                "vision_summary": notes_by_filename.get(filename),
                "ocr_text": ocr_by_filename.get(filename),
            }
        )
    return observations


def vision_scan_images(job: dict, images: list[dict]) -> list[dict]:
    if not images or not report_preflight_scan_enabled(job):
        return []
    model = report_preflight_vision_model(job)
    if not model:
        log("vision_scan_skipped", id=job.get("id"), status="DOPE_REPORT_VISION_MODEL not set")
        return []

    base_url = str(env("OLLAMA_URL", "http://127.0.0.1:11434") or "http://127.0.0.1:11434").rstrip("/")
    results = []
    for image in images[: bounded_int(env("DOPE_REPORT_VISION_IMAGE_LIMIT"), 3, 1, 6)]:
        prompt = (
            "Describe this uploaded client image for a marketing report in 2 short practical bullets. "
            "Focus on visible brand, product/service clues, quality, colors, and how it could support a postcard or proposal. "
            "Do not invent facts you cannot see."
        )
        body = {
            "model": model,
            "prompt": prompt,
            "images": [base64.b64encode(image["bytes"]).decode("ascii")],
            "stream": False,
            "options": {
                "temperature": 0.2,
                "num_predict": 180,
            },
        }
        req = urllib.request.Request(
            f"{base_url}/api/generate",
            data=json.dumps(body).encode("utf-8"),
            headers={"Content-Type": "application/json", "User-Agent": "alice-dope-market-report-worker/vision"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=int(env("DOPE_REPORT_VISION_TIMEOUT", "120"))) as response:
                parsed = json.loads(response.read().decode("utf-8"))
            summary = ollama_visible_text(parsed)
            if summary:
                results.append({"kind": "vision", "filename": image.get("filename"), "model": parsed.get("model") or model, "summary": summary[:900]})
        except Exception as error:
            log("vision_scan_error", id=job.get("id"), model=model, status=f"{image.get('filename')}: {type(error).__name__}: {str(error)[:120]}")
            continue
    if results:
        log("vision_scan_ready", id=job.get("id"), model=model, status=f"images={len(results)}")
    return results


def ocr_scan_images(job: dict, images: list[dict]) -> list[dict]:
    if not images or not report_preflight_scan_enabled(job):
        return []
    model = report_preflight_ocr_model(job)
    if not model:
        return []

    base_url = str(env("OLLAMA_URL", "http://127.0.0.1:11434") or "http://127.0.0.1:11434").rstrip("/")
    results = []
    for image in images[: bounded_int(env("DOPE_REPORT_OCR_IMAGE_LIMIT"), 3, 1, 6)]:
        prompt = (
            "Extract visible text from this uploaded client image for a marketing proposal. "
            "Return concise OCR notes only. If there is no readable text, say no readable text. "
            "Do not infer business facts that are not visible."
        )
        body = {
            "model": model,
            "prompt": prompt,
            "images": [base64.b64encode(image["bytes"]).decode("ascii")],
            "stream": False,
            "options": {
                "temperature": 0.1,
                "num_predict": 220,
            },
        }
        req = urllib.request.Request(
            f"{base_url}/api/generate",
            data=json.dumps(body).encode("utf-8"),
            headers={"Content-Type": "application/json", "User-Agent": "alice-dope-market-report-worker/ocr"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=int(env("DOPE_REPORT_OCR_TIMEOUT", "180"))) as response:
                parsed = json.loads(response.read().decode("utf-8"))
            summary = ollama_visible_text(parsed)
            if summary:
                results.append({"kind": "ocr", "filename": image.get("filename"), "model": parsed.get("model") or model, "summary": summary[:1200]})
        except Exception as error:
            log("ocr_scan_error", id=job.get("id"), model=model, status=f"{image.get('filename')}: {type(error).__name__}: {str(error)[:120]}")
            continue
    if results:
        log("ocr_scan_ready", id=job.get("id"), model=model, status=f"images={len(results)}")
    return results


def safe_text(value) -> str:
    return html.escape(str(value or "").strip(), quote=False)


def safe_attr(value) -> str:
    return html.escape(str(value or "").strip(), quote=True)


def compact(value, default="Not provided") -> str:
    text = str(value or "").strip()
    return text if text else default


def clip(value, max_chars: int = 220) -> str:
    text = str(value or "").strip()
    if len(text) <= max_chars:
        return text
    return text[: max_chars - 3].rstrip() + "..."


def slug(value: str) -> str:
    cleaned = re.sub(r"[^a-zA-Z0-9]+", "-", value.lower()).strip("-")
    return cleaned[:70] or "dope-market-report"


def minimum_docx_bytes(job: dict) -> int:
    value = job.get("output", {}).get("minimum_docx_bytes")
    try:
        return max(int(value), 4_000)
    except (TypeError, ValueError):
        return DEFAULT_MINIMUM_DOCX_BYTES


def contract_quality_gate(job: dict) -> dict:
    return job.get("report_contract", {}).get("quality_gate", {}) or {}


def contract_length(job: dict) -> dict:
    return job.get("report_contract", {}).get("length", {}) or {}


def copy_maker_word_limits(job: dict) -> tuple[int, int, str]:
    prompt = copy_maker_user_prompt(job).lower()
    short_markers = [
        "billboard",
        "sms",
        "text message",
        "text messages",
        "headline",
        "tagline",
        "slogan",
        "yard sign",
        "subject line",
        "cta",
        "one-liner",
        "one liner",
        "short copy",
    ]
    medium_markers = [
        "postcard",
        "door hanger",
        "flyer",
        "email",
        "ad copy",
        "facebook ad",
        "google ad",
        "meta ad",
        "caption",
    ]
    if any(marker in prompt for marker in short_markers):
        return 40, 15, "short_copy_asset"
    if any(marker in prompt for marker in medium_markers):
        return 120, 50, "copy_asset"
    return 180, 80, "copy_package"


def minimum_words(job: dict) -> int:
    if report_audience(job) == "copy_maker":
        minimum, _hard_minimum, _kind = copy_maker_word_limits(job)
        return minimum

    value = (
        job.get("output", {}).get("minimum_words")
        or contract_quality_gate(job).get("minimum_words")
        or contract_quality_gate(job).get("target_words")
        or contract_length(job).get("minimum_words")
    )
    try:
        return max(int(value), 250)
    except (TypeError, ValueError):
        return DEFAULT_MINIMUM_WORDS


def hard_minimum_words(job: dict) -> int:
    if report_audience(job) == "copy_maker":
        _minimum, hard_minimum, _kind = copy_maker_word_limits(job)
        return hard_minimum

    value = (
        job.get("output", {}).get("hard_minimum_words")
        or contract_quality_gate(job).get("hard_minimum_words")
        or contract_quality_gate(job).get("minimum_words")
        or contract_length(job).get("hard_minimum_words")
        or env("DOPE_REPORT_HARD_MINIMUM_WORDS")
        or DEFAULT_HARD_MINIMUM_WORDS
    )
    try:
        return max(int(value), DEFAULT_HARD_MINIMUM_WORDS)
    except (TypeError, ValueError):
        return DEFAULT_HARD_MINIMUM_WORDS


def word_count(text: str) -> int:
    return len(re.findall(r"\b[\w'$%-]+\b", text or ""))


def extract_sections(text: str) -> list[str]:
    sections = []
    for line in text.splitlines():
        cleaned = line.strip()
        if not cleaned:
            continue
        if cleaned.startswith("#"):
            title = cleaned.lstrip("#").strip()
            if title:
                sections.append(title)
        elif re.match(r"^[A-Z][A-Za-z0-9 &/().,'-]{8,80}:$", cleaned):
            sections.append(cleaned.rstrip(":"))
    seen = set()
    unique = []
    for section in sections:
        key = section.lower()
        if key in seen:
            continue
        seen.add(key)
        unique.append(section)
    return unique


def clean_title_line(line: str) -> str:
    cleaned = str(line or "").strip()
    cleaned = re.sub(r"^#{1,6}\s*", "", cleaned)
    cleaned = re.sub(r"</?[^>]+>", "", cleaned)
    cleaned = cleaned.strip("*_`# \t")
    cleaned = re.sub(r"\s+", " ", cleaned).strip()
    return cleaned


def report_display_title(job: dict, document_text: str, sections: list[str], fallback: str) -> str:
    skip_patterns = [
        r"^dope marketing$",
        r"^client strategy proposal$",
        r"^prepared for\b",
        r"^industry\b",
        r"^service area\b",
        r"^report date\b",
        r"^prepared by\b",
        r"^created using\b",
        r"^executive summary$",
        r"^header / cover$",
    ]
    for line in str(document_text or "").splitlines()[:30]:
        title = clean_title_line(line)
        if not title:
            continue
        if any(re.search(pattern, title, flags=re.I) for pattern in skip_patterns):
            continue
        if re.search(r"\b(market strategy|seasonality report|client proposal|marketing proposal|strategy proposal)\b", title, flags=re.I):
            return title[:140]

    company_name = compact(job.get("company", {}).get("name") or job.get("deal", {}).get("company_name"), "")
    deal_name = compact(job.get("deal", {}).get("name"), "")
    display_name = company_name or deal_name or fallback
    display_name = re.sub(r"^New Signup\s*-\s*", "", display_name, flags=re.I).strip() or fallback
    if display_name:
        return f"Market Strategy & Seasonality Report: {display_name}"[:140]
    return (sections[0] if sections else fallback)[:140]


def normalize_section_text(value: str) -> str:
    text = re.sub(r"^[#>*_\-\s]+", "", str(value or "")).strip()
    text = text.replace("’", "'").replace("`", "")
    text = re.sub(r"[:#*_]+$", "", text).strip().lower()
    text = re.sub(r"[^a-z0-9'&/(). -]+", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def section_title_value(section) -> str:
    if isinstance(section, dict):
        return str(section.get("title") or section.get("id") or "").strip()
    return str(section or "").strip()


def required_section_titles(job: dict) -> list[str]:
    titles = []
    for section in job.get("report_contract", {}).get("required_sections", []) or []:
        title = section_title_value(section)
        if title and title not in titles:
            titles.append(title)
    return titles


def section_aliases(title: str) -> set[str]:
    normalized = normalize_section_text(title)
    aliases = {normalized} if normalized else set()
    compact = re.sub(r"[^a-z0-9]+", "_", normalized).strip("_")
    alias_map = {
        "cover": {"cover", "dope marketing", "market strategy seasonality report", "market strategy report"},
        "header": {"header", "dope marketing"},
        "title": {"title", "title section", "marketing proposal", "strategy proposal", "market strategy report"},
        "executive_summary": {"executive summary", "summary"},
        "market_snapshot": {"market snapshot", "local market snapshot", "market opportunity"},
        "seasonality_timeline": {"seasonality timeline", "seasonality analysis", "seasonality", "campaign timing", "seasonal timeline"},
        "recommended_campaign": {"recommended campaign", "campaign recommendation", "primary campaign", "campaign strategy"},
        "channel_strategy": {"channel strategy", "product strategy", "direct mail vs yard signs vs door hangers", "channel comparison"},
        "neighborhood_targeting": {"neighborhood targeting", "neighborhood targeting strategy", "targeting strategy"},
        "offer_strategy": {"offer strategy", "offer ideas", "offer stack"},
        "launch_plan": {"launch plan", "timeline launch plan", "suggested timeline", "campaign timeline", "timeline"},
        "final_recommendation": {"final recommendation", "final recommendation summary", "next steps", "recommendation summary"},
        "comm_kit_text_messages": {"comm kit text messages", "comm kit sms", "text messages", "sms messages"},
        "comm_kit_sales_emails": {"comm kit sales emails", "sales emails", "email templates", "friendly sales emails"},
    }
    aliases.update(alias_map.get(compact, set()))
    aliases.update(alias_map.get(normalized.replace(" ", "_"), set()))
    return {alias for alias in aliases if alias}


def required_table_titles(job: dict) -> list[str]:
    titles = []
    for table in job.get("report_contract", {}).get("required_tables", []) or []:
        if isinstance(table, dict):
            title = str(table.get("title") or table.get("id") or "").strip()
        else:
            title = str(table or "").strip()
        if title and title not in titles:
            titles.append(title)
    return titles


def required_report_outline(job: dict) -> str:
    sections = required_section_titles(job)
    tables = required_table_titles(job)
    lines = []
    if sections:
        lines.append("Required visible sections, in order: " + "; ".join(sections) + ".")
    if tables:
        lines.append("Required Markdown tables: " + "; ".join(tables) + ".")
    quality = contract_quality_gate(job)
    page_count = quality.get("target_pages") or job.get("report_contract", {}).get("target_pages")
    if page_count:
        lines.append(f"Target designed report length: {page_count} skimmable pages/sections.")
    return "\n".join(lines)


def report_section_titles(job: dict, text: str) -> list[str]:
    titles = extract_sections(text)
    normalized_lines = [normalize_section_text(line) for line in (text or "").splitlines() if line.strip()]
    normalized_document = "\n".join(normalized_lines)

    def add(title: str) -> None:
        if title and title not in titles:
            titles.append(title)

    if re.match(r"^\s*(#\s*)?(\*\*)?(?:WIZWIKI|DOPE) MARKETING\b", text or "", flags=re.I):
        add("Header")

    first_lines = normalized_lines[:12]
    if any("marketing proposal" in line or "strategy proposal" in line or "client strategy proposal" in line for line in first_lines):
        add("Title")

    for title in required_section_titles(job):
        aliases = section_aliases(title)
        if not aliases:
            continue
        if aliases & {"header", "title"}:
            continue
        if any(any(line == alias for alias in aliases) for line in normalized_lines) or any(alias in normalized_document for alias in aliases):
            add(title)

    seen = set()
    unique = []
    for title in titles:
        key = normalize_section_text(title)
        if not key or key in seen:
            continue
        seen.add(key)
        unique.append(title)
    return unique


def missing_required_section_titles(job: dict, text: str) -> list[str]:
    required = required_section_titles(job)
    if not required:
        return []
    present = [normalize_section_text(title) for title in report_section_titles(job, text)]
    missing = []
    for title in required:
        aliases = section_aliases(title)
        if not aliases:
            continue
        if any(any(value == alias or value in alias or alias in value for alias in aliases) for value in present):
            continue
        missing.append(title)
    return missing


def compact_for_prompt(value, limit: int = 4000):
    if isinstance(value, dict):
        return {str(k): compact_for_prompt(v, limit) for k, v in value.items() if v not in (None, "", [], {})}
    if isinstance(value, list):
        return [compact_for_prompt(item, limit) for item in value if item not in (None, "", [], {})]
    text = str(value or "")
    return text if len(text) <= limit else f"{text[:limit].rstrip()}..."


def bounded_int(value, default: int, minimum: int, maximum: int) -> int:
    try:
        parsed = int(value)
    except (TypeError, ValueError):
        parsed = default
    return max(minimum, min(parsed, maximum))


def embedding_runtime(job: dict) -> dict:
    payload_runtime = job.get("embedding_runtime", {}) or {}
    contract_runtime = job.get("report_contract", {}).get("embedding_runtime", {}) or {}
    runtime = {**contract_runtime, **payload_runtime}
    requested_model = str(
        runtime.get("model")
        or runtime.get("embedder_model")
        or runtime.get("target_model")
        or env("DOPE_REPORT_EMBEDDER_MODEL")
        or DEFAULT_EMBEDDER_MODEL
    ).strip()
    legacy_fallback = str(runtime.get("fallback") or "").strip()
    # Older report contracts used `fallback` for a human-readable instruction.
    # Only accept it as a model identifier when it actually looks like one.
    legacy_fallback_model = legacy_fallback if legacy_fallback and not re.search(r"\s", legacy_fallback) else ""
    fallback_model = str(
        runtime.get("fallback_model")
        or env("DOPE_REPORT_EMBEDDER_FALLBACK")
        or legacy_fallback_model
        or DEFAULT_EMBEDDER_MODEL
    ).strip()
    requested_top_k = bounded_int(runtime.get("top_k") or env("DOPE_REPORT_EMBEDDING_TOP_K"), DEFAULT_EMBEDDING_TOP_K, 2, 40)
    requested_chunk_chars = bounded_int(runtime.get("chunk_chars") or env("DOPE_REPORT_EMBEDDING_CHUNK_CHARS"), DEFAULT_EMBEDDING_CHUNK_CHARS, 500, 6000)
    requested_max_chunks = bounded_int(runtime.get("max_chunks") or env("DOPE_REPORT_EMBEDDING_MAX_CHUNKS"), DEFAULT_EMBEDDING_MAX_CHUNKS, 10, 240)
    local_top_k_cap = bounded_int(env("DOPE_REPORT_EMBEDDING_LOCAL_TOP_K_CAP"), 6, 2, 20)
    local_chunk_chars_cap = bounded_int(env("DOPE_REPORT_EMBEDDING_LOCAL_CHUNK_CHARS_CAP"), 1200, 500, 3000)
    local_max_chunks_cap = bounded_int(env("DOPE_REPORT_EMBEDDING_LOCAL_MAX_CHUNKS_CAP"), 24, 10, 80)
    return {
        **runtime,
        "model": requested_model or DEFAULT_EMBEDDER_MODEL,
        "fallback_model": fallback_model or DEFAULT_EMBEDDER_MODEL,
        "top_k": min(requested_top_k, local_top_k_cap),
        "chunk_chars": min(requested_chunk_chars, local_chunk_chars_cap),
        "max_chunks": min(requested_max_chunks, local_max_chunks_cap),
    }


def stringify_source(value) -> str:
    if value in (None, "", [], {}):
        return ""
    if isinstance(value, str):
        return value.strip()
    return json.dumps(compact_for_prompt(value, limit=1800), indent=2, ensure_ascii=True)


def semantic_embedding_enabled() -> bool:
    return truthy(env("DOPE_REPORT_SEMANTIC_EMBEDDINGS_ENABLED", "1"))


def split_source_text(label: str, text: str, chunk_chars: int) -> list[dict]:
    text = re.sub(r"\n{3,}", "\n\n", str(text or "").strip())
    if not text:
        return []

    chunks = []
    current: list[str] = []
    current_size = 0
    for line in text.splitlines():
        addition = len(line) + 1
        if current and current_size + addition > chunk_chars:
            chunks.append({"label": label, "text": "\n".join(current).strip()})
            current = []
            current_size = 0
        current.append(line)
        current_size += addition
    if current:
        chunks.append({"label": label, "text": "\n".join(current).strip()})

    expanded = []
    for index, chunk in enumerate(chunks, start=1):
        expanded.append({"label": f"{label} #{index}" if len(chunks) > 1 else label, "text": chunk["text"]})
    return expanded


def source_context_chunks(job: dict, chunk_chars: int) -> list[dict]:
    chunks: list[dict] = []

    def add(label: str, value) -> None:
        chunks.extend(split_source_text(label, stringify_source(value), chunk_chars))

    contract = job.get("report_contract", {}) or {}
    hubspot = job.get("hubspot_context", {}) or {}
    assets = job.get("assets", {}) or {}
    account_graph = job.get("account_graph", {}) or {}

    add("Client fact sheet", source_fact_sheet(job))
    add("Primary generation prompt", job.get("generation_prompt") or contract.get("llm_prompt") or contract.get("requested_output"))
    add("Reference style summary", strategy_proposal_style_summary())
    add("Report contract", contract)
    add("Deal", job.get("deal", {}))
    add("Company", job.get("company", {}))
    add("Commerce", job.get("commerce", {}))
    add("Campaign context", job.get("campaign_context", {}))
    add("HubSpot labeled properties", hubspot.get("labeled_properties", {}))
    add("HubSpot raw properties", hubspot.get("raw_properties", {}))
    add("HubSpot missing core fields", hubspot.get("missing_core_fields", []))
    add("Associated companies", account_graph.get("companies", []))
    add("Associated contacts", account_graph.get("contacts", []))
    add("Associated deals", account_graph.get("deals", []))
    add("Uploaded media", assets.get("uploaded_media", []))

    clean = []
    seen = set()
    for chunk in chunks:
        text = chunk.get("text", "").strip()
        if not text:
            continue
        key = (chunk.get("label"), text[:240])
        if key in seen:
            continue
        seen.add(key)
        clean.append(chunk)
    return clean


INDUSTRY_HINTS = [
    ("plumbing / HVAC", ["plumb", "drain", "pipe", "water heater", "hvac", "heating", "cooling", "furnace", "air conditioning"]),
    ("roofing", ["roof", "gutter", "siding", "exterior"]),
    ("pool service", ["pool", "spa"]),
    ("landscaping", ["lawn", "landscap", "mowing", "tree service"]),
    ("pest control", ["pest", "termite", "extermin"]),
    ("home remodeling", ["remodel", "renovation", "kitchen", "bath"]),
    ("dental", ["dental", "dentist", "orthodont"]),
    ("medical", ["medical", "clinic", "healthcare", "therapy"]),
    ("automotive", ["auto", "car", "truck", "collision", "tire"]),
]


def deep_string_values(value, key_hint: str | None = None, limit: int = 240) -> list[str]:
    values: list[str] = []
    stack = [(value, key_hint)]
    while stack and len(values) < limit:
        current, current_key = stack.pop()
        if current in (None, "", [], {}):
            continue
        if isinstance(current, dict):
            for key, child in current.items():
                stack.append((child, str(key)))
        elif isinstance(current, list):
            for child in current:
                stack.append((child, current_key))
        else:
            text = str(current).strip()
            if text:
                values.append(text[:400])
    return values


def keyed_source_values(value, key_patterns: list[str], limit: int = 18) -> list[str]:
    values: list[str] = []
    patterns = [re.compile(pattern, re.I) for pattern in key_patterns]

    def walk(current) -> None:
        if len(values) >= limit:
            return
        if isinstance(current, dict):
            for key, child in current.items():
                key_text = str(key)
                if any(pattern.search(key_text) for pattern in patterns) and child not in (None, "", [], {}):
                    if isinstance(child, (dict, list)):
                        for item in deep_string_values(child, limit=6):
                            if item not in values:
                                values.append(item)
                    else:
                        item = str(child).strip()
                        if item and item not in values:
                            values.append(item[:220])
                walk(child)
        elif isinstance(current, list):
            for child in current:
                walk(child)

    walk(value)
    return values[:limit]


def inferred_industry(job: dict) -> str:
    explicit = compact(
        (job.get("report_contract", {}) or {}).get("client", {}).get("industry")
        or (job.get("company", {}) or {}).get("industry"),
        "",
    )
    if explicit and explicit.lower() != "local service business":
        return explicit
    haystack = " ".join(
        deep_string_values(
            {
                "deal": job.get("deal", {}),
                "company": job.get("company", {}),
                "campaign_context": job.get("campaign_context", {}),
                "hubspot_context": job.get("hubspot_context", {}),
                "account_graph": job.get("account_graph", {}),
            },
            limit=180,
        )
    ).lower()
    for label, needles in INDUSTRY_HINTS:
        if any(needle in haystack for needle in needles):
            return label
    return explicit or "local service business"


def source_fact_sheet(job: dict) -> dict:
    contract = job.get("report_contract", {}) or {}
    client = contract.get("client", {}) or {}
    company = job.get("company", {}) or {}
    deal = job.get("deal", {}) or {}
    graph = job.get("account_graph", {}) or {}
    hubspot = job.get("hubspot_context", {}) or {}
    contact_intelligence = job.get("contact_intelligence", {}) or job.get("ai_runtime", {}).get("contact_intelligence", {}) or {}
    source_scope = {
        "deal": deal,
        "company": company,
        "campaign_context": job.get("campaign_context", {}),
        "hubspot_context": hubspot,
        "account_graph": graph,
    }
    business_name = compact(client.get("business_name") or company.get("name") or deal.get("company_name") or deal.get("name"), "")
    clean_business_name = re.sub(r"^\s*New Signup\s*-\s*", "", business_name, flags=re.I).strip() or business_name
    timing = report_timing_context(job)
    return {
        "business_name": business_name,
        "client_visible_name": clean_business_name,
        "inferred_industry": inferred_industry(job),
        "service_area_candidates": keyed_source_values(
            source_scope,
            ["service.*area", "market", "city", "state", "zip", "postal", "address", "location", "territory"],
            limit=18,
        ),
        "contact_candidates": keyed_source_values(source_scope, ["email", "phone", "mobile", "contact", "owner"], limit=18),
        "ranked_contact_candidates": contact_intelligence.get("ranked_contacts", []),
        "ranked_phone_options": contact_intelligence.get("phone_options", []),
        "ranked_email_options": contact_intelligence.get("email_options", []),
        "domain_candidates": keyed_source_values(source_scope, ["domain", "website", "url"], limit=8),
        "current_date": timing.get("authoritative_current_date"),
        "earliest_production_ready_date": timing.get("earliest_production_ready_date"),
        "minimum_production_lead_days": timing.get("minimum_production_lead_days"),
        "visibility_rules": [
            "Do not show placeholders like Your Local Service Area.",
            "Do not write Client Strategy Proposal unless the report contract title explicitly asks for it.",
            "Do not use measurable as a replacement for a missing statistic or discount.",
            "If exact stats are not sourced, use directional language and trackable CRM outcomes.",
            "Recommendations must use dates on or after earliest_production_ready_date.",
        ],
    }


def retrieval_query(job: dict) -> str:
    contract = job.get("report_contract", {}) or {}
    deal = job.get("deal", {}) or {}
    company = job.get("company", {}) or {}
    campaign = job.get("campaign_context", {}) or {}
    facts = source_fact_sheet(job)
    parts = [
        json.dumps(facts, ensure_ascii=True),
        job.get("generation_prompt"),
        contract.get("llm_prompt"),
        contract.get("requested_output"),
        " ".join(str(item) for item in contract.get("required_sections", []) or []),
        company.get("name"),
        company.get("industry"),
        deal.get("name"),
        deal.get("stage"),
        campaign.get("deal_description"),
    ]
    return "\n".join(str(part).strip() for part in parts if str(part or "").strip())


def ollama_embed(model: str, inputs: list[str]) -> list[list[float]]:
    base_url = str(env("OLLAMA_URL", "http://127.0.0.1:11434") or "http://127.0.0.1:11434").rstrip("/")
    body = {
        "model": model,
        "input": inputs,
        "options": {
            "num_ctx": bounded_int(env("DOPE_REPORT_EMBEDDING_CONTEXT"), 8192, 2048, 16384),
        },
    }
    req = urllib.request.Request(
        f"{base_url}/api/embed",
        data=json.dumps(body).encode("utf-8"),
        headers={"Content-Type": "application/json", "User-Agent": "alice-dope-market-report-worker/2.2"},
        method="POST",
    )
    timeout = int(env("DOPE_REPORT_EMBEDDING_TIMEOUT", "180"))
    with urllib.request.urlopen(req, timeout=timeout) as response:
        parsed = json.loads(response.read().decode("utf-8"))

    embeddings = parsed.get("embeddings")
    if isinstance(embeddings, list) and embeddings and isinstance(embeddings[0], list):
        return embeddings
    embedding = parsed.get("embedding")
    if isinstance(embedding, list):
        return [embedding]
    raise RuntimeError(f"Ollama embed returned no embeddings for {model}")


def cosine_similarity(left: list[float], right: list[float]) -> float:
    if not left or not right:
        return 0.0
    size = min(len(left), len(right))
    dot = sum(left[index] * right[index] for index in range(size))
    left_norm = sum(left[index] * left[index] for index in range(size)) ** 0.5
    right_norm = sum(right[index] * right[index] for index in range(size)) ** 0.5
    if not left_norm or not right_norm:
        return 0.0
    return dot / (left_norm * right_norm)


def rank_source_chunks(model: str, query: str, chunks: list[dict], top_k: int) -> list[dict]:
    inputs = [query] + [chunk["text"] for chunk in chunks]
    embeddings = ollama_embed(model, inputs)
    if len(embeddings) < 2:
        raise RuntimeError(f"Ollama embed returned too few vectors for {model}")
    query_vector = embeddings[0]
    ranked = []
    for chunk, vector in zip(chunks, embeddings[1:]):
        ranked.append({**chunk, "score": cosine_similarity(query_vector, vector)})
    ranked.sort(key=lambda item: item.get("score", 0.0), reverse=True)
    return ranked[:top_k]


def lexical_rank_source_chunks(query: str, chunks: list[dict], top_k: int) -> list[dict]:
    terms = {term.lower() for term in re.findall(r"[A-Za-z0-9][A-Za-z0-9_-]{2,}", query or "")}
    ranked = []
    for chunk in chunks:
        text = chunk["text"].lower()
        score = sum(1 for term in terms if term in text)
        ranked.append({**chunk, "score": float(score)})
    ranked.sort(key=lambda item: item.get("score", 0.0), reverse=True)
    return ranked[:top_k]


def format_retrieval_context(ranked_chunks: list[dict], meta: dict) -> str:
    if not ranked_chunks:
        return ""
    lines = [
        "LOCAL_RETRIEVAL_CONTEXT",
        f"embedder_model={meta.get('embedder_model')}",
        f"embedding_provider={meta.get('embedding_provider')}",
        f"embedding_top_k={meta.get('embedding_top_k')}",
        "Use these ranked chunks first when choosing facts, recommendations, budget framing, and setup gaps.",
        "",
    ]
    for index, chunk in enumerate(ranked_chunks, start=1):
        score = chunk.get("score", 0.0)
        lines.append(f"[{index}] {chunk.get('label')} score={score:.4f}")
        lines.append(chunk.get("text", "").strip())
        lines.append("")
    return "\n".join(lines).strip()


def ensure_embedding_context(job: dict) -> tuple[str, dict]:
    if "_alice_embedding_context" in job and "_alice_embedding_meta" in job:
        return job["_alice_embedding_context"], job["_alice_embedding_meta"]

    runtime = embedding_runtime(job)
    chunks = source_context_chunks(job, runtime["chunk_chars"])[: runtime["max_chunks"]]
    query = retrieval_query(job) or stringify_source(job.get("deal", {})) or "DOPE market report"
    requested_model = runtime["model"]
    fallback_model = runtime["fallback_model"]
    ranked_chunks: list[dict] = []
    selected_model = requested_model
    fallback_used = None
    error_messages = []

    if semantic_embedding_enabled():
        for candidate in [requested_model, fallback_model]:
            if not candidate:
                continue
            if ranked_chunks:
                break
            try:
                ranked_chunks = rank_source_chunks(candidate, query, chunks, runtime["top_k"])
                selected_model = candidate
                if candidate != requested_model:
                    fallback_used = candidate
            except Exception as error:
                error_messages.append(f"{candidate}: {type(error).__name__}: {str(error)[:180]}")
                log("embedding_candidate_failed", id=job.get("id"), provider="ollama/local", model=candidate, status=str(error)[:160])

    if not ranked_chunks:
        ranked_chunks = lexical_rank_source_chunks(query, chunks, runtime["top_k"])
        selected_model = requested_model
        fallback_used = "lexical"

    meta = {
        "embedding_provider": "ollama/local",
        "embedder_model": selected_model,
        "requested_embedder_model": requested_model,
        "embedding_chunks_count": len(chunks),
        "embedding_top_k": min(runtime["top_k"], len(ranked_chunks)),
        "embedder_model_fallback": fallback_used,
        "embedding_errors": error_messages,
    }
    context = format_retrieval_context(ranked_chunks, meta)
    job["_alice_embedding_context"] = context
    job["_alice_embedding_meta"] = meta
    log(
        "embedding_context_ready",
        id=job.get("id"),
        provider="ollama/local",
        model=selected_model,
        status=f"chunks={len(chunks)} top_k={meta['embedding_top_k']} fallback={fallback_used or 'none'}",
    )
    return context, meta


def ensure_repair_embedding_context(job: dict, retry_note: str | None = None) -> tuple[str, dict]:
    previous_draft = str(job.get("_alice_previous_draft") or "").strip()
    quality_errors = [str(item) for item in (job.get("_alice_quality_errors") or []) if str(item).strip()]
    note = str(retry_note or "").strip()
    if not previous_draft and not quality_errors and not note:
        return "", {}

    runtime = embedding_runtime(job)
    base_chunks = source_context_chunks(job, runtime["chunk_chars"])[: runtime["max_chunks"]]
    repair_chunks = [
        {"label": "Failed draft copy", "text": previous_draft[:6000]},
        {"label": "Validation errors", "text": "\n".join([note, *quality_errors]).strip()},
    ]
    chunks = [chunk for chunk in repair_chunks + base_chunks if str(chunk.get("text") or "").strip()]
    contract = job.get("report_contract", {}) or {}
    query = "\n".join(
        item
        for item in [
            "Repair this DOPE market report using the source facts and validation errors.",
            note,
            "\n".join(quality_errors),
            "Required sections: " + ", ".join(str(section) for section in contract.get("required_sections", []) or []),
            previous_draft[:2000],
        ]
        if str(item or "").strip()
    )

    selected_model = runtime["model"]
    fallback_used = None
    error_messages = []
    ranked_chunks: list[dict] = []
    if semantic_embedding_enabled():
        for candidate in [runtime["model"], runtime["fallback_model"]]:
            if not candidate:
                continue
            if ranked_chunks:
                break
            try:
                ranked_chunks = rank_source_chunks(candidate, query, chunks, runtime["top_k"])
                selected_model = candidate
                if candidate != runtime["model"]:
                    fallback_used = candidate
            except Exception as error:
                error_messages.append(f"{candidate}: {type(error).__name__}: {str(error)[:180]}")
                log("repair_embedding_candidate_failed", id=job.get("id"), provider="ollama/local", model=candidate, status=str(error)[:160])

    if not ranked_chunks:
        ranked_chunks = lexical_rank_source_chunks(query, chunks, runtime["top_k"])
        fallback_used = "lexical"

    meta = {
        "embedding_provider": "ollama/local",
        "embedder_model": selected_model,
        "embedding_chunks_count": len(chunks),
        "embedding_top_k": min(runtime["top_k"], len(ranked_chunks)),
        "embedder_model_fallback": fallback_used,
        "embedding_errors": error_messages,
    }
    context = format_retrieval_context(ranked_chunks, meta)
    log(
        "repair_embedding_context_ready",
        id=job.get("id"),
        provider="ollama/local",
        model=selected_model,
        status=f"chunks={len(chunks)} top_k={meta['embedding_top_k']} fallback={fallback_used or 'none'}",
    )
    return context, meta


def openai_model_candidates() -> list[str]:
    candidates = [
        env("DOPE_REPORT_OPENAI_MODEL"),
        "gpt-5.5",
        env("OPENAI_MODEL"),
        "gpt-5.4",
        "gpt-5.2",
        "gpt-5.1",
        "gpt-5",
    ]
    return [item for index, item in enumerate(candidates) if item and item not in candidates[:index]]


def reasoning_effort_candidates() -> list[str]:
    candidates = [
        env("DOPE_REPORT_OPENAI_REASONING"),
        env("DOPE_REPORT_REASONING_EFFORT"),
        "xhigh",
        "high",
        "medium",
    ]
    return [item for index, item in enumerate(candidates) if item and item not in candidates[:index]]


def strategy_proposal_style_summary() -> str | None:
    if str(env("DOPE_REPORT_INCLUDE_LOCAL_STYLE", "0")).strip().lower() not in {"1", "true", "yes", "on"}:
        return None
    configured = env("DOPE_STRATEGY_PROPOSAL_STYLE_PATH")
    candidate_paths = [Path(configured).expanduser()] if configured else [STRATEGY_PROPOSAL_STYLE_PATH, STRATEGY_PROPOSAL_CONTEXT_PATH]
    path = next((candidate for candidate in candidate_paths if candidate.exists()), candidate_paths[0])
    if not path.exists():
        return None
    try:
        text = path.read_text(encoding="utf-8", errors="ignore").strip()
    except OSError as error:
        log("style_reference_error", status=f"{path}: {error}")
        return None
    return text[:12_000] if text else None


def report_timing_context(job: dict) -> dict:
    sun_timing = (job.get("timing_context") or job.get("report_contract", {}).get("timing_context") or {}) if isinstance(job, dict) else {}
    now = dt.datetime.now(dt.timezone.utc).astimezone()
    current_date = now.date()
    configured_lead = env("DOPE_REPORT_PRODUCTION_LEAD_DAYS") or sun_timing.get("minimum_production_lead_days") or "14"
    lead_days = bounded_int(configured_lead, 14, 1, 90)
    earliest_date = current_date + dt.timedelta(days=lead_days)
    authoritative_date = str(sun_timing.get("current_date") or current_date.isoformat())
    authoritative_earliest = str(sun_timing.get("earliest_production_ready_date") or earliest_date.isoformat())

    return {
        "generated_at_local": now.isoformat(timespec="seconds"),
        "current_date_local": current_date.isoformat(),
        "current_time_zone_local": now.tzname(),
        "authoritative_current_date": authoritative_date,
        "minimum_production_lead_days": lead_days,
        "earliest_production_ready_date": authoritative_earliest,
        "source": "SUN timing_context preferred; Alice local clock included as fallback",
        "timing_rule": f"Build all campaign timing from authoritative_current_date and allow at least {lead_days} calendar days for design, proofing, print setup, production, and mail/drop preparation.",
        "recommendation_rule": "Do not recommend an immediate launch/mail/drop date earlier than earliest_production_ready_date. If the seasonal window is too close, recommend the next practical window.",
        "sun_payload_timing_context": sun_timing,
    }


def report_prompt_input(job: dict, retry_note: str | None = None) -> str:
    contract = job.get("report_contract", {}) or {}
    primary_prompt = job.get("generation_prompt") or contract.get("llm_prompt") or contract.get("requested_output")
    uploaded_media = job.get("assets", {}).get("uploaded_media", []) or []
    retrieval_context, embedding_meta = ensure_embedding_context(job)
    repair_context, repair_embedding_meta = ensure_repair_embedding_context(job, retry_note) if retry_note else ("", {})
    account_graph = job.get("account_graph", {}) or {}
    prompt_contract = dict(contract)
    # These large prose fields are already represented by the primary prompt,
    # required sections, and retrieval context below.
    for duplicate_key in ("llm_prompt", "requested_output", "generation_prompt"):
        prompt_contract.pop(duplicate_key, None)

    prompt_package = {
        "client_fact_sheet": source_fact_sheet(job),
        "primary_generation_prompt": primary_prompt,
        "retry_note": retry_note,
        "reference_style_summary": strategy_proposal_style_summary(),
        "local_retrieval_context": retrieval_context,
        "repair_retrieval_context": repair_context,
        "embedding_runtime": job.get("embedding_runtime", {}) or {},
        "embedding_summary": embedding_meta,
        "repair_embedding_summary": repair_embedding_meta,
        "timing_context": report_timing_context(job),
        "previous_draft_for_repair": job.get("_alice_previous_draft") if retry_note else None,
        "quality_errors_to_fix": job.get("_alice_quality_errors") if retry_note else None,
        "report_contract": prompt_contract,
        "required_sections": contract.get("required_sections", []),
        "writing_rules": contract.get("writing_rules", []),
        "deal": job.get("deal", {}),
        "company": job.get("company", {}),
        "commerce": job.get("commerce", {}),
        "campaign_context": job.get("campaign_context", {}),
        "account_graph": {
            "companies": list(account_graph.get("companies", []) or [])[:4],
            "contacts": list(account_graph.get("contacts", []) or [])[:6],
            "deals": list(account_graph.get("deals", []) or [])[:6],
        },
        "contact_intelligence": job.get("contact_intelligence", {}) or job.get("ai_runtime", {}).get("contact_intelligence", {}),
        "associated_data_summary": {
            "associated_company_count": len((job.get("account_graph", {}) or {}).get("companies", []) or []),
            "associated_contact_count": len((job.get("account_graph", {}) or {}).get("contacts", []) or []),
            "associated_deal_count": len((job.get("account_graph", {}) or {}).get("deals", []) or []),
        },
        "hubspot_context": {
            "labeled_properties": job.get("hubspot_context", {}).get("labeled_properties", {}),
            "missing_core_fields": job.get("hubspot_context", {}).get("missing_core_fields", []),
            "property_count": job.get("hubspot_context", {}).get("property_count"),
        },
        "uploaded_media": [
            {
                "filename": item.get("filename"),
                "content_type": item.get("content_type"),
                "byte_size": item.get("byte_size"),
                "role": item.get("role"),
                "endpoint": item.get("endpoint"),
            }
            for item in uploaded_media
        ],
        "embedded_media_observations": job.get("_alice_media_observations", []),
        "quality_gate": {
            "target_words": minimum_words(job),
            "hard_minimum_words": hard_minimum_words(job),
            "minimum_docx_bytes": minimum_docx_bytes(job),
            "docx_signature": "PK",
        },
    }
    field_limit = bounded_int(env("DOPE_REPORT_PROMPT_FIELD_CHARS"), 1200, 400, 4000)
    retrieval_limit = bounded_int(env("DOPE_REPORT_PROMPT_RETRIEVAL_CHARS"), 9000, 2000, 18000)
    total_limit = bounded_int(env("DOPE_REPORT_PROMPT_TOTAL_CHARS"), 36000, 10000, 80000)
    compact_package = compact_for_prompt(prompt_package, limit=field_limit)
    compact_package["primary_generation_prompt"] = str(primary_prompt or "")[:6000]
    compact_package["local_retrieval_context"] = str(retrieval_context or "")[:retrieval_limit]
    if retry_note:
        compact_package["repair_retrieval_context"] = str(repair_context or "")[:retrieval_limit]
        compact_package["previous_draft_for_repair"] = str(job.get("_alice_previous_draft") or "")[:8000]

    encoded = json.dumps(compact_package, indent=2, ensure_ascii=True)
    for optional_key in ("contact_intelligence", "account_graph", "commerce"):
        if len(encoded) <= total_limit:
            break
        compact_package.pop(optional_key, None)
        encoded = json.dumps(compact_package, indent=2, ensure_ascii=True)
    if len(encoded) > total_limit:
        compact_package["local_retrieval_context"] = str(retrieval_context or "")[: max(2000, retrieval_limit // 2)]
        encoded = json.dumps(compact_package, indent=2, ensure_ascii=True)
    if len(encoded) > total_limit:
        def excerpt(value, limit: int) -> str:
            if isinstance(value, str):
                return value[:limit]
            return json.dumps(compact_for_prompt(value, limit=500), ensure_ascii=True)[:limit]

        compact_package = {
            "client_fact_sheet": excerpt(source_fact_sheet(job), 1200),
            "primary_generation_prompt": str(primary_prompt or "")[:1800],
            "local_retrieval_context": str(retrieval_context or "")[:1400],
            "timing_context": excerpt(report_timing_context(job), 700),
            "report_contract": excerpt(prompt_contract, 1500),
            "required_sections": excerpt(contract.get("required_sections", []), 700),
            "writing_rules": excerpt(contract.get("writing_rules", []), 600),
            "embedded_media_observations": excerpt(job.get("_alice_media_observations", []), 300),
            "quality_gate": excerpt(prompt_package.get("quality_gate", {}), 250),
        }
        if retry_note:
            compact_package["retry_note"] = str(retry_note)[:600]
            compact_package["previous_draft_for_repair"] = str(job.get("_alice_previous_draft") or "")[:2400]
        encoded = json.dumps(compact_package, indent=2, ensure_ascii=True)
    if len(encoded) > total_limit:
        overflow = len(encoded) - total_limit
        retrieval = compact_package.get("local_retrieval_context", "")
        compact_package["local_retrieval_context"] = retrieval[: max(1000, len(retrieval) - overflow - 256)]
        if "previous_draft_for_repair" in compact_package:
            compact_package["previous_draft_for_repair"] = compact_package["previous_draft_for_repair"][:1200]
        encoded = json.dumps(compact_package, indent=2, ensure_ascii=True)
    return encoded


def truthy(value) -> bool:
    return str(value or "").strip().lower() in {"1", "true", "yes", "on", "y"}


def report_runtime(job: dict) -> dict:
    contract_runtime = job.get("report_contract", {}).get("runtime_rules", {}) or {}
    job_runtime = job.get("ai_runtime", {}) or {}
    return {**contract_runtime, **job_runtime}


def runtime_or_metadata_value(job: dict, *keys: str):
    runtime = report_runtime(job)
    metadata = job.get("metadata", {}) or {}
    for key in keys:
        if key in runtime and runtime.get(key) not in (None, ""):
            return runtime.get(key)
        if key in metadata and metadata.get(key) not in (None, ""):
            return metadata.get(key)
    return None


def report_preflight_scan_enabled(job: dict) -> bool:
    value = runtime_or_metadata_value(job, "preflight_visual_scan_enabled", "report_preflight_scan_enabled")
    if value is not None:
        return truthy(value)
    return truthy(env("DOPE_REPORT_PREFLIGHT_SCAN_ENABLED", env("DOPE_REPORT_VISION_ENABLED", "0")))


def report_preflight_vision_model(job: dict) -> str:
    return str(
        runtime_or_metadata_value(job, "preflight_vision_model", "report_preflight_vision_model")
        or env("DOPE_REPORT_VISION_MODEL")
        or "qwen3-vl:8b"
    ).strip()


def report_preflight_ocr_model(job: dict) -> str:

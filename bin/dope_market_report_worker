<w:style w:type="paragraph" w:styleId="Title"><w:name w:val="Title"/><w:basedOn w:val="Normal"/><w:pPr><w:spacing w:before="80" w:after="220"/></w:pPr><w:rPr><w:b/><w:color w:val="{INK}"/><w:sz w:val="40"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Subtitle"><w:name w:val="Subtitle"/><w:basedOn w:val="Normal"/><w:pPr><w:spacing w:before="40" w:after="160"/></w:pPr><w:rPr><w:color w:val="{MUTED}"/><w:sz w:val="23"/></w:rPr></w:style>

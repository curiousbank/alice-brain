</w:ftr>"""


def create_docx(job: dict, report: dict, logo: tuple[bytes, str] | None, path: Path) -> None:
    rels = """<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/>
</Relationships>"""
    document_rels = """<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
<Relationship Id="rIdHeader" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/header" Target="header1.xml"/>
<Relationship Id="rIdFooter" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/footer" Target="footer1.xml"/>
<Relationship Id="rIdNumbering" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/numbering" Target="numbering.xml"/>
{image_rel}
</Relationships>""".format(
        image_rel='<Relationship Id="rIdLogo" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/logo.{ext}"/>'.format(ext=logo[1]) if logo else ""
    )
    content_types = """<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>
<Default Extension="xml" ContentType="application/xml"/>
<Default Extension="png" ContentType="image/png"/>
<Default Extension="jpg" ContentType="image/jpeg"/>
<Default Extension="jpeg" ContentType="image/jpeg"/>
<Default Extension="gif" ContentType="image/gif"/>
<Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>
<Override PartName="/word/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml"/>
<Override PartName="/word/numbering.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.numbering+xml"/>
<Override PartName="/word/header1.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.header+xml"/>
<Override PartName="/word/footer1.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.footer+xml"/>
</Types>"""
    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as docx:
        docx.writestr("[Content_Types].xml", content_types)
        docx.writestr("_rels/.rels", rels)
        docx.writestr("word/document.xml", build_document_xml(job, report, logo))
        docx.writestr("word/styles.xml", styles_xml())
        docx.writestr("word/_rels/document.xml.rels", document_rels)
        if logo:
            docx.writestr(f"word/media/logo.{logo[1]}", logo[0])


def context_appendix_text(job: dict) -> str:
    hubspot = job.get("hubspot_context", {}) or {}
    media = job.get("assets", {}).get("uploaded_media", []) or []
    labeled = hubspot.get("labeled_properties", {}) or {}
    raw = hubspot.get("raw_properties", {}) or {}
    missing = hubspot.get("missing_core_fields", []) or []
    lines = [
        "## Source Data Appendix",
        "",
        "This appendix is included so the account manager can see the source facts used while preparing the report.",
        "",
        "### Missing Core Fields",
    ]
    lines.append(", ".join(str(item) for item in missing) if missing else "No core fields were flagged as missing by SUN.")
    lines.extend(["", "### Uploaded Media References"])
    if media:
        for item in media:
            lines.append(f"- {item.get('filename')} ({item.get('content_type')}, {item.get('role')}) endpoint: {item.get('endpoint')}")
    else:
        lines.append("- No uploaded media was included in the worker package.")
    lines.extend(["", "### HubSpot Labeled Properties"])
    for key, value in labeled.items():
        lines.append(f"- {key}: {value}")
    lines.extend(["", "### Raw HubSpot Properties"])
    for key, value in list(raw.items())[:120]:
        lines.append(f"- {key}: {value}")
    return "\n".join(lines).strip()


FORBIDDEN_VISIBLE_HEADINGS = {
    "90-day neighborhood marketing roadmap",
    "dope implementation notes",
    "am-facing actions",
    "am facing actions",
    "designer notes",
    "print production notes",
    "canva data postcard handoff",
    "source data appendix",
    "hubspot properties",
    "hubspot labeled properties",
    "raw hubspot properties",
    "asset list",
    "human approval gates",
}


def normalized_heading(value: str) -> str:
    text = re.sub(r"^[#>*_\-\s]+", "", value or "").strip()
    text = text.replace("’", "'").replace("`", "")
    text = re.sub(r"[:#*_]+$", "", text).strip().lower()
    return re.sub(r"\s+", " ", text)


def visible_heading(line: str) -> str | None:
    stripped = (line or "").strip()
    if not stripped:
        return None
    if stripped.startswith("#"):
        return normalized_heading(stripped)
    plain = normalized_heading(stripped)
    if plain in FORBIDDEN_VISIBLE_HEADINGS or plain == "let's get started":
        return plain
    return None


def client_visible_document_text(job: dict, report_text: str) -> str:
    kept = []
    after_get_started = False
    cleaned_source = sanitize_visible_report_text(report_text)
    for line in cleaned_source.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        heading = visible_heading(line)
        if heading in FORBIDDEN_VISIBLE_HEADINGS:
            break
        if after_get_started and heading:
            break
        kept.append(line)
        if heading == "let's get started":
            after_get_started = True
    cleaned = "\n".join(kept).strip()
    return cleaned or cleaned_source.strip()


def canva_app_path() -> str | None:
    for path in CANVA_APP_PATHS:
        if path.exists():
            return str(path)
    return None


def plain_text(markdown: str) -> str:
    text = re.sub(r"`([^`]*)`", r"\1", markdown or "")
    text = re.sub(r"!\[[^\]]*\]\([^)]+\)", "", text)
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    text = re.sub(r"[*_>#|]", " ", text)
    text = re.sub(r"^\s*[-+]\s+", "", text, flags=re.MULTILINE)
    return re.sub(r"\s+", " ", text).strip()


def report_teaser(report_text: str, max_chars: int = 360) -> str:
    for block in re.split(r"\n\s*\n", report_text or ""):
        cleaned = plain_text(block)
        if len(cleaned) > 90 and not cleaned.lower().startswith("source data appendix"):
            return clip(cleaned, max_chars)
    return clip(plain_text(report_text), max_chars)



import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from pathlib import Path


DEFAULT_BASE_URL = "http://127.0.0.1:8182"
DEFAULT_WORKER_ID = "alice-dope-reports-01"
DOCX_CONTENT_TYPE = "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
LOG_PATH = Path.home() / ".config" / "autos" / "log" / "dope_market_report_worker.jsonl"
CONTEXT_DIR = Path.home() / ".config" / "autos" / "context"
REPORT_DIR = Path.home() / ".config" / "autos" / "reports" / "dope"
REPORT_INDEX_PATH = REPORT_DIR / "index.jsonl"
EXAMPLES_DIR = REPORT_DIR / "examples"
STRATEGY_PROPOSAL_STYLE_PATH = EXAMPLES_DIR / "DOPE_STRATEGY_PROPOSAL_STYLE.md"
STRATEGY_PROPOSAL_CONTEXT_PATH = CONTEXT_DIR / "dope_strategy_proposal_style.md"
CANVA_APP_PATHS = [Path("/Applications/Canva.app"), Path.home() / "Applications" / "Canva.app"]
MAX_LOGO_BYTES = 5 * 1024 * 1024
DEFAULT_MINIMUM_WORDS = 500
DEFAULT_HARD_MINIMUM_WORDS = 250
DEFAULT_MINIMUM_DOCX_BYTES = 8_000
DEFAULT_EMBEDDER_MODEL = "qwen3-embedding:4b"
DEFAULT_EMBEDDING_TOP_K = 10

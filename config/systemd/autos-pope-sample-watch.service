[Unit]
Description=Bridge SUN WIZWIKI sample telemetry into local AUTOS Watch
After=network-online.target sun-dope-tunnel.service
Wants=network-online.target sun-dope-tunnel.service

[Service]
Type=simple
UMask=0077
ExecStartPre=/usr/bin/mkdir -p /home/wb/.config/autos/log
ExecStartPre=/usr/bin/touch /home/wb/.config/autos/log/pb_cc_activity.jsonl
ExecStart=/usr/bin/ssh -F /home/wb/.ssh/config -o BatchMode=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 sun-dev /usr/bin/tail -n 0 -F /home/wb/.config/autos/log/pope_sample_activity.jsonl
StandardOutput=append:/home/wb/.config/autos/log/pb_cc_activity.jsonl
StandardError=journal
Restart=always
RestartSec=3

[Install]
WantedBy=default.target

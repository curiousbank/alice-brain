[Unit]
Description=Alice Brain dedicated DOPE/DVE SMS worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/alice-brain
ExecStart=%h/Desktop/alice-brain/bin/start_dope_sms_worker
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=default.target
